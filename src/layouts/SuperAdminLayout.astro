---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from "@vercel/speed-insights/astro";

import '../styles/global.css';
import Breadcrumb from '../components/Breadcrumb.astro';

interface Props {
  title: string;
  currentTab: "analytics" | "tenants" | "users";
  breadcrumbs?: { name: string; href: string }[];
}

const { title, currentTab, breadcrumbs = [] } = Astro.props;

const primaryTabs = [
  { key: "analytics", label: "Analytics", href: "/super-admin" },
  { key: "tenants",   label: "Tenants",   href: "/super-admin/tenants" },
  { key: "users",     label: "Users",     href: "/super-admin/users" },
] as const;
---

<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — Platform Admin</title>
  <Analytics />

  <SpeedInsights />
</head>
<body class="h-full bg-gray-50">

  <!-- Top bar -->
  <div class="bg-white border-b border-gray-100 px-4 py-3 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <p class="text-base font-semibold text-gray-900">{title}</p>
      <span class="inline-flex items-center rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-700">
        Platform Admin
      </span>
    </div>
    <details class="relative">
      <summary class="flex items-center justify-center size-8 rounded-full bg-gray-100 text-gray-500 hover:bg-gray-200 transition-colors cursor-pointer list-none">
        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        </svg>
        <span class="sr-only">Open user menu</span>
      </summary>
      <div class="absolute right-0 z-50 mt-2 w-44 origin-top-right rounded-md bg-white py-1 shadow-lg ring-1 ring-black/5">
        <a href="/" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Back to home</a>
        <a href="/sign-out" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Sign out</a>
      </div>
    </details>
  </div>

  <Breadcrumb items={breadcrumbs} />

  <!-- Main content -->
  <main class="pb-24">
    <div class="px-4 py-4">
      <slot />
    </div>
  </main>

  <!-- Fixed bottom nav -->
  <nav
    class="fixed bottom-0 inset-x-0 bg-white border-t border-gray-200 z-50 flex"
    style="padding-bottom: env(safe-area-inset-bottom)"
  >
    {primaryTabs.map((tab) => {
      const isActive = tab.key === currentTab;
      return (
        <a
          href={tab.href}
          class={`flex flex-col items-center py-2 min-h-11 text-xs font-medium flex-1 ${isActive ? "text-indigo-600" : "text-gray-500 hover:text-gray-700"}`}
          aria-current={isActive ? "page" : undefined}
        >
          {tab.key === "analytics" && (
            <svg class="size-6 mb-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
            </svg>
          )}
          {tab.key === "tenants" && (
            <svg class="size-6 mb-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z" />
            </svg>
          )}
          {tab.key === "users" && (
            <svg class="size-6 mb-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
            </svg>
          )}
          {tab.label}
        </a>
      );
    })}
  </nav>

</body>
</html>
