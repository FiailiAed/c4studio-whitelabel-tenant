---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from "@vercel/speed-insights/astro";

import '@styles/global.css';
import Breadcrumb from '@components/Breadcrumb.astro';

interface Props {
  title: string;
  currentTab: "dashboard" | "staff" | "events" | "players" | "drills" | "documents" | "config";
  breadcrumbs?: { name: string; href: string }[];
}

const { title, currentTab, breadcrumbs = [] } = Astro.props;

const primaryTabs = [
  { key: "dashboard", label: "Dashboard", href: "/admin" },
  { key: "staff",     label: "Staff",     href: "/admin/staff" },
  { key: "events",    label: "Events",    href: "/admin/events" },
  { key: "players",   label: "Players",   href: "/admin/players" },
] as const;

const moreItems = [
  { key: "drills",    label: "Drills",    href: "/admin/drills" },
  { key: "documents", label: "Documents", href: "/admin/documents" },
  { key: "config",    label: "Config",    href: "/admin/config" },
] as const;

const moreIsActive = (["drills", "documents", "config"] as string[]).includes(currentTab);
---

<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — Admin</title>
  <Analytics />

  <SpeedInsights />
</head>
<body class="h-full bg-gray-50">

  <!-- Top bar -->
  <div class="bg-white border-b border-gray-100 px-4 py-3 flex items-center justify-between">
    <p class="text-base font-semibold text-gray-900">{title}</p>
    <details class="relative">
      <summary class="flex items-center justify-center size-8 rounded-full bg-gray-100 text-gray-500 hover:bg-gray-200 transition-colors cursor-pointer list-none">
        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        </svg>
        <span class="sr-only">Open user menu</span>
      </summary>
      <div class="absolute right-0 z-50 mt-2 w-44 origin-top-right rounded-md bg-white py-1 shadow-lg ring-1 ring-black/5">
        <a href="/" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Back to site</a>
        <a href="/sign-out" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Sign out</a>
      </div>
    </details>
  </div>

  <Breadcrumb items={breadcrumbs} />

  <!-- Main content -->
  <main class="pb-24">
    <div class="px-4 py-4">
      <slot />
    </div>
  </main>

  <!-- More drawer (hidden by default) -->
  <div
    id="more-drawer"
    class="hidden fixed bottom-16 inset-x-0 bg-white border-t border-gray-200 z-40 p-4 space-y-1"
    style="padding-bottom: env(safe-area-inset-bottom)"
  >
    {moreItems.map((item) => {
      const isActive = item.key === currentTab;
      return (
        <a
          href={item.href}
          class={`flex items-center gap-3 rounded-md px-3 py-2.5 text-sm font-medium transition-colors ${isActive ? "bg-indigo-50 text-indigo-700" : "text-gray-700 hover:bg-gray-50"}`}
        >
          {item.key === "drills" && (
            <svg class="size-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.966 8.966 0 0 0-6 2.292m0-14.25v14.25" />
            </svg>
          )}
          {item.key === "documents" && (
            <svg class="size-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
          )}
          {item.key === "config" && (
            <svg class="size-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            </svg>
          )}
          {item.label}
        </a>
      );
    })}
    <div class="my-2 border-t border-gray-100"></div>
    <a href="/" class="flex items-center gap-3 rounded-md px-3 py-2.5 text-sm font-medium text-gray-500 hover:bg-gray-50">
      <svg class="size-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
      </svg>
      Back to site
    </a>
    <a href="/sign-out" class="flex items-center gap-3 rounded-md px-3 py-2.5 text-sm font-medium text-gray-500 hover:bg-gray-50">
      <svg class="size-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15m-3 0-3-3m0 0 3-3m-3 3H15" />
      </svg>
      Sign out
    </a>
  </div>

  <!-- Fixed bottom nav -->
  <nav
    class="fixed bottom-0 inset-x-0 bg-white border-t border-gray-200 z-50 flex"
    style="padding-bottom: env(safe-area-inset-bottom)"
  >
    {primaryTabs.map((tab) => {
      const isActive = tab.key === currentTab;
      return (
        <a
          href={tab.href}
          class={`flex flex-col items-center py-2 min-h-11 text-xs font-medium flex-1 ${isActive ? "text-indigo-600" : "text-gray-500 hover:text-gray-700"}`}
          aria-current={isActive ? "page" : undefined}
        >
          {tab.key === "dashboard" && (
            <svg class="size-6 mb-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
            </svg>
          )}
          {tab.key === "staff" && (
            <svg class="size-6 mb-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
            </svg>
          )}
          {tab.key === "events" && (
            <svg class="size-6 mb-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm0 2.25h.008v.008H12v-.008ZM9.75 15h.008v.008H9.75V15Zm0 2.25h.008v.008H9.75v-.008ZM7.5 15h.008v.008H7.5V15Zm0 2.25h.008v.008H7.5v-.008Zm6.75-4.5h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V15Zm0 2.25h.008v.008h-.008v-.008Zm2.25-4.5h.008v.008H16.5v-.008Zm0 2.25h.008v.008H16.5V15Z" />
            </svg>
          )}
          {tab.key === "players" && (
            <svg class="size-6 mb-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
            </svg>
          )}
          {tab.label}
        </a>
      );
    })}

    <!-- More button -->
    <button
      type="button"
      id="more-btn"
      class={`flex flex-col items-center py-2 min-h-11 text-xs font-medium flex-1 ${moreIsActive ? "text-indigo-600" : "text-gray-500 hover:text-gray-700"}`}
      aria-expanded="false"
    >
      <svg class="size-6 mb-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM12.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM18.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
      </svg>
      More
    </button>
  </nav>

  <script is:inline>
    (function () {
      var btn = document.getElementById('more-btn');
      var drawer = document.getElementById('more-drawer');
      if (!btn || !drawer) return;

      btn.addEventListener('click', function () {
        var isOpen = !drawer.classList.contains('hidden');
        if (isOpen) {
          drawer.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
        } else {
          drawer.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
        }
      });

      document.addEventListener('click', function (e) {
        if (!drawer.classList.contains('hidden') && !drawer.contains(e.target) && e.target !== btn && !btn.contains(e.target)) {
          drawer.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    })();
  </script>

</body>
</html>
