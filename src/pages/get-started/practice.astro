---
import Layout from "@layouts/Layout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../convex/_generated/api";

type PracticePosition = "coach" | "defensive_trainer" | "offensive_trainer" | "goalie_trainer" | "helper" | "media";
type PracticeAgeGroup = "06U" | "08U" | "10U" | "12U" | "14U";
type PracticeDay = "monday" | "wednesday" | "friday";

const VALID_POSITIONS: PracticePosition[] = ["coach", "defensive_trainer", "offensive_trainer", "goalie_trainer", "helper", "media"];
const VALID_AGE_GROUPS: PracticeAgeGroup[] = ["06U", "08U", "10U", "12U", "14U"];
const VALID_DAYS: PracticeDay[] = ["monday", "wednesday", "friday"];

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/");

const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);

const [convexUser, existing] = await Promise.all([
  client.query(api.users.getUserByClerkId, { clerkId: userId }),
  client.query(api.onboarding.getOnboardingByClerkId, { clerkId: userId }),
]);

// Redirect if already submitted/done
if (convexUser?.onboardStatus === "submitted" || convexUser?.onboardStatus === "done") {
  return Astro.redirect("/");
}

// Must have completed Step 1
if (!existing || (existing.currentStep ?? 0) < 1) {
  return Astro.redirect("/get-started");
}

let formError: string | null = null;
if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  const practicePositions = (formData.getAll("practicePositions") as string[])
    .filter((p): p is PracticePosition => VALID_POSITIONS.includes(p as PracticePosition));
  const practiceAgeGroups = (formData.getAll("practiceAgeGroups") as string[])
    .filter((ag): ag is PracticeAgeGroup => VALID_AGE_GROUPS.includes(ag as PracticeAgeGroup));
  const practiceDays = (formData.getAll("practiceDays") as string[])
    .filter((d): d is PracticeDay => VALID_DAYS.includes(d as PracticeDay));

  if (!practicePositions.length) {
    formError = "Please select at least one practice role.";
  } else if (!practiceAgeGroups.length) {
    formError = "Please select at least one age group.";
  } else if (!practiceDays.length) {
    formError = "Please select at least one practice day.";
  } else {
    try {
      await client.mutation(api.onboarding.savePracticeAvailability, {
        clerkId: userId,
        practicePositions,
        practiceAgeGroups,
        practiceDays,
      });
      return Astro.redirect("/get-started/games");
    } catch (err) {
      formError = err instanceof Error ? err.message : "Something went wrong. Please try again.";
    }
  }
}

const PRACTICE_POSITIONS: { value: PracticePosition; label: string }[] = [
  { value: "coach",              label: "Coach" },
  { value: "defensive_trainer",  label: "Defensive Trainer" },
  { value: "offensive_trainer",  label: "Offensive Trainer" },
  { value: "goalie_trainer",     label: "Goalie Trainer" },
  { value: "helper",             label: "Helper / Assistant" },
  { value: "media",              label: "Media / Photography" },
];

const AGE_GROUPS: { value: PracticeAgeGroup; label: string }[] = [
  { value: "06U", label: "06U — Scoopers" },
  { value: "08U", label: "08U" },
  { value: "10U", label: "10U" },
  { value: "12U", label: "12U" },
  { value: "14U", label: "14U" },
];

const DAYS: { value: PracticeDay; label: string }[] = [
  { value: "monday",    label: "Monday" },
  { value: "wednesday", label: "Wednesday" },
  { value: "friday",    label: "Friday" },
];
---

<Layout title="Get Started — Step 2" breadcrumbs={[{ name: "Get Started", href: "/get-started" }, { name: "Practice", href: "/get-started/practice" }]}>
  <div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl">

      <!-- Progress indicator (4 steps) -->
      <nav class="flex items-center justify-center mb-8" aria-label="Progress">
        <ol class="flex items-center gap-2 sm:gap-4">
          <li class="flex items-center">
            <span class="flex size-8 items-center justify-center rounded-full bg-green-600 text-white text-sm font-semibold">
              <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" /></svg>
            </span>
            <span class="ml-2 text-sm font-medium text-green-600 hidden sm:inline">Background</span>
          </li>
          <svg class="size-4 text-gray-400 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
          <li class="flex items-center">
            <span class="flex size-8 items-center justify-center rounded-full bg-indigo-600 text-white text-sm font-semibold">2</span>
            <span class="ml-2 text-sm font-semibold text-indigo-600 hidden sm:inline">Practice</span>
          </li>
          <svg class="size-4 text-gray-400 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
          <li class="flex items-center">
            <span class="flex size-8 items-center justify-center rounded-full border-2 border-gray-300 text-gray-500 text-sm font-semibold">3</span>
            <span class="ml-2 text-sm font-medium text-gray-400 hidden sm:inline">Games</span>
          </li>
          <svg class="size-4 text-gray-400 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
          <li class="flex items-center">
            <span class="flex size-8 items-center justify-center rounded-full border-2 border-gray-300 text-gray-500 text-sm font-semibold">4</span>
            <span class="ml-2 text-sm font-medium text-gray-400 hidden sm:inline">Compliance</span>
          </li>
        </ol>
      </nav>

      <div class="bg-white shadow-sm rounded-xl px-6 py-8 sm:px-8">
        <div class="mb-6">
          <h1 class="text-2xl font-bold text-gray-900">Practice Availability</h1>
          <p class="mt-1 text-sm text-gray-500">Tell us your practice roles, age groups, and available weekdays.</p>
        </div>

        {formError && (
          <div class="mb-6 rounded-md bg-red-50 p-4">
            <p class="text-sm text-red-700">{formError}</p>
          </div>
        )}

        <form method="POST" class="space-y-8">

          <!-- Practice Roles -->
          <fieldset>
            <legend class="text-base font-semibold text-gray-900">
              Practice Role(s) <span class="text-red-500">*</span>
            </legend>
            <p class="mt-1 text-sm text-gray-500">What will you do during practices?</p>
            <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
              {PRACTICE_POSITIONS.map((pos) => (
                <label class="flex items-center gap-3 rounded-lg border border-gray-200 px-4 py-3 cursor-pointer hover:bg-gray-50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
                  <input
                    type="checkbox"
                    name="practicePositions"
                    value={pos.value}
                    checked={existing?.practicePositions?.includes(pos.value) ?? false}
                    class="size-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
                  />
                  <span class="text-sm font-medium text-gray-700">{pos.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Age Groups -->
          <fieldset>
            <legend class="text-base font-semibold text-gray-900">
              Practice Age Group(s) <span class="text-red-500">*</span>
            </legend>
            <p class="mt-1 text-sm text-gray-500">Which age groups can you work with at practices?</p>
            <div class="mt-4 flex flex-wrap gap-3">
              {AGE_GROUPS.map((ag) => (
                <label class="flex items-center gap-2 rounded-lg border border-gray-200 px-4 py-3 cursor-pointer hover:bg-gray-50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
                  <input
                    type="checkbox"
                    name="practiceAgeGroups"
                    value={ag.value}
                    checked={existing?.practiceAgeGroups?.includes(ag.value) ?? false}
                    class="size-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
                  />
                  <span class="text-sm font-medium text-gray-700">{ag.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Practice Days -->
          <fieldset>
            <legend class="text-base font-semibold text-gray-900">
              Practice Availability <span class="text-red-500">*</span>
            </legend>
            <p class="mt-1 text-sm text-gray-500">Which weekdays are you generally available for practice?</p>
            <div class="mt-4 flex flex-wrap gap-3">
              {DAYS.map((day) => (
                <label class="flex items-center gap-2 rounded-lg border border-gray-200 px-4 py-3 cursor-pointer hover:bg-gray-50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
                  <input
                    type="checkbox"
                    name="practiceDays"
                    value={day.value}
                    checked={existing?.practiceDays?.includes(day.value) ?? false}
                    class="size-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
                  />
                  <span class="text-sm font-medium text-gray-700">{day.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Actions -->
          <div class="flex items-center justify-between pt-2">
            <a href="/get-started" class="text-sm text-gray-500 hover:text-gray-700">&larr; Back to Background Info</a>
            <button
              type="submit"
              class="rounded-md bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
            >
              Continue to Game Availability &rarr;
            </button>
          </div>

        </form>
      </div>

    </div>
  </div>
</Layout>
