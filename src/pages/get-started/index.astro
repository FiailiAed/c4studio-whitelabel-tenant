---
import Layout from "@layouts/Layout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../convex/_generated/api";

type VolunteerType = "parent_volunteer" | "high_school_player" | "adult_volunteer";
type ExperienceLevel = "none" | "youth" | "high_school" | "college" | "pro";

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/");

const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);

// Redirect if already submitted or done
const convexUser = await client.query(api.users.getUserByClerkId, { clerkId: userId });
if (convexUser?.onboardStatus === "submitted" || convexUser?.onboardStatus === "done") {
  return Astro.redirect("/");
}

// Load existing onboarding record
const existing = await client.query(api.onboarding.getOnboardingByClerkId, { clerkId: userId });

// On GET: redirect returning users to their current step
if (Astro.request.method !== "POST" && existing?.currentStep) {
  if (existing.currentStep >= 3) return Astro.redirect("/get-started/compliance");
  if (existing.currentStep >= 2) return Astro.redirect("/get-started/games");
  if (existing.currentStep >= 1) return Astro.redirect("/get-started/practice");
}

// Handle POST: save Step 1
let formError: string | null = null;
if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  const volunteerType = formData.get("volunteerType") as VolunteerType | null;
  const yearsPlayedRaw = formData.get("yearsPlayed") as string | null;
  const highestLevel = formData.get("highestLevel") as ExperienceLevel | null;

  const VALID_TYPES: VolunteerType[] = ["parent_volunteer", "high_school_player", "adult_volunteer"];
  const VALID_LEVELS: ExperienceLevel[] = ["none", "youth", "high_school", "college", "pro"];

  if (!volunteerType || !VALID_TYPES.includes(volunteerType)) {
    formError = "Please select your volunteer type.";
  } else if (!highestLevel || !VALID_LEVELS.includes(highestLevel)) {
    formError = "Please select your highest playing level.";
  } else {
    const yearsPlayed = Math.max(0, parseInt(yearsPlayedRaw ?? "0", 10) || 0);

    // Parse coaching experience parallel arrays
    const coachSports = formData.getAll("coachSport") as string[];
    const coachYears = formData.getAll("coachYears") as string[];
    const coachingExperience = coachSports
      .map((sport, i) => ({
        sport: sport.trim(),
        years: Math.max(0, parseInt(coachYears[i] ?? "0", 10) || 0),
      }))
      .filter((e) => e.sport.length > 0);

    try {
      await client.mutation(api.onboarding.saveBackgroundInfo, {
        clerkId: userId,
        volunteerType,
        playingExperience: { yearsPlayed, highestLevel },
        coachingExperience,
      });
      return Astro.redirect("/get-started/practice");
    } catch (err) {
      formError = err instanceof Error ? err.message : "Something went wrong. Please try again.";
    }
  }
}

const VOLUNTEER_TYPES: { value: VolunteerType; label: string; description: string }[] = [
  { value: "parent_volunteer",  label: "Parent Volunteer",   description: "Parent of a player helping out" },
  { value: "high_school_player", label: "High School Player", description: "Current high school student (age 14–18)" },
  { value: "adult_volunteer",   label: "Adult Volunteer",    description: "Non-parent adult coach or trainer" },
];

const EXPERIENCE_LEVELS: { value: ExperienceLevel; label: string }[] = [
  { value: "none",        label: "None (never played)" },
  { value: "youth",       label: "Youth (recreational or travel)" },
  { value: "high_school", label: "High School" },
  { value: "college",     label: "College" },
  { value: "pro",         label: "Professional" },
];
---

<Layout title="Get Started — Step 1" breadcrumbs={[{ name: "Get Started", href: "/get-started" }]}>
  <div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl">

      <!-- Progress indicator (4 steps) -->
      <nav class="flex items-center justify-center mb-8" aria-label="Progress">
        <ol class="flex items-center gap-2 sm:gap-4">
          <li class="flex items-center">
            <span class="flex size-8 items-center justify-center rounded-full bg-indigo-600 text-white text-sm font-semibold">1</span>
            <span class="ml-2 text-sm font-semibold text-indigo-600 hidden sm:inline">Background</span>
          </li>
          <svg class="size-4 text-gray-400 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
          <li class="flex items-center">
            <span class="flex size-8 items-center justify-center rounded-full border-2 border-gray-300 text-gray-500 text-sm font-semibold">2</span>
            <span class="ml-2 text-sm font-medium text-gray-400 hidden sm:inline">Practice</span>
          </li>
          <svg class="size-4 text-gray-400 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
          <li class="flex items-center">
            <span class="flex size-8 items-center justify-center rounded-full border-2 border-gray-300 text-gray-500 text-sm font-semibold">3</span>
            <span class="ml-2 text-sm font-medium text-gray-400 hidden sm:inline">Games</span>
          </li>
          <svg class="size-4 text-gray-400 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
          <li class="flex items-center">
            <span class="flex size-8 items-center justify-center rounded-full border-2 border-gray-300 text-gray-500 text-sm font-semibold">4</span>
            <span class="ml-2 text-sm font-medium text-gray-400 hidden sm:inline">Compliance</span>
          </li>
        </ol>
      </nav>

      <div class="bg-white shadow-sm rounded-xl px-6 py-8 sm:px-8">
        <div class="mb-6">
          <h1 class="text-2xl font-bold text-gray-900">Background Info</h1>
          <p class="mt-1 text-sm text-gray-500">Tell us about yourself so we can match you to the right role.</p>
        </div>

        {formError && (
          <div class="mb-6 rounded-md bg-red-50 p-4">
            <p class="text-sm text-red-700">{formError}</p>
          </div>
        )}

        <form method="POST" class="space-y-8">

          <!-- Volunteer Type -->
          <fieldset>
            <legend class="text-base font-semibold text-gray-900">
              I am a… <span class="text-red-500">*</span>
            </legend>
            <div class="mt-4 space-y-3">
              {VOLUNTEER_TYPES.map((vt) => (
                <label class="flex items-start gap-3 rounded-lg border border-gray-200 px-4 py-3 cursor-pointer hover:bg-gray-50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
                  <input
                    type="radio"
                    name="volunteerType"
                    value={vt.value}
                    checked={existing?.volunteerType === vt.value}
                    required
                    class="mt-0.5 size-4 border-gray-300 text-indigo-600 focus:ring-indigo-600"
                  />
                  <div>
                    <span class="text-sm font-medium text-gray-900">{vt.label}</span>
                    <p class="text-xs text-gray-500">{vt.description}</p>
                  </div>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Playing Experience -->
          <fieldset>
            <legend class="text-base font-semibold text-gray-900">Playing Experience</legend>
            <p class="mt-1 text-sm text-gray-500">Your personal lacrosse playing background.</p>
            <div class="mt-4 space-y-4">
              <div>
                <label for="yearsPlayed" class="block text-sm font-medium text-gray-700">
                  Years played lacrosse
                </label>
                <input
                  type="number"
                  id="yearsPlayed"
                  name="yearsPlayed"
                  min="0"
                  max="30"
                  value={existing?.playingExperience?.yearsPlayed ?? 0}
                  class="mt-1 block w-32 rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
                />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                  Highest level played <span class="text-red-500">*</span>
                </label>
                <div class="space-y-2">
                  {EXPERIENCE_LEVELS.map((level) => (
                    <label class="flex items-center gap-3 cursor-pointer">
                      <input
                        type="radio"
                        name="highestLevel"
                        value={level.value}
                        checked={existing?.playingExperience?.highestLevel
                          ? existing.playingExperience.highestLevel === level.value
                          : level.value === "none"}
                        required
                        class="size-4 border-gray-300 text-indigo-600 focus:ring-indigo-600"
                      />
                      <span class="text-sm text-gray-700">{level.label}</span>
                    </label>
                  ))}
                </div>
              </div>
            </div>
          </fieldset>

          <!-- Coaching Experience -->
          <fieldset>
            <legend class="text-base font-semibold text-gray-900">Coaching Experience</legend>
            <p class="mt-1 text-sm text-gray-500">List any sports you've coached. Leave empty if none.</p>
            <div id="coachingRows" class="mt-4 space-y-3">
              {(existing?.coachingExperience && existing.coachingExperience.length > 0)
                ? existing.coachingExperience.map((entry) => (
                  <div class="coaching-row flex items-center gap-3">
                    <input
                      type="text"
                      name="coachSport"
                      placeholder="Sport (e.g. Lacrosse)"
                      value={entry.sport}
                      class="flex-1 rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
                    />
                    <input
                      type="number"
                      name="coachYears"
                      placeholder="Yrs"
                      min="0"
                      max="50"
                      value={entry.years}
                      class="w-20 rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
                    />
                    <button type="button" class="remove-row-btn text-sm text-red-500 hover:text-red-700 shrink-0">Remove</button>
                  </div>
                ))
                : (
                  <div class="coaching-row flex items-center gap-3">
                    <input
                      type="text"
                      name="coachSport"
                      placeholder="Sport (e.g. Lacrosse)"
                      class="flex-1 rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
                    />
                    <input
                      type="number"
                      name="coachYears"
                      placeholder="Yrs"
                      min="0"
                      max="50"
                      class="w-20 rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
                    />
                    <button type="button" class="remove-row-btn text-sm text-red-500 hover:text-red-700 shrink-0">Remove</button>
                  </div>
                )
              }
            </div>
            <button
              type="button"
              id="addCoachingRow"
              class="mt-3 inline-flex items-center gap-1.5 text-sm text-indigo-600 hover:text-indigo-800 font-medium"
            >
              <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
              </svg>
              Add sport
            </button>
          </fieldset>

          <!-- Submit -->
          <div class="flex justify-end pt-2">
            <button
              type="submit"
              class="rounded-md bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
            >
              Continue to Practice Availability &rarr;
            </button>
          </div>

        </form>
      </div>

    </div>
  </div>
</Layout>

<script is:inline>
  const coachingRows = document.getElementById('coachingRows');
  const addBtn = document.getElementById('addCoachingRow');

  function attachRemoveListeners() {
    coachingRows.querySelectorAll('.remove-row-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const row = btn.closest('.coaching-row');
        if (coachingRows.children.length > 1) {
          row.remove();
        } else {
          // Clear inputs instead of removing last row
          row.querySelectorAll('input').forEach((input) => { input.value = ''; });
        }
      });
    });
  }

  addBtn.addEventListener('click', () => {
    const row = document.createElement('div');
    row.className = 'coaching-row flex items-center gap-3';
    row.innerHTML = `
      <input type="text" name="coachSport" placeholder="Sport (e.g. Lacrosse)"
        class="flex-1 rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" />
      <input type="number" name="coachYears" placeholder="Yrs" min="0" max="50"
        class="w-20 rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" />
      <button type="button" class="remove-row-btn text-sm text-red-500 hover:text-red-700 shrink-0">Remove</button>
    `;
    coachingRows.appendChild(row);
    attachRemoveListeners();
    row.querySelector('input').focus();
  });

  attachRemoveListeners();
</script>
