---
import Layout from "@layouts/Layout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../convex/_generated/api";

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/");

const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);
const convexUser = await client.query(api.users.getUserByClerkId, { clerkId: userId });

// Already approved — no need for this page
if (convexUser?.onboardStatus === "done") {
  return Astro.redirect("/coach");
}

const RESOURCES = [
  {
    label: "BAS Website",
    href: "https://gtlax.org",
    description: "Team news, schedules, and info",
  },
  {
    label: "JFE Drive",
    href: "https://drive.google.com/drive/folders/1D1-FAA06sLT0RkywGUO-0Uq_W2hAJEsM?usp=sharing",
    description: "JFE coaching resources and materials",
  },
  {
    label: "USA Lacrosse Resources",
    href: "https://drive.google.com/drive/folders/1edoz9hRQep0RVXibXtj3InNJtOG8Va8A?usp=sharing",
    description: "Certification guides and rulebooks",
  },
] as const;
---

<Layout title="Application Submitted" breadcrumbs={[{ name: "Get Started", href: "/get-started" }, { name: "Complete", href: "/get-started/success" }]}>
  <div class="min-h-screen bg-gray-50 flex flex-col items-center justify-center py-16 px-4">
    <div class="w-full max-w-md">

      <!-- Success icon + heading -->
      <div class="text-center mb-8">
        <div class="mx-auto flex size-16 items-center justify-center rounded-full bg-green-100 mb-4">
          <svg class="size-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">Application Submitted!</h1>
        <p class="mt-2 text-sm text-gray-500 max-w-sm mx-auto">
          Your application is under review. While you wait, you can explore the coach portal in read-only mode and check out these resources.
        </p>
      </div>

      <!-- Resources card -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 mb-6">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-4">Resources</p>
        <div class="space-y-3">
          {RESOURCES.map(({ label, href, description }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 rounded-lg border border-gray-100 bg-gray-50 px-4 py-3 hover:bg-gray-100 transition-colors group"
            >
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-gray-900 group-hover:text-green-700">{label}</p>
                <p class="text-xs text-gray-400 truncate">{description}</p>
              </div>
              <svg class="size-4 text-gray-400 group-hover:text-green-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <a
        href="/coach"
        class="block w-full text-center bg-green-600 text-white font-semibold rounded-xl py-3 text-sm hover:bg-green-700 transition-colors"
      >
        Explore the Coach Portal &rarr;
      </a>

    </div>
  </div>
</Layout>
