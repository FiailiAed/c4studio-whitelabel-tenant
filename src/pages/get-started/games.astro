---
import Layout from "@layouts/Layout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../convex/_generated/api";

type GamePosition = "head_coach" | "assistant_coach" | "goalie_coach" | "parent_coach" | "scorekeeper" | "media_team" | "game_day_helper";
type GameAgeGroup = "08U" | "10U" | "12U" | "14U";
type GameTimeSlot = "9am" | "10am" | "11am" | "12pm" | "1pm" | "2pm";

const ALL_GAME_POSITIONS: GamePosition[] = ["head_coach", "assistant_coach", "goalie_coach", "parent_coach", "scorekeeper", "media_team", "game_day_helper"];
const VALID_GAME_AGE_GROUPS: GameAgeGroup[] = ["08U", "10U", "12U", "14U"];
const VALID_TIME_SLOTS: GameTimeSlot[] = ["9am", "10am", "11am", "12pm", "1pm", "2pm"];

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/");

const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);

const [convexUser, existing, seasonConfig] = await Promise.all([
  client.query(api.users.getUserByClerkId, { clerkId: userId }),
  client.query(api.onboarding.getOnboardingByClerkId, { clerkId: userId }),
  client.query(api.onboarding.getSeasonConfig, {}),
]);

// Redirect if already submitted/done
if (convexUser?.onboardStatus === "submitted" || convexUser?.onboardStatus === "done") {
  return Astro.redirect("/");
}

// Must have completed Step 2
if (!existing || (existing.currentStep ?? 0) < 2) {
  return Astro.redirect("/get-started/practice");
}

const isHighSchoolPlayer = existing.volunteerType === "high_school_player";
const activeGameAgeGroups = seasonConfig?.activeGameAgeGroups ?? ["10U", "12U"];

let formError: string | null = null;
if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  const gamePositions = (formData.getAll("gamePositions") as string[])
    .filter((p): p is GamePosition => ALL_GAME_POSITIONS.includes(p as GamePosition));
  const gameAgeGroups = (formData.getAll("gameAgeGroups") as string[])
    .filter((ag): ag is GameAgeGroup => VALID_GAME_AGE_GROUPS.includes(ag as GameAgeGroup));
  const gameAvailability = (formData.getAll("gameAvailability") as string[])
    .filter((t): t is GameTimeSlot => VALID_TIME_SLOTS.includes(t as GameTimeSlot));

  if (!gamePositions.length) {
    formError = "Please select at least one game-day role.";
  } else if (isHighSchoolPlayer && gamePositions.includes("head_coach")) {
    formError = "High School Players are not eligible to serve as Head Coach.";
  } else {
    try {
      await client.mutation(api.onboarding.saveGameAvailability, {
        clerkId: userId,
        gamePositions,
        gameAgeGroups,
        gameAvailability,
      });
      return Astro.redirect("/get-started/compliance");
    } catch (err) {
      formError = err instanceof Error ? err.message : "Something went wrong. Please try again.";
    }
  }
}

type GamePositionOption = { value: GamePosition; label: string; hsEligible: boolean };
const GAME_POSITIONS: GamePositionOption[] = [
  { value: "head_coach",       label: "Head Coach",        hsEligible: false },
  { value: "assistant_coach",  label: "Assistant Coach",   hsEligible: true },
  { value: "goalie_coach",     label: "Goalie Coach",      hsEligible: true },
  { value: "parent_coach",     label: "Parent Coach",      hsEligible: true },
  { value: "scorekeeper",      label: "Scorekeeper",       hsEligible: true },
  { value: "media_team",       label: "Media Team",        hsEligible: true },
  { value: "game_day_helper",  label: "Game Day Helper",   hsEligible: true },
];

const availablePositions = isHighSchoolPlayer
  ? GAME_POSITIONS.filter((p) => p.hsEligible)
  : GAME_POSITIONS;

const GAME_AGE_GROUP_LABELS: Record<GameAgeGroup, string> = {
  "08U": "08U",
  "10U": "10U",
  "12U": "12U",
  "14U": "14U",
};

const TIME_SLOTS: { value: GameTimeSlot; label: string }[] = [
  { value: "9am",  label: "9:00 AM" },
  { value: "10am", label: "10:00 AM" },
  { value: "11am", label: "11:00 AM" },
  { value: "12pm", label: "12:00 PM (Noon)" },
  { value: "1pm",  label: "1:00 PM" },
  { value: "2pm",  label: "2:00 PM" },
];
---

<Layout title="Get Started — Step 3" breadcrumbs={[{ name: "Get Started", href: "/get-started" }, { name: "Games", href: "/get-started/games" }]}>
  <div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl">

      <!-- Progress indicator (4 steps) -->
      <nav class="flex items-center justify-center mb-8" aria-label="Progress">
        <ol class="flex items-center gap-2 sm:gap-4">
          <li class="flex items-center">
            <span class="flex size-8 items-center justify-center rounded-full bg-green-600 text-white text-sm font-semibold">
              <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" /></svg>
            </span>
            <span class="ml-2 text-sm font-medium text-green-600 hidden sm:inline">Background</span>
          </li>
          <svg class="size-4 text-gray-400 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
          <li class="flex items-center">
            <span class="flex size-8 items-center justify-center rounded-full bg-green-600 text-white text-sm font-semibold">
              <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" /></svg>
            </span>
            <span class="ml-2 text-sm font-medium text-green-600 hidden sm:inline">Practice</span>
          </li>
          <svg class="size-4 text-gray-400 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
          <li class="flex items-center">
            <span class="flex size-8 items-center justify-center rounded-full bg-indigo-600 text-white text-sm font-semibold">3</span>
            <span class="ml-2 text-sm font-semibold text-indigo-600 hidden sm:inline">Games</span>
          </li>
          <svg class="size-4 text-gray-400 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
          <li class="flex items-center">
            <span class="flex size-8 items-center justify-center rounded-full border-2 border-gray-300 text-gray-500 text-sm font-semibold">4</span>
            <span class="ml-2 text-sm font-medium text-gray-400 hidden sm:inline">Compliance</span>
          </li>
        </ol>
      </nav>

      <div class="bg-white shadow-sm rounded-xl px-6 py-8 sm:px-8">
        <div class="mb-6">
          <h1 class="text-2xl font-bold text-gray-900">Game Availability</h1>
          <p class="mt-1 text-sm text-gray-500">Tell us your game-day roles, age groups, and Saturday time slots.</p>
        </div>

        {isHighSchoolPlayer && (
          <div class="mb-6 rounded-md bg-amber-50 border border-amber-200 p-4">
            <p class="text-sm text-amber-800">
              <strong>Note:</strong> As a High School Player, the Head Coach role is not available to you.
            </p>
          </div>
        )}

        {formError && (
          <div class="mb-6 rounded-md bg-red-50 p-4">
            <p class="text-sm text-red-700">{formError}</p>
          </div>
        )}

        <form method="POST" class="space-y-8">

          <!-- Game Roles -->
          <fieldset>
            <legend class="text-base font-semibold text-gray-900">
              Game-Day Role(s) <span class="text-red-500">*</span>
            </legend>
            <p class="mt-1 text-sm text-gray-500">What will you do on game days?</p>
            <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
              {availablePositions.map((pos) => (
                <label class="flex items-center gap-3 rounded-lg border border-gray-200 px-4 py-3 cursor-pointer hover:bg-gray-50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
                  <input
                    type="checkbox"
                    name="gamePositions"
                    value={pos.value}
                    checked={existing?.gamePositions?.includes(pos.value) ?? false}
                    class="size-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
                  />
                  <span class="text-sm font-medium text-gray-700">{pos.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Game Age Groups (from season config) -->
          {activeGameAgeGroups.length > 0 && (
            <fieldset>
              <legend class="text-base font-semibold text-gray-900">Game Age Group(s)</legend>
              <p class="mt-1 text-sm text-gray-500">
                Which active age groups can you support on game days?
                <span class="text-gray-400">(Only age groups playing games this season are shown.)</span>
              </p>
              <div class="mt-4 flex flex-wrap gap-3">
                {activeGameAgeGroups.map((ag) => (
                  <label class="flex items-center gap-2 rounded-lg border border-gray-200 px-4 py-3 cursor-pointer hover:bg-gray-50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
                    <input
                      type="checkbox"
                      name="gameAgeGroups"
                      value={ag}
                      checked={existing?.gameAgeGroups?.includes(ag as GameAgeGroup) ?? false}
                      class="size-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
                    />
                    <span class="text-sm font-medium text-gray-700">{GAME_AGE_GROUP_LABELS[ag as GameAgeGroup]}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          )}

          <!-- Saturday Time Slots -->
          <fieldset>
            <legend class="text-base font-semibold text-gray-900">Saturday Availability</legend>
            <p class="mt-1 text-sm text-gray-500">Which Saturday time slots are you generally available for games?</p>
            <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
              {TIME_SLOTS.map((slot) => (
                <label class="flex items-center gap-2 rounded-lg border border-gray-200 px-4 py-3 cursor-pointer hover:bg-gray-50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
                  <input
                    type="checkbox"
                    name="gameAvailability"
                    value={slot.value}
                    checked={existing?.gameAvailability?.includes(slot.value) ?? false}
                    class="size-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
                  />
                  <span class="text-sm font-medium text-gray-700">{slot.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Actions -->
          <div class="flex items-center justify-between pt-2">
            <a href="/get-started/practice" class="text-sm text-gray-500 hover:text-gray-700">&larr; Back to Practice Availability</a>
            <button
              type="submit"
              class="rounded-md bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
            >
              Continue to Compliance &rarr;
            </button>
          </div>

        </form>
      </div>

    </div>
  </div>
</Layout>
