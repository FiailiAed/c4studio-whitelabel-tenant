---
import CoachLayout from "@layouts/CoachLayout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../convex/_generated/api";
import type { Id } from "../../../convex/_generated/dataModel";

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/");

const isReadOnly = Astro.locals.coachIsReadOnly ?? false;

const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);

// Handle RSVP POST
if (Astro.request.method === "POST") {
  if (isReadOnly) return Astro.redirect("/coach");
  const form = await Astro.request.formData();
  const eventId = form.get("eventId") as Id<"events"> | null;
  const status = form.get("status") as "confirmed" | "declined" | "maybe" | null;
  if (eventId && status && ["confirmed", "declined", "maybe"].includes(status)) {
    await client.mutation(api.eventRsvp.upsertRsvp, { eventId, clerkId: userId, status });
  }
  return Astro.redirect("/coach");
}

// Load upcoming published events
const allEvents = await client.query(api.events.listEvents, {});
const now = Date.now();
const upcoming = allEvents
  .filter((e) => e.published === true && e.date > now)
  .sort((a, b) => a.date - b.date);

const nextEvent = upcoming[0] ?? null;

let myAssignments: Awaited<ReturnType<typeof client.query<typeof api.assignments.getAssignmentsForEvent>>> = [];
let hasPlan = false;
let myRsvp: Awaited<ReturnType<typeof client.query<typeof api.eventRsvp.getMyRsvp>>> = null;

if (nextEvent) {
  const [assignments, planData, rsvp] = await Promise.all([
    client.query(api.assignments.getAssignmentsForEvent, { eventId: nextEvent._id }),
    client.query(api.plans.getPlanForEvent, { eventId: nextEvent._id }),
    client.query(api.eventRsvp.getMyRsvp, { eventId: nextEvent._id, clerkId: userId }),
  ]);
  myAssignments = assignments.filter((a) => a.clerkId === userId);
  hasPlan = planData !== null;
  myRsvp = rsvp;
}

function formatEventDate(ts: number): string {
  return new Date(ts).toLocaleDateString("en-US", {
    weekday: "long", month: "long", day: "numeric",
  });
}

function formatEventTime(ts: number): string {
  return new Date(ts).toLocaleTimeString("en-US", {
    hour: "numeric", minute: "2-digit",
  });
}

const STATION_LABELS: Record<string, string> = {
  stretch: "Stretch",
  warmup: "Warmup",
  offense: "Offense",
  ground_balls: "Ground Balls",
  defense: "Defense",
  "3v3_combat": "3v3 Combat",
  team_specific: "Team Specific",
  u6_practice: "U6 Practice",
};

const RSVP_OPTIONS = [
  { value: "confirmed", label: "Going" },
  { value: "maybe",     label: "Maybe" },
  { value: "declined",  label: "Can't Go" },
] as const;
---

<CoachLayout title="Next Practice" currentTab="home" breadcrumbs={[{ name: "Coach Portal", href: "/coach" }]}>
  <div class="px-4 py-6 space-y-4">

    {!nextEvent ? (
      <div class="text-center py-16">
        <p class="text-gray-500 text-sm">No upcoming practices scheduled.</p>
      </div>
    ) : (
      <>
        <!-- Event card -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
          <p class="text-xs font-medium text-green-600 uppercase tracking-wide mb-1">Next Practice</p>
          <p class="text-lg font-bold text-gray-900">{formatEventDate(nextEvent.date)}</p>
          <p class="text-sm text-gray-600 mt-0.5">{formatEventTime(nextEvent.date)}</p>
          {nextEvent.location && (
            <p class="text-sm text-gray-500 mt-0.5">{nextEvent.location}</p>
          )}
          {nextEvent.durationMinutes && (
            <p class="text-sm text-gray-500">{nextEvent.durationMinutes} min</p>
          )}
        </div>

        <!-- Assignment card -->
        {myAssignments.length > 0 ? (
          <div class="bg-green-50 rounded-xl border border-green-200 p-4">
            <p class="text-xs font-medium text-green-700 uppercase tracking-wide mb-2">Your Stations</p>
            <div class="space-y-1">
              {myAssignments.map((a) => (
                <div class="flex items-center gap-1.5">
                  <span class="inline-block size-2 rounded-full bg-green-500 shrink-0"></span>
                  <span class="text-sm font-semibold text-green-900">
                    {STATION_LABELS[a.station] ?? a.station}
                    {a.ageGroup ? ` / ${a.ageGroup}` : " / All age groups"}
                  </span>
                </div>
              ))}
            </div>
          </div>
        ) : (
          <div class="bg-gray-50 rounded-xl border border-gray-200 p-4">
            <p class="text-sm text-gray-500">No station assigned yet.</p>
          </div>
        )}

        <!-- Practice plan CTA -->
        {hasPlan ? (
          <a
            href={`/coach/practice/${nextEvent._id}`}
            class="block w-full text-center bg-green-600 text-white font-semibold rounded-xl py-3 text-sm hover:bg-green-700"
          >
            View Practice Plan &rarr;
          </a>
        ) : (
          <p class="text-center text-sm text-gray-400 py-2">Practice plan not yet available.</p>
        )}

        <!-- RSVP -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
          <p class="text-sm font-medium text-gray-700 mb-3">Are you coming?</p>
          {isReadOnly ? (
            <p class="text-sm text-amber-700 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2">
              RSVP available after your application is approved.
            </p>
          ) : (
            <div class="flex gap-2">
              {RSVP_OPTIONS.map((opt) => (
                <form method="POST" class="flex-1">
                  <input type="hidden" name="eventId" value={nextEvent._id} />
                  <input type="hidden" name="status" value={opt.value} />
                  <button
                    type="submit"
                    class={`w-full py-2 rounded-lg text-sm font-medium border transition-colors ${
                      myRsvp?.status === opt.value
                        ? "bg-green-600 text-white border-green-600"
                        : "bg-white text-gray-700 border-gray-200 hover:bg-gray-50 hover:cursor-pointer"
                    }`}
                  >
                    {opt.label}
                  </button>
                </form>
              ))}
            </div>
          )}
        </div>
      </>
    )}

    <!-- Resources card (always visible) -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Resources</p>
      <div class="space-y-2">
        {[
          { label: "BAS Website", href: "https://gtlax.org" },
          { label: "JFE Drive", href: "https://drive.google.com/drive/folders/1D1-FAA06sLT0RkywGUO-0Uq_W2hAJEsM?usp=sharing" },
          { label: "USA Lacrosse Resources", href: "https://drive.google.com/drive/folders/1edoz9hRQep0RVXibXtj3InNJtOG8Va8A?usp=sharing" },
        ].map(({ label, href }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between rounded-lg bg-gray-50 px-3 py-2.5 hover:bg-gray-100 transition-colors group"
          >
            <span class="text-sm font-medium text-gray-800 group-hover:text-green-700">{label}</span>
            <svg class="size-4 text-gray-400 group-hover:text-green-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
          </a>
        ))}
      </div>
    </div>

  </div>
</CoachLayout>
