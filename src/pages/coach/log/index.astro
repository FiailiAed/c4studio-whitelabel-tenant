---
import CoachLayout from "@layouts/CoachLayout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../../convex/_generated/api";
import type { Id } from "../../../../convex/_generated/dataModel";

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/");

const isReadOnly = Astro.locals.coachIsReadOnly ?? false;

const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);

// Valid station / age-group values for server-side validation
const VALID_STATIONS = [
  "stretch", "warmup", "offense", "ground_balls",
  "defense", "3v3_combat", "team_specific", "u6_practice",
] as const;
type ValidStation = typeof VALID_STATIONS[number];

const VALID_AGE_GROUPS = ["U6", "U8", "U12", "U14"] as const;
type ValidAgeGroup = typeof VALID_AGE_GROUPS[number];

// Handle POST: quick-log submission
if (Astro.request.method === "POST") {
  if (isReadOnly) return Astro.redirect("/coach/log");
  const form = await Astro.request.formData();
  const eventIdRaw = form.get("eventId") as string | null;
  const drillIdRaw = form.get("drillId") as string | null;
  const stationRaw = form.get("station") as string | null;
  const ageGroupRaw = form.get("ageGroup") as string | null;
  const repsRaw = form.get("reps") as string | null;
  const notes = form.get("notes") as string | null;

  const reps = parseInt(repsRaw ?? "0", 10);
  const isValidStation = stationRaw && VALID_STATIONS.includes(stationRaw as ValidStation);
  const ageGroup = ageGroupRaw && VALID_AGE_GROUPS.includes(ageGroupRaw as ValidAgeGroup)
    ? (ageGroupRaw as ValidAgeGroup)
    : undefined;

  if (eventIdRaw && drillIdRaw && isValidStation && reps > 0) {
    await client.mutation(api.repsLog.upsertStationLog, {
      eventId: eventIdRaw as Id<"events">,
      clerkId: userId,
      drillId: drillIdRaw as Id<"drills">,
      station: stationRaw as ValidStation,
      ageGroup,
      totalRepsCompleted: reps,
      notes: notes || undefined,
    });
  }

  return Astro.redirect("/coach/log");
}

// Load data in parallel
const [allEvents, allDrills, myLogs, myAssignments, topPlayers] = await Promise.all([
  client.query(api.events.listEvents, {}),
  client.query(api.drills.listDrills, {}),
  client.query(api.repsLog.getMyLogsEnriched, { clerkId: userId }),
  client.query(api.assignments.getMyAssignments, { clerkId: userId }),
  client.query(api.repsLog.getTopPlayersByReps, {}),
]);

// Season stats: March 1 – June 1 of current year
const currentYear = new Date().getFullYear();
const seasonStart = new Date(currentYear, 2, 1).getTime();  // March 1
const seasonEnd = new Date(currentYear, 5, 1).getTime();    // June 1

const seasonLogs = myLogs.filter((l) => l.loggedAt >= seasonStart && l.loggedAt <= seasonEnd);
const totalSeasonReps = seasonLogs.reduce((sum, l) => sum + l.totalRepsCompleted, 0);

// Last session (most recent event with logs)
const lastLog = myLogs[0] ?? null;
let lastSessionTitle = "";
let lastSessionDate = 0;
let lastSessionDrills = 0;
let lastSessionReps = 0;
if (lastLog) {
  lastSessionTitle = lastLog.eventTitle;
  lastSessionDate = lastLog.eventDate;
  const sameLogs = myLogs.filter((l) => l.eventId === lastLog.eventId);
  lastSessionDrills = sameLogs.length;
  lastSessionReps = sameLogs.reduce((sum, l) => sum + l.totalRepsCompleted, 0);
}

// Per-drill breakdown (all time, most recent log used for quality badge)
type DrillEntry = { name: string; totalReps: number; lastReps: number; lastTarget: number | null };
const drillStats = new Map<string, DrillEntry>();
for (const log of myLogs) {
  const key = log.drillId;
  if (!drillStats.has(key)) {
    drillStats.set(key, {
      name: log.drillName,
      totalReps: 0,
      lastReps: log.totalRepsCompleted,
      lastTarget: log.targetReps,
    });
  }
  const entry = drillStats.get(key)!;
  entry.totalReps += log.totalRepsCompleted;
}
const drillBreakdown = [...drillStats.values()].sort((a, b) => b.totalReps - a.totalReps);

// Reps Quality medal thresholds — update here if product changes criteria
const GOLD_THRESHOLD = 1.0;   // ≥ 100% of target
const SILVER_THRESHOLD = 0.75; // ≥ 75% of target

type MedalType = "gold" | "silver" | "bronze" | "self";
function getMedal(reps: number, target: number | null): MedalType {
  if (target === null || target === 0) return "self";
  const ratio = reps / target;
  if (ratio >= GOLD_THRESHOLD) return "gold";
  if (ratio >= SILVER_THRESHOLD) return "silver";
  return "bronze";
}

// History: logs grouped by event, sorted by event date desc
const eventGroups = new Map<string, { title: string; date: number; logs: typeof myLogs }>();
for (const log of myLogs) {
  const key = log.eventId;
  if (!eventGroups.has(key)) {
    eventGroups.set(key, { title: log.eventTitle, date: log.eventDate, logs: [] });
  }
  eventGroups.get(key)!.logs.push(log);
}
const historyGroups = [...eventGroups.values()].sort((a, b) => b.date - a.date);

// Quick-log: upcoming events first, then recent past events (deduped)
const nowMs = Date.now();
const futureEvents = allEvents
  .filter((e) => e.date > nowMs)
  .sort((a, b) => a.date - b.date)
  .slice(0, 20);
const pastEvents = allEvents
  .filter((e) => e.date <= nowMs)
  .sort((a, b) => b.date - a.date)
  .slice(0, 10);
const futureIds = new Set(futureEvents.map((e) => e._id));
const quickLogEvents = [...futureEvents, ...pastEvents.filter((e) => !futureIds.has(e._id))];

const STATION_OPTIONS = [
  { value: "stretch",      label: "Stretch" },
  { value: "warmup",       label: "Warmup" },
  { value: "offense",      label: "Offense" },
  { value: "ground_balls", label: "Ground Balls" },
  { value: "defense",      label: "Defense" },
  { value: "3v3_combat",   label: "3v3 Combat" },
  { value: "team_specific", label: "Team Specific" },
  { value: "u6_practice",  label: "U6 Practice" },
] as const;

function formatDate(ts: number): string {
  return new Date(ts).toLocaleDateString("en-US", {
    weekday: "short",
    month: "short",
    day: "numeric",
  });
}

// Serialize assignment data for client-side auto-fill
const assignmentJson = JSON.stringify(
  Object.fromEntries(
    myAssignments.map((a) => [a.eventId, { station: a.station, ageGroup: a.ageGroup ?? "" }])
  )
);
---

<CoachLayout title="My Log" currentTab="log" breadcrumbs={[{ name: "Log", href: "/coach/log" }]}>
  <div class="px-4 py-6 space-y-6">

    <!-- ── Stats ─────────────────────────────────────────── -->
    <section>
      <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Season Stats</h2>

      <!-- Total season reps -->
      <div class="bg-green-50 rounded-xl border border-green-200 p-4 text-center mb-3">
        <p class="text-3xl font-bold text-green-700">{totalSeasonReps.toLocaleString()}</p>
        <p class="text-xs text-green-600 mt-1">Total reps this season (Mar – Jun)</p>
      </div>

      <!-- Last session card -->
      {lastLog ? (
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4 mb-3">
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Last Session</p>
          <p class="font-semibold text-gray-900 text-sm">{lastSessionTitle}</p>
          <p class="text-xs text-gray-400 mb-2">{formatDate(lastSessionDate)}</p>
          <div class="flex gap-6">
            <div>
              <p class="text-lg font-bold text-gray-900">{lastSessionDrills}</p>
              <p class="text-xs text-gray-400">drills</p>
            </div>
            <div>
              <p class="text-lg font-bold text-gray-900">{lastSessionReps.toLocaleString()}</p>
              <p class="text-xs text-gray-400">reps</p>
            </div>
          </div>
        </div>
      ) : (
        <div class="bg-gray-50 rounded-xl border border-gray-200 p-4 text-center mb-3">
          <p class="text-sm text-gray-400">No sessions logged yet.</p>
          <p class="text-xs text-gray-400 mt-1">Use Quick Log below to get started.</p>
        </div>
      )}

      <!-- Per-drill breakdown table -->
      {drillBreakdown.length > 0 && (
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden mb-3">
          <div class="px-4 py-2.5 bg-gray-50 border-b border-gray-100">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">All-Time by Drill</p>
          </div>
          <table class="w-full text-sm">
            <tbody class="divide-y divide-gray-50">
              {drillBreakdown.map(({ name, totalReps, lastReps, lastTarget }) => {
                const medal = getMedal(lastReps, lastTarget);
                return (
                  <tr>
                    <td class="px-4 py-2.5 text-gray-900 font-medium text-xs">{name}</td>
                    <td class="px-4 py-2.5 text-right text-gray-500 text-xs">{totalReps.toLocaleString()} reps</td>
                    <td class="px-4 py-2.5 text-right">
                      {medal === "gold"   && <span class="inline-block px-1.5 py-0.5 rounded text-xs font-medium bg-yellow-400 text-yellow-900">🥇 Gold</span>}
                      {medal === "silver" && <span class="inline-block px-1.5 py-0.5 rounded text-xs font-medium bg-gray-300 text-gray-800">🥈 Silver</span>}
                      {medal === "bronze" && <span class="inline-block px-1.5 py-0.5 rounded text-xs font-medium bg-orange-400 text-orange-900">🥉 Bronze</span>}
                      {medal === "self"   && <span class="inline-block px-1.5 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700">⭐ Self-Reported</span>}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}

      <!-- Top players -->
      {topPlayers.length > 0 && (
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Top Players — All Time</p>
          <div class="space-y-2">
            {topPlayers.map((p, i) => (
              <div class="flex items-center gap-3">
                <span class="text-xs font-bold text-gray-400 w-4">#{i + 1}</span>
                <div class="flex-1 min-w-0">
                  <span class="text-sm text-gray-900 font-medium truncate">{p.name}</span>
                  {p.jerseyNumber != null && <span class="text-xs text-gray-400"> #{p.jerseyNumber}</span>}
                  {p.ageGroup && <span class="ml-1 text-xs text-gray-400">{p.ageGroup}</span>}
                </div>
                <span class="text-sm font-semibold text-green-700 shrink-0">{p.totalReps.toLocaleString()}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </section>

    <!-- ── Quick Log ──────────────────────────────────────── -->
    <section>
      <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Quick Log</h2>
      {isReadOnly ? (
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 text-center">
          <svg class="size-8 text-amber-400 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
          </svg>
          <p class="text-sm font-semibold text-amber-800">Rep logging is available after your application is approved.</p>
        </div>
      ) : (
      <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4">
        <form method="POST" class="space-y-3">

          <div>
            <label class="text-xs font-medium text-gray-700 mb-1 block" for="ql-event">Event</label>
            <select
              id="ql-event"
              name="eventId"
              required
              class="w-full rounded-lg border border-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500"
            >
              <option value="">Select an event…</option>
              {quickLogEvents.map((e) => (
                <option value={e._id}>
                  {formatDate(e.date)} — {e.title}
                </option>
              ))}
            </select>
          </div>

          <div>
            <label class="text-xs font-medium text-gray-700 mb-1 block" for="ql-drill">Drill</label>
            <select
              id="ql-drill"
              name="drillId"
              required
              class="w-full rounded-lg border border-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500"
            >
              <option value="">Select a drill…</option>
              {allDrills.map((d) => (
                <option value={d._id}>{d.name}</option>
              ))}
            </select>
          </div>

          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="text-xs font-medium text-gray-700 mb-1 block" for="ql-station">Station</label>
              <select
                id="ql-station"
                name="station"
                required
                class="w-full rounded-lg border border-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500"
              >
                <option value="">Station…</option>
                {STATION_OPTIONS.map((s) => (
                  <option value={s.value}>{s.label}</option>
                ))}
              </select>
            </div>

            <div>
              <label class="text-xs font-medium text-gray-700 mb-1 block" for="ql-agegroup">Age Group</label>
              <select
                id="ql-agegroup"
                name="ageGroup"
                class="w-full rounded-lg border border-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500"
              >
                <option value="">All ages</option>
                <option value="U6">U6</option>
                <option value="U8">U8</option>
                <option value="U12">U12</option>
                <option value="U14">U14</option>
              </select>
            </div>
          </div>

          <div>
            <label class="text-xs font-medium text-gray-700 mb-1 block" for="ql-reps">Reps Completed</label>
            <input
              id="ql-reps"
              type="number"
              name="reps"
              min="1"
              required
              placeholder="e.g. 50"
              class="w-full rounded-lg border border-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500"
            />
          </div>

          <div>
            <label class="text-xs font-medium text-gray-700 mb-1 block" for="ql-notes">Notes <span class="font-normal text-gray-400">(optional)</span></label>
            <input
              id="ql-notes"
              type="text"
              name="notes"
              placeholder="Any notes…"
              class="w-full rounded-lg border border-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500"
            />
          </div>

          <button
            type="submit"
            class="w-full bg-green-600 text-white font-semibold rounded-xl py-3 text-sm hover:bg-green-700 transition-colors"
          >
            Save Rep Log
          </button>
        </form>
      </div>
      )}
    </section>

    <!-- ── History ────────────────────────────────────────── -->
    {historyGroups.length > 0 && (
      <section>
        <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">History</h2>
        <div class="space-y-3">
          {historyGroups.map(({ title, date, logs }) => (
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
              <div class="px-4 py-3 bg-gray-50 border-b border-gray-100">
                <p class="font-semibold text-gray-900 text-sm">{title}</p>
                <p class="text-xs text-gray-400">{formatDate(date)}</p>
              </div>
              <div class="divide-y divide-gray-50">
                {logs.map((log) => {
                  const medal = getMedal(log.totalRepsCompleted, log.targetReps);
                  return (
                    <div class="px-4 py-3 flex items-center justify-between gap-3">
                      <p class="text-sm text-gray-800 font-medium flex-1 truncate">{log.drillName}</p>
                      <div class="flex items-center gap-2 shrink-0">
                        <span class="text-sm text-gray-600">{log.totalRepsCompleted} reps</span>
                        {medal === "gold"   && <span class="px-1.5 py-0.5 rounded text-xs bg-yellow-400 text-yellow-900 font-medium">🥇</span>}
                        {medal === "silver" && <span class="px-1.5 py-0.5 rounded text-xs bg-gray-300 text-gray-800 font-medium">🥈</span>}
                        {medal === "bronze" && <span class="px-1.5 py-0.5 rounded text-xs bg-orange-400 text-orange-900 font-medium">🥉</span>}
                        {medal === "self"   && <span class="px-1.5 py-0.5 rounded text-xs bg-blue-100 text-blue-700 font-medium">⭐</span>}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

  </div>
</CoachLayout>

<script is:inline define:vars={{ assignmentJson }}>
  // Auto-fill station and age group when coach selects an event they're assigned to
  const assignments = JSON.parse(assignmentJson);
  const eventSelect = document.getElementById('ql-event');
  const stationSelect = document.getElementById('ql-station');
  const ageGroupSelect = document.getElementById('ql-agegroup');

  if (eventSelect && stationSelect && ageGroupSelect) {
    eventSelect.addEventListener('change', function () {
      const eventId = eventSelect.value;
      const assignment = assignments[eventId];

      if (assignment && assignment.station) {
        for (let i = 0; i < stationSelect.options.length; i++) {
          if (stationSelect.options[i].value === assignment.station) {
            stationSelect.selectedIndex = i;
            break;
          }
        }
      } else {
        stationSelect.selectedIndex = 0;
      }

      if (assignment && assignment.ageGroup) {
        for (let i = 0; i < ageGroupSelect.options.length; i++) {
          if (ageGroupSelect.options[i].value === assignment.ageGroup) {
            ageGroupSelect.selectedIndex = i;
            break;
          }
        }
      } else {
        ageGroupSelect.selectedIndex = 0;
      }
    });
  }
</script>
