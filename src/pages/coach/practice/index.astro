---
import CoachLayout from "@layouts/CoachLayout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../../convex/_generated/api";

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/");

const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);

const now = Date.now();

const [allEvents, myAssignments] = await Promise.all([
  client.query(api.events.listEvents, {}),
  client.query(api.assignments.getMyAssignments, { clerkId: userId }),
]);

const upcoming = allEvents
  .filter((e) => e.published === true && e.date > now)
  .sort((a, b) => a.date - b.date);

// Map eventId → all my assignments at that event
const assignmentsByEvent = new Map<string, typeof myAssignments[number][]>();
for (const a of myAssignments) {
  if (!assignmentsByEvent.has(a.eventId)) assignmentsByEvent.set(a.eventId, []);
  assignmentsByEvent.get(a.eventId)!.push(a);
}

// Check which events have plans (parallel queries)
const planFlags = await Promise.all(
  upcoming.map((e) => client.query(api.plans.getPlanForEvent, { eventId: e._id }))
);
const hasPlanByEvent = new Map(upcoming.map((e, i) => [e._id, planFlags[i] !== null]));

const STATION_LABELS: Record<string, string> = {
  stretch: "Stretch",
  warmup: "Warmup",
  offense: "Offense",
  ground_balls: "Ground Balls",
  defense: "Defense",
  "3v3_combat": "3v3 Combat",
  team_specific: "Team Specific",
  u6_practice: "U6 Practice",
};

const TYPE_LABELS: Record<string, string> = {
  practice: "Practice",
  program_training: "Program Training",
  individual_practice: "Individual Practice",
  game: "Game",
  other: "Other",
};

function formatDate(ts: number): string {
  return new Date(ts).toLocaleDateString("en-US", {
    weekday: "short",
    month: "short",
    day: "numeric",
  });
}

function formatTime(ts: number): string {
  return new Date(ts).toLocaleTimeString("en-US", {
    hour: "numeric",
    minute: "2-digit",
  });
}
---

<CoachLayout title="Practice Schedule" currentTab="practice" breadcrumbs={[{ name: "Practice", href: "/coach/practice" }]}>
  <div class="px-4 py-6 space-y-3">

    {upcoming.length === 0 ? (
      <div class="text-center py-16">
        <p class="text-gray-500 text-sm">No upcoming practices scheduled.</p>
        <p class="text-xs text-gray-400 mt-1">Check back soon — your admin will publish new events.</p>
      </div>
    ) : (
      upcoming.map((event) => {
        const eventAssignments = assignmentsByEvent.get(event._id) ?? [];
        const hasPlan = hasPlanByEvent.get(event._id) ?? false;
        return (
          <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4 space-y-2.5">
            <!-- Date / type row -->
            <div class="flex items-start justify-between gap-2">
              <div>
                <p class="font-semibold text-gray-900 text-sm">{formatDate(event.date)}</p>
                <p class="text-xs text-gray-500">
                  {formatTime(event.date)}
                  {event.durationMinutes ? ` · ${event.durationMinutes} min` : ""}
                </p>
              </div>
              <span class="shrink-0 text-xs font-medium bg-green-50 text-green-700 border border-green-200 rounded-full px-2 py-0.5">
                {TYPE_LABELS[event.type] ?? event.type}
              </span>
            </div>

            <!-- Title + location -->
            <div>
              <p class="text-sm text-gray-800 font-medium">{event.title}</p>
              {event.location && (
                <p class="text-xs text-gray-400 mt-0.5">{event.location}</p>
              )}
            </div>

            <!-- Station assignments -->
            {eventAssignments.length > 0 ? (
              <div class="space-y-1">
                {eventAssignments.map((a) => (
                  <div class="flex items-center gap-1.5">
                    <span class="inline-block size-2 rounded-full bg-green-500 shrink-0"></span>
                    <span class="text-xs text-green-700 font-medium">
                      {STATION_LABELS[a.station] ?? a.station}
                      {a.ageGroup ? ` / ${a.ageGroup}` : ""}
                    </span>
                  </div>
                ))}
              </div>
            ) : (
              <div class="flex items-center gap-1.5">
                <span class="inline-block size-2 rounded-full bg-gray-300 shrink-0"></span>
                <span class="text-xs text-gray-400">Unassigned</span>
              </div>
            )}

            <!-- View Plan CTA (only if plan exists) -->
            {hasPlan && (
              <a
                href={`/coach/practice/${event._id}`}
                class="block w-full text-center bg-green-600 text-white font-semibold rounded-lg py-2 text-xs hover:bg-green-700 transition-colors"
              >
                View Practice Plan &rarr;
              </a>
            )}
          </div>
        );
      })
    )}

  </div>
</CoachLayout>
