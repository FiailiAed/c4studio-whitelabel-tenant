---
import CoachLayout from "@layouts/CoachLayout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../../convex/_generated/api";
import type { Id } from "../../../../convex/_generated/dataModel";

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/");

const rawId = Astro.params.id;
if (!rawId) return Astro.redirect("/coach/drills");

const drillId = rawId as Id<"drills">;
const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);
const drill = await client.query(api.drills.getDrill, { id: drillId });

if (!drill) {
  return new Response(null, { status: 404 });
}

const SECTION_LABELS: Record<string, string> = {
  stretch: "Stretch",
  warmup: "Warmup",
  offense: "Offense",
  ground_balls: "Ground Balls",
  defense: "Defense",
  "3v3_combat": "3v3 Combat",
  team_specific: "Team Specific",
  u6_practice: "U6 Practice",
};
---

<CoachLayout title={drill.name} currentTab="drills" breadcrumbs={[{ name: "Drills", href: "/coach/drills" }, { name: drill.name, href: Astro.url.pathname }]}>
  <div class="px-4 py-6 space-y-5">

    <a href="/coach/drills" class="text-sm text-green-600 hover:underline">&larr; Back to Drills</a>

    <!-- Header -->
    <div>
      <h2 class="text-xl font-bold text-gray-900">{drill.name}</h2>
      {drill.defaultSection && (
        <span class="inline-block mt-1 text-xs text-gray-500 bg-gray-100 rounded-full px-2 py-0.5">
          {SECTION_LABELS[drill.defaultSection] ?? drill.defaultSection}
        </span>
      )}
    </div>

    <!-- Stats -->
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4 space-y-2">
      <div class="flex justify-between text-sm">
        <span class="text-gray-500">Duration</span>
        <span class="font-medium text-gray-900">{drill.defaultDurationMinutes} min</span>
      </div>
      <div class="flex justify-between text-sm">
        <span class="text-gray-500">Reps per minute</span>
        <span class="font-medium text-gray-900">{drill.repsPerMinute}</span>
      </div>
      <div class="flex justify-between text-sm">
        <span class="text-gray-500">Total reps</span>
        <span class="font-medium text-gray-900">
          At {drill.repsPerMinute} reps/min over {drill.defaultDurationMinutes} min = {Math.round(drill.defaultDurationMinutes * drill.repsPerMinute)} reps
        </span>
      </div>
      {drill.suitableAgeGroups && drill.suitableAgeGroups.length > 0 && (
        <div class="flex justify-between text-sm">
          <span class="text-gray-500">Age groups</span>
          <span class="font-medium text-gray-900">{drill.suitableAgeGroups.join(", ")}</span>
        </div>
      )}
    </div>

    <!-- Description -->
    {drill.description && (
      <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-1">Description</h3>
        <p class="text-sm text-gray-600">{drill.description}</p>
      </div>
    )}

    <!-- Diagram -->
    {drill.diagramSvg && (
      <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-2">Diagram</h3>
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4">
          <div set:html={drill.diagramSvg} />
        </div>
      </div>
    )}

    <!-- Video -->
    {drill.videoUrl && (
      <a
        href={drill.videoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="block w-full text-center bg-green-600 text-white font-semibold rounded-xl py-3 text-sm hover:bg-green-700"
      >
        Watch Video
      </a>
    )}

  </div>
</CoachLayout>
