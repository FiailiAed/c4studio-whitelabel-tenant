---
import Layout from "@layouts/Layout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "@convex/_generated/api";
import type { Id } from "@convex/_generated/dataModel";
import { z } from "zod";

const { slug, programId } = Astro.params;

if (!slug || !programId) return Astro.redirect("/");

// Auth gate: must be signed in (no tenant membership required)
const { userId } = Astro.locals.auth();
if (!userId) {
  return Astro.redirect(`/sign-in?redirect_url=${encodeURIComponent(Astro.url.pathname)}`);
}

const token = await Astro.locals.auth().getToken({ template: "convex" });
const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);
if (token) client.setAuth(token);

// Load program and tenant info
const [program, tenant] = await Promise.all([
  client.query(api.programs.getProgram, { programId: programId as Id<"programs"> }),
  client.query(api.tenants.getTenantBySlug, { slug }),
]);

if (!program || !tenant) return Astro.redirect("/");
if (program.status !== "ACTIVE") {
  // Program is not open — show a closed message instead of redirecting
}

// Get Convex user (create if missing — parent may never have hit a protected route)
let convexUser = await client.query(api.users.getUserByClerkId, { clerkId: userId });
if (!convexUser) {
  const clerkUser = await Astro.locals.currentUser();
  const email = clerkUser?.emailAddresses?.find(
    (e: { id: string; emailAddress: string }) => e.id === clerkUser?.primaryEmailAddressId,
  )?.emailAddress ?? "";
  await client.mutation(api.users.upsertUser, {
    clerkId: userId,
    email,
    firstName: clerkUser?.firstName ?? undefined,
    lastName: clerkUser?.lastName ?? undefined,
  });
  convexUser = await client.query(api.users.getUserByClerkId, { clerkId: userId });
}

if (!convexUser) return Astro.redirect("/sign-in");

// Load existing players for this parent
const existingPlayers = await client.query(api.players.listByParent, {
  parentId: convexUser._id,
});

// Handle form POST
const RegistrationSchema = z.object({
  existingPlayerId: z.string().optional(),
  fieldsEdited: z.enum(["true", "false"]).optional(),
  firstName: z.string().min(1, "First name is required."),
  lastName: z.string().min(1, "Last name is required."),
  dateOfBirth: z.string().min(1, "Date of birth is required."),
  grade: z.coerce.number().int().min(1).max(12),
  usLacrosseNumber: z.string().optional(),
  medicalNotes: z.string().optional(),
});

let formErrors: Record<string, string> = {};
let checkoutUrl: string | null = null;
let serverError: string | null = null;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  const rawData = {
    existingPlayerId: formData.get("existingPlayerId")?.toString() ?? undefined,
    fieldsEdited: formData.get("fieldsEdited")?.toString() ?? undefined,
    firstName: formData.get("firstName")?.toString() ?? "",
    lastName: formData.get("lastName")?.toString() ?? "",
    dateOfBirth: formData.get("dateOfBirth")?.toString() ?? "",
    grade: formData.get("grade")?.toString() ?? "",
    usLacrosseNumber: formData.get("usLacrosseNumber")?.toString() || undefined,
    medicalNotes: formData.get("medicalNotes")?.toString() || undefined,
  };

  const parsed = RegistrationSchema.safeParse(rawData);

  if (!parsed.success) {
    parsed.error.issues.forEach((e) => {
      const field = e.path[0]?.toString() ?? "form";
      formErrors[field] = e.message;
    });
  } else {
    const data = parsed.data;

    try {
      let playerId: Id<"players">;

      const useExisting =
        data.existingPlayerId && data.fieldsEdited !== "true";

      if (useExisting) {
        playerId = data.existingPlayerId as Id<"players">;
      } else if (data.existingPlayerId && data.fieldsEdited === "true") {
        // Update existing player with new data
        await client.mutation(api.players.updatePlayer, {
          id: data.existingPlayerId as Id<"players">,
          firstName: data.firstName,
          lastName: data.lastName,
          dateOfBirth: data.dateOfBirth,
          grade: data.grade,
          usLacrosseNumber: data.usLacrosseNumber,
          medicalNotes: data.medicalNotes,
        });
        playerId = data.existingPlayerId as Id<"players">;
      } else {
        // Create new player
        playerId = await client.mutation(api.players.createPlayer, {
          parentId: convexUser._id,
          firstName: data.firstName,
          lastName: data.lastName,
          dateOfBirth: data.dateOfBirth,
          grade: data.grade,
          usLacrosseNumber: data.usLacrosseNumber,
          medicalNotes: data.medicalNotes,
        });
      }

      const siteUrl = Astro.url.origin;
      checkoutUrl = await client.action(api.registrations.createRegistrationAndCheckout, {
        tenantId: tenant._id,
        programId: program._id,
        playerId,
        parentId: convexUser._id,
        siteUrl,
        tenantSlug: slug,
      });
    } catch (err) {
      serverError = err instanceof Error ? err.message : "An error occurred. Please try again.";
    }
  }
}

// If we got a checkout URL, redirect immediately
if (checkoutUrl) {
  return Astro.redirect(checkoutUrl);
}

const wasCanceled = Astro.url.searchParams.get("canceled") === "true";
const formatPrice = (cents: number) =>
  new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" }).format(cents / 100);

// Serialize players for the client-side JS
const playersJson = JSON.stringify(
  existingPlayers.map((p: typeof existingPlayers[number]) => ({
    id: p._id,
    firstName: p.firstName,
    lastName: p.lastName,
    dateOfBirth: p.dateOfBirth,
    grade: p.grade,
    usLacrosseNumber: p.usLacrosseNumber ?? "",
    medicalNotes: p.medicalNotes ?? "",
  })),
);
---

<Layout title={`Register — ${program.name}`}>
  <div class="min-h-screen bg-gray-50 py-8 px-4">
    <div class="max-w-lg mx-auto space-y-6">

      <!-- Header -->
      <div>
        <a href={`/t/${slug}/regs`} class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 transition-colors mb-4">
          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
          </svg>
          Back
        </a>
        <h1 class="text-2xl font-bold text-gray-900">{program.name}</h1>
        <div class="flex items-center gap-3 mt-2">
          <p class="text-xl font-semibold text-indigo-600">{formatPrice(program.priceInCents)}</p>
          <span class="text-gray-300">·</span>
          <p class="text-sm text-gray-500">{tenant.name}</p>
        </div>
        {program.description && (
          <p class="mt-2 text-sm text-gray-600">{program.description}</p>
        )}
      </div>

      <!-- Program closed notice -->
      {program.status !== "ACTIVE" && (
        <div class="rounded-lg bg-yellow-50 border border-yellow-200 px-4 py-3">
          <p class="text-sm font-medium text-yellow-800">Registration for this program is currently closed.</p>
        </div>
      )}

      <!-- Canceled notice -->
      {wasCanceled && (
        <div class="rounded-lg bg-amber-50 border border-amber-200 px-4 py-3">
          <p class="text-sm text-amber-700">Your payment was canceled. Your registration has not been completed.</p>
        </div>
      )}

      <!-- Server error -->
      {serverError && (
        <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3">
          <p class="text-sm text-red-700">{serverError}</p>
        </div>
      )}

      {program.status === "ACTIVE" && (
        <form
          id="registration-form"
          method="POST"
          class="bg-white rounded-xl border border-gray-200 shadow-sm divide-y divide-gray-100"
        >
          <!-- Hidden fields for JS state -->
          <input type="hidden" name="existingPlayerId" id="existing-player-id" value="" />
          <input type="hidden" name="fieldsEdited" id="fields-edited" value="false" />

          <!-- ── Player Selection (returning parents only) ── -->
          {existingPlayers.length > 0 && (
            <div class="px-4 py-4 space-y-3">
              <label for="player-select" class="block text-sm font-semibold text-gray-900">
                Select a player
              </label>
              <select
                id="player-select"
                class="block w-full rounded-md border-0 bg-white px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 text-sm"
              >
                <option value="">— Enter new player —</option>
                {existingPlayers.map((p: typeof existingPlayers[number]) => (
                  <option value={p._id}>
                    {p.firstName} {p.lastName} (Grade {p.grade})
                  </option>
                ))}
              </select>

              <!-- Review note — shown after player selected -->
              <div id="review-note" class="hidden rounded-lg bg-blue-50 border border-blue-200 px-3 py-2.5 flex items-start gap-2">
                <svg class="size-4 text-blue-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
                </svg>
                <p class="text-xs text-blue-700">
                  Player info is pre-filled. If anything has changed,
                  <button
                    type="button"
                    id="enable-edit-btn"
                    class="underline font-medium hover:no-underline"
                  >click here to update it.</button>
                </p>
              </div>
            </div>
          )}

          <!-- ── Player Info Fields ── -->
          <div class="px-4 py-4 space-y-4">
            <h2 class="text-sm font-semibold text-gray-900">Player Information</h2>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="firstName" class="block text-xs font-medium text-gray-700 mb-1">First Name <span class="text-red-500">*</span></label>
                <input
                  id="firstName"
                  name="firstName"
                  type="text"
                  required
                  class="field block w-full rounded-md border-0 bg-white px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 text-sm"
                />
                {formErrors.firstName && <p class="mt-1 text-xs text-red-600">{formErrors.firstName}</p>}
              </div>
              <div>
                <label for="lastName" class="block text-xs font-medium text-gray-700 mb-1">Last Name <span class="text-red-500">*</span></label>
                <input
                  id="lastName"
                  name="lastName"
                  type="text"
                  required
                  class="field block w-full rounded-md border-0 bg-white px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 text-sm"
                />
                {formErrors.lastName && <p class="mt-1 text-xs text-red-600">{formErrors.lastName}</p>}
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="dateOfBirth" class="block text-xs font-medium text-gray-700 mb-1">Date of Birth <span class="text-red-500">*</span></label>
                <input
                  id="dateOfBirth"
                  name="dateOfBirth"
                  type="date"
                  required
                  class="field block w-full rounded-md border-0 bg-white px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 text-sm"
                />
                {formErrors.dateOfBirth && <p class="mt-1 text-xs text-red-600">{formErrors.dateOfBirth}</p>}
              </div>
              <div>
                <label for="grade" class="block text-xs font-medium text-gray-700 mb-1">Grade <span class="text-red-500">*</span></label>
                <input
                  id="grade"
                  name="grade"
                  type="number"
                  required
                  min="1"
                  max="12"
                  placeholder="e.g. 7"
                  class="field block w-full rounded-md border-0 bg-white px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 text-sm"
                />
                {formErrors.grade && <p class="mt-1 text-xs text-red-600">{formErrors.grade}</p>}
              </div>
            </div>

            <div>
              <label for="usLacrosseNumber" class="block text-xs font-medium text-gray-700 mb-1">
                US Lacrosse # <span class="text-gray-400 font-normal">(if known)</span>
              </label>
              <input
                id="usLacrosseNumber"
                name="usLacrosseNumber"
                type="text"
                placeholder="e.g. 010011234567"
                class="field block w-full rounded-md border-0 bg-white px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 text-sm"
              />
            </div>

            <div>
              <label for="medicalNotes" class="block text-xs font-medium text-gray-700 mb-1">
                Medical Notes <span class="text-gray-400 font-normal">(allergies, conditions, etc.)</span>
              </label>
              <textarea
                id="medicalNotes"
                name="medicalNotes"
                rows="3"
                class="field block w-full rounded-md border-0 bg-white px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 text-sm resize-none"
              ></textarea>
            </div>
          </div>

          <!-- ── Submit ── -->
          <div class="px-4 py-4">
            <p class="text-xs text-gray-500 mb-3">
              You'll be redirected to a secure Stripe checkout page to complete payment.
              No card info is stored on this site.
            </p>
            <button
              id="submit-btn"
              type="submit"
              class="relative flex w-full justify-center items-center rounded-md bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-all disabled:opacity-70 disabled:cursor-not-allowed"
            >
              <span id="submit-text">Pay {formatPrice(program.priceInCents)} & Register</span>
              <svg
                id="submit-spinner"
                class="hidden absolute right-4 size-5 animate-spin text-white"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
              >
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </div>
        </form>
      )}
    </div>
  </div>
</Layout>

<script define:vars={{ playersJson }}>
  /** @type {{ id: string; firstName: string; lastName: string; dateOfBirth: string; grade: number; usLacrosseNumber: string; medicalNotes: string; }[]} */
  const players = JSON.parse(playersJson);

  const playerSelect = document.getElementById("player-select");
  const existingPlayerIdInput = document.getElementById("existing-player-id");
  const fieldsEditedInput = document.getElementById("fields-edited");
  const reviewNote = document.getElementById("review-note");
  const enableEditBtn = document.getElementById("enable-edit-btn");
  const form = document.getElementById("registration-form");
  const submitBtn = document.getElementById("submit-btn");
  const submitText = document.getElementById("submit-text");
  const submitSpinner = document.getElementById("submit-spinner");

  // All player info inputs
  const fields = ["firstName", "lastName", "dateOfBirth", "grade", "usLacrosseNumber", "medicalNotes"];

  function setFieldsReadonly(readonly) {
    fields.forEach((name) => {
      const el = document.getElementById(name);
      if (!el) return;
      if (readonly) {
        el.setAttribute("readonly", "");
        el.setAttribute("tabindex", "-1");
        el.classList.add("bg-gray-50", "text-gray-500", "cursor-not-allowed");
        el.classList.remove("focus:ring-2", "focus:ring-indigo-600");
      } else {
        el.removeAttribute("readonly");
        el.removeAttribute("tabindex");
        el.classList.remove("bg-gray-50", "text-gray-500", "cursor-not-allowed");
        el.classList.add("focus:ring-2", "focus:ring-indigo-600");
      }
    });
  }

  function populateFields(player) {
    const el = (id) => document.getElementById(id);
    if (el("firstName")) el("firstName").value = player.firstName;
    if (el("lastName")) el("lastName").value = player.lastName;
    if (el("dateOfBirth")) el("dateOfBirth").value = player.dateOfBirth;
    if (el("grade")) el("grade").value = player.grade;
    if (el("usLacrosseNumber")) el("usLacrosseNumber").value = player.usLacrosseNumber;
    if (el("medicalNotes")) el("medicalNotes").value = player.medicalNotes;
  }

  function clearFields() {
    fields.forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.value = "";
    });
  }

  // Player dropdown change
  playerSelect?.addEventListener("change", () => {
    const selectedId = playerSelect.value;
    if (!selectedId) {
      // "Enter new player"
      existingPlayerIdInput.value = "";
      fieldsEditedInput.value = "false";
      clearFields();
      setFieldsReadonly(false);
      reviewNote?.classList.add("hidden");
      return;
    }

    const player = players.find((p) => p.id === selectedId);
    if (!player) return;

    existingPlayerIdInput.value = selectedId;
    fieldsEditedInput.value = "false";
    populateFields(player);
    setFieldsReadonly(true);
    reviewNote?.classList.remove("hidden");
  });

  // "Update info" link
  enableEditBtn?.addEventListener("click", () => {
    setFieldsReadonly(false);
    fieldsEditedInput.value = "true";
    reviewNote?.classList.add("hidden");
    document.getElementById("firstName")?.focus();
  });

  // Submit: disable button + show spinner (no preventDefault — let native POST run)
  form?.addEventListener("submit", () => {
    submitBtn.disabled = true;
    submitText.textContent = "Processing…";
    submitSpinner.classList.remove("hidden");
  });
</script>
