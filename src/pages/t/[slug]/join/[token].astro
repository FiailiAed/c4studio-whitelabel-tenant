---
import { ConvexHttpClient } from "convex/browser";
import { api } from "@convex/_generated/api";

const { slug, token } = Astro.params;
if (!slug || !token) return Astro.redirect("/");

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect(`/sign-in?redirect_url=${encodeURIComponent(Astro.url.pathname)}`);

const authToken = await Astro.locals.auth().getToken({ template: "convex" });
const convex = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);
if (authToken) convex.setAuth(authToken);

// Validate the invite
const invite = await convex.query(api.tenantInvites.getByToken, { token });

let errorMessage: string | null = null;

if (!invite || invite.status !== "pending") {
  errorMessage = "This invite link is invalid or has already been used.";
} else if (invite.expiresAt < Date.now()) {
  errorMessage = "This invite link has expired.";
} else {
  // Validate the invite belongs to the right tenant
  const tenant = await convex.query(api.tenants.getTenantBySlug, { slug });
  if (!tenant || tenant._id !== invite.tenantId) {
    errorMessage = "This invite link is not valid for this organization.";
  } else {
    // Check if already a member — redirect to dashboard
    const membership = await convex.query(api.tenantMembers.getMembership, {
      tenantId: invite.tenantId,
      clerkId: userId,
    });
    if (membership?.status === "active") {
      return Astro.redirect(`/t/${slug}`);
    }
  }
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Joining organization…</title>
  <link rel="stylesheet" href="/src/styles/global.css" />
</head>
<body class="min-h-screen bg-gray-50 flex items-center justify-center p-4">
  <div class="max-w-sm w-full">
    {errorMessage ? (
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-8 text-center space-y-4">
        <div class="mx-auto w-12 h-12 rounded-full bg-red-50 flex items-center justify-center">
          <svg class="w-6 h-6 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </div>
        <h1 class="text-base font-semibold text-gray-900">Invite Invalid</h1>
        <p class="text-sm text-gray-500">{errorMessage}</p>
        <a href="/" class="inline-block text-sm font-medium text-indigo-600 hover:text-indigo-500">Go home</a>
      </div>
    ) : (
      <div id="join-card" class="bg-white rounded-xl border border-gray-200 shadow-sm p-8 text-center space-y-4">
        <div class="mx-auto w-12 h-12 rounded-full bg-indigo-50 flex items-center justify-center">
          <svg class="w-6 h-6 text-indigo-600 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </div>
        <h1 class="text-base font-semibold text-gray-900">Joining organization…</h1>
        <p class="text-sm text-gray-500">Please wait while we set up your access.</p>
        <div id="error-msg" class="hidden text-sm text-red-600"></div>
      </div>
    )}
  </div>
</body>
</html>

{!errorMessage && (
  <script define:vars={{ slug, token }} is:inline>
    (async function () {
      try {
        const res = await fetch(`/api/t/${slug}/invites/${token}/consume`, { method: "POST" });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error ?? "Failed to join");
        window.location.href = `/t/${slug}`;
      } catch (err) {
        const card = document.getElementById("join-card");
        const errMsg = document.getElementById("error-msg");
        if (card && errMsg) {
          card.querySelector("svg")?.classList.remove("animate-spin");
          card.querySelector("h1").textContent = "Something went wrong";
          errMsg.textContent = err.message;
          errMsg.classList.remove("hidden");
        }
      }
    })();
  </script>
)}
