---
import TenantLayout from "@layouts/TenantLayout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "@convex/_generated/api";

const tenant = Astro.locals.tenant;
const membership = Astro.locals.membership;
const isImpersonating = Astro.locals.isImpersonating ?? false;

if (!tenant) return Astro.redirect("/");

const tenantRole = isImpersonating ? "admin" : (membership?.tenantRole ?? "coach");
if (tenantRole !== "admin") return Astro.redirect(`/t/${tenant.slug}`);

const token = await Astro.locals.auth().getToken({ template: "convex" });
const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);
if (token) client.setAuth(token);

const [members, allUsers, invites] = await Promise.all([
  client.query(api.tenantMembers.listTenantMembers, { tenantId: tenant._id }),
  client.query(api.users.listAllUsers, {}),
  client.query(api.tenantInvites.listByTenant, { tenantId: tenant._id }),
]);

// Staff members only (exclude parents — they're managed via registration flow)
const staffMembers = members
  .filter((m) => m.tenantRole !== "parent")
  .map((m) => {
    const user = allUsers.find((u) => u.clerkId === m.clerkId);
    return { ...m, user };
  });

// Active (pending) invites only
const activeInvites = invites.filter((i) => i.status === "pending");
---

<TenantLayout
  title="Team Members"
  tenant={tenant}
  currentTab="members"
  tenantRole={tenantRole}
  isImpersonating={isImpersonating}
  breadcrumbs={[
    { name: tenant.name, href: `/t/${tenant.slug}` },
    { name: "Members", href: `/t/${tenant.slug}/members` },
  ]}
>
  <div class="space-y-4">

    <!-- Error banner -->
    <div id="error-banner" class="hidden bg-red-50 border border-red-200 rounded-xl p-3">
      <p class="text-sm text-red-700" id="error-message"></p>
    </div>

    <!-- Header -->
    <div class="flex items-center justify-between">
      <h2 class="text-sm font-semibold text-gray-700">Team ({staffMembers.length})</h2>
      <button
        id="open-invite-modal"
        type="button"
        class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-500 transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Invite Member
      </button>
    </div>

    <!-- Staff members list -->
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm divide-y divide-gray-50">
      {staffMembers.length === 0 && (
        <p class="text-sm text-gray-400 text-center py-8">No staff members yet. Invite someone to get started.</p>
      )}
      {staffMembers.map((m) => (
        <div class="flex items-center justify-between px-4 py-3 hover:bg-gray-50 transition-colors">
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-gray-900 truncate">
              {m.user ? (`${m.user.firstName ?? ""} ${m.user.lastName ?? ""}`.trim() || m.user.email) : m.clerkId}
            </p>
            {m.user?.email && (
              <p class="text-xs text-gray-400 truncate">{m.user.email}</p>
            )}
          </div>
          <div class="flex items-center gap-2 shrink-0 ml-3">
            <!-- Role selector -->
            <select
              class="role-select text-xs rounded-md border border-gray-200 bg-white px-2 py-1 font-medium text-gray-700 focus:outline-none focus:ring-1 focus:ring-indigo-500"
              data-clerk-id={m.clerkId}
              value={m.tenantRole}
            >
              <option value="admin" selected={m.tenantRole === "admin"}>Admin</option>
              <option value="coach" selected={m.tenantRole === "coach"}>Coach</option>
            </select>
            <!-- Status badge -->
            <span class={`text-xs font-medium rounded-full px-2 py-0.5 ${
              m.status === "active"
                ? "bg-green-50 text-green-700 ring-1 ring-green-200"
                : "bg-gray-100 text-gray-500"
            }`}>
              {m.status}
            </span>
            <!-- Remove -->
            <button
              type="button"
              class="remove-btn text-xs text-red-400 hover:text-red-600 transition-colors"
              data-clerk-id={m.clerkId}
            >
              Remove
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- Join Link Generator -->
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4 space-y-3">
      <h3 class="text-sm font-semibold text-gray-700">Generate Join Link</h3>
      <p class="text-xs text-gray-500">Create a shareable link. Anyone with this link can join as the selected role. Expires in 7 days.</p>
      <div class="flex gap-2">
        <select id="link-role" class="flex-1 rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-700 focus:outline-none focus:ring-1 focus:ring-indigo-500">
          <option value="coach">Coach</option>
          <option value="admin">Admin</option>
        </select>
        <button id="generate-link-btn" type="button"
          class="shrink-0 bg-gray-900 text-white text-sm font-medium rounded-lg px-4 py-2 hover:bg-gray-700 transition-colors">
          Generate
        </button>
      </div>
      <div id="link-result" class="hidden">
        <div class="flex items-center gap-2 rounded-lg bg-gray-50 border border-gray-200 px-3 py-2">
          <input id="link-url" type="text" readonly class="flex-1 bg-transparent text-xs text-gray-600 font-mono outline-none min-w-0" />
          <button id="copy-link-btn" type="button" class="shrink-0 text-xs font-medium text-indigo-600 hover:text-indigo-500">
            Copy
          </button>
        </div>
      </div>
    </div>

    <!-- Pending Invites -->
    {activeInvites.length > 0 && (
      <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4 space-y-2">
        <h3 class="text-sm font-semibold text-gray-700">Pending Invites ({activeInvites.length})</h3>
        <div class="space-y-1">
          {activeInvites.map((inv) => (
            <div class="flex items-center justify-between rounded-lg px-3 py-2.5 hover:bg-gray-50">
              <div class="min-w-0 flex-1">
                <p class="text-sm text-gray-700 truncate">
                  {inv.type === "email" ? (inv.email ?? "Email invite") : "Join link"}
                </p>
                <p class="text-xs text-gray-400 capitalize">
                  {inv.role} · expires {new Date(inv.expiresAt).toLocaleDateString()}
                </p>
              </div>
              <div class="flex items-center gap-2 ml-3 shrink-0">
                {inv.type === "link" && (
                  <button
                    type="button"
                    class="copy-invite-link text-xs text-indigo-500 hover:text-indigo-700"
                    data-token={inv.token}
                  >
                    Copy link
                  </button>
                )}
                <button
                  type="button"
                  class="revoke-btn text-xs text-red-400 hover:text-red-600"
                  data-token={inv.token}
                >
                  Revoke
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

  </div>

  <!-- Add Member (Email Invite) Modal -->
  <dialog
    id="invite-modal"
    class="rounded-xl shadow-xl border border-gray-200 p-0 w-full max-w-sm backdrop:bg-black/40"
  >
    <div class="p-5 space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-semibold text-gray-900">Invite Member by Email</h3>
        <button id="close-modal" type="button" class="text-gray-400 hover:text-gray-600">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div id="modal-error" class="hidden rounded-lg bg-red-50 border border-red-200 px-3 py-2">
        <p class="text-xs text-red-700" id="modal-error-text"></p>
      </div>
      <form id="invite-form" class="space-y-3">
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-xs font-medium text-gray-600 mb-1">First Name</label>
            <input name="firstName" type="text" placeholder="Jane"
              class="block w-full rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none" />
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-600 mb-1">Last Name</label>
            <input name="lastName" type="text" placeholder="Smith"
              class="block w-full rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none" />
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">Email <span class="text-red-500">*</span></label>
          <input name="email" type="email" required placeholder="jane@example.com"
            class="block w-full rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none" />
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">Role <span class="text-red-500">*</span></label>
          <select name="role" required
            class="block w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none">
            <option value="coach">Coach</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <div class="flex gap-2 pt-1">
          <button type="button" id="cancel-modal"
            class="flex-1 rounded-lg border border-gray-200 px-3 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors">
            Cancel
          </button>
          <button type="submit" id="invite-submit"
            class="flex-1 rounded-lg bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500 transition-colors disabled:opacity-70">
            Send Invite
          </button>
        </div>
      </form>
    </div>
  </dialog>

</TenantLayout>

<script define:vars={{ tenantSlug: tenant.slug }} is:inline>
  // ── Helpers ────────────────────────────────────────────────────────────────
  function showError(msg) {
    const banner = document.getElementById('error-banner');
    document.getElementById('error-message').textContent = msg;
    banner.classList.remove('hidden');
    setTimeout(() => banner.classList.add('hidden'), 5000);
  }

  // ── Modal ──────────────────────────────────────────────────────────────────
  const modal = document.getElementById('invite-modal');
  document.getElementById('open-invite-modal')?.addEventListener('click', () => modal.showModal());
  document.getElementById('close-modal')?.addEventListener('click', () => modal.close());
  document.getElementById('cancel-modal')?.addEventListener('click', () => modal.close());

  // ── Email invite form ──────────────────────────────────────────────────────
  document.getElementById('invite-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = document.getElementById('invite-submit');
    btn.disabled = true;
    btn.textContent = 'Sending…';
    const modalError = document.getElementById('modal-error');
    const modalErrorText = document.getElementById('modal-error-text');
    modalError.classList.add('hidden');

    const data = Object.fromEntries(new FormData(this).entries());
    try {
      const res = await fetch(`/api/t/${tenantSlug}/members/invite`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error ?? 'Failed to send invite');
      modal.close();
      window.location.reload();
    } catch (err) {
      modalErrorText.textContent = err.message;
      modalError.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Send Invite';
    }
  });

  // ── Role change ────────────────────────────────────────────────────────────
  document.querySelectorAll('.role-select').forEach(function(sel) {
    sel.addEventListener('change', async function() {
      const clerkId = this.dataset.clerkId;
      const tenantRole = this.value;
      try {
        const res = await fetch(`/api/t/${tenantSlug}/members/${clerkId}/update`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tenantRole }),
        });
        if (!res.ok) {
          const json = await res.json();
          throw new Error(json.error ?? 'Failed to update role');
        }
      } catch (err) {
        showError(err.message);
        window.location.reload();
      }
    });
  });

  // ── Remove member ──────────────────────────────────────────────────────────
  document.querySelectorAll('.remove-btn').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      if (!confirm('Remove this member from the organization?')) return;
      const clerkId = this.dataset.clerkId;
      try {
        const res = await fetch(`/api/t/${tenantSlug}/members/${clerkId}/remove`, {
          method: 'POST',
        });
        if (!res.ok) {
          const json = await res.json();
          throw new Error(json.error ?? 'Failed to remove member');
        }
        window.location.reload();
      } catch (err) {
        showError(err.message);
      }
    });
  });

  // ── Generate join link ────────────────────────────────────────────────────
  document.getElementById('generate-link-btn')?.addEventListener('click', async function() {
    const role = document.getElementById('link-role').value;
    this.disabled = true;
    this.textContent = 'Generating…';
    try {
      const res = await fetch(`/api/t/${tenantSlug}/invites/create-link`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ role }),
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error ?? 'Failed to generate link');
      const linkResult = document.getElementById('link-result');
      const linkUrl = document.getElementById('link-url');
      linkUrl.value = json.url;
      linkResult.classList.remove('hidden');
    } catch (err) {
      showError(err.message);
    } finally {
      this.disabled = false;
      this.textContent = 'Generate';
    }
  });

  // ── Copy generated link ────────────────────────────────────────────────────
  document.getElementById('copy-link-btn')?.addEventListener('click', function() {
    const url = document.getElementById('link-url').value;
    navigator.clipboard.writeText(url).then(() => {
      this.textContent = 'Copied!';
      setTimeout(() => { this.textContent = 'Copy'; }, 2000);
    });
  });

  // ── Copy pending invite link ───────────────────────────────────────────────
  document.querySelectorAll('.copy-invite-link').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const url = `${window.location.origin}/t/${tenantSlug}/join/${this.dataset.token}`;
      navigator.clipboard.writeText(url).then(() => {
        this.textContent = 'Copied!';
        setTimeout(() => { this.textContent = 'Copy link'; }, 2000);
      });
    });
  });

  // ── Revoke invite ──────────────────────────────────────────────────────────
  document.querySelectorAll('.revoke-btn').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      if (!confirm('Revoke this invite? The link will no longer work.')) return;
      const token = this.dataset.token;
      try {
        const res = await fetch(`/api/t/${tenantSlug}/invites/${token}/revoke`, {
          method: 'POST',
        });
        if (!res.ok) {
          const json = await res.json();
          throw new Error(json.error ?? 'Failed to revoke invite');
        }
        window.location.reload();
      } catch (err) {
        showError(err.message);
      }
    });
  });
</script>
