---
import TenantLayout from "@layouts/TenantLayout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "@convex/_generated/api";
import type { Id } from "@convex/_generated/dataModel";

const tenant = Astro.locals.tenant;
const membership = Astro.locals.membership;
const isImpersonating = Astro.locals.isImpersonating ?? false;

if (!tenant) return Astro.redirect("/");

const isAdmin = isImpersonating || membership?.tenantRole === "admin";
const canManagePrograms = isAdmin || membership?.tenantRole === "coach";
if (!canManagePrograms) return Astro.redirect(`/t/${tenant.slug}`);

const { id } = Astro.params;
if (!id) return Astro.redirect(`/t/${tenant.slug}/regs`);

const token = await Astro.locals.auth().getToken({ template: "convex" });
const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);
if (token) client.setAuth(token);

const program = await client.query(api.programs.getProgram, {
  programId: id as Id<"programs">,
});

if (!program) return Astro.redirect(`/t/${tenant.slug}/regs`);

const priceDisplay = (program.priceInCents / 100).toFixed(2);
---

<TenantLayout
  title="Edit Program"
  tenant={tenant}
  currentTab="regs"
  tenantRole={membership?.tenantRole}
  isImpersonating={isImpersonating}
  breadcrumbs={[
    { name: "Regs", href: `/t/${tenant.slug}/regs` },
    { name: "Edit Program", href: "#" },
  ]}
>
  <div class="max-w-lg mx-auto">
    <div class="mb-6">
      <h1 class="text-xl font-bold text-gray-900">Edit Program</h1>
      <p class="text-sm text-gray-500 mt-1">{program.name}</p>
    </div>

    <div id="error-banner" class="hidden mb-4 rounded-lg bg-red-50 border border-red-200 px-4 py-3">
      <p class="text-sm text-red-700" id="error-text"></p>
    </div>

    <!-- Registration link callout -->
    {program.status === "ACTIVE" && (
      <div class="mb-4 flex items-center gap-3 rounded-lg bg-indigo-50 border border-indigo-200 px-4 py-3">
        <svg class="size-5 text-indigo-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
        </svg>
        <div class="flex-1 min-w-0">
          <p class="text-xs font-semibold text-indigo-800">Registration Link</p>
          <p class="text-xs text-indigo-600 font-mono truncate" id="reg-link-text">
            {Astro.url.origin}/t/{tenant.slug}/register/{program._id}
          </p>
        </div>
        <button
          onclick={`navigator.clipboard.writeText('${Astro.url.origin}/t/${tenant.slug}/register/${program._id}').then(() => { this.textContent = 'Copied!'; setTimeout(() => this.textContent = 'Copy', 1500); })`}
          class="shrink-0 rounded-md bg-indigo-600 px-2.5 py-1 text-xs font-medium text-white hover:bg-indigo-500 transition-colors"
        >
          Copy
        </button>
      </div>
    )}

    <form id="program-form" class="bg-white rounded-xl border border-gray-200 shadow-sm divide-y divide-gray-100">

      <div class="px-4 py-4 space-y-4">
        <div>
          <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Program Name <span class="text-red-500">*</span></label>
          <input
            id="name"
            name="name"
            type="text"
            required
            value={program.name}
            class="block w-full rounded-md border-0 bg-white px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 text-sm"
          />
        </div>

        <div>
          <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
          <textarea
            id="description"
            name="description"
            rows="3"
            class="block w-full rounded-md border-0 bg-white px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 text-sm resize-none"
          >{program.description ?? ""}</textarea>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="price" class="block text-sm font-medium text-gray-700 mb-1">Registration Fee <span class="text-red-500">*</span></label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">$</span>
              <input
                id="price"
                name="price"
                type="number"
                required
                min="0"
                step="0.01"
                value={priceDisplay}
                class="block w-full rounded-md border-0 bg-white pl-7 pr-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 text-sm"
              />
            </div>
          </div>
          <div>
            <label for="capacity" class="block text-sm font-medium text-gray-700 mb-1">Capacity</label>
            <input
              id="capacity"
              name="capacity"
              type="number"
              min="1"
              value={program.capacity ?? ""}
              placeholder="Unlimited"
              class="block w-full rounded-md border-0 bg-white px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 text-sm"
            />
          </div>
        </div>

        <div>
          <label for="status" class="block text-sm font-medium text-gray-700 mb-1">Status <span class="text-red-500">*</span></label>
          <select
            id="status"
            name="status"
            required
            class="block w-full rounded-md border-0 bg-white px-3 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 text-sm"
          >
            <option value="DRAFT" selected={program.status === "DRAFT"}>Draft — not visible to parents</option>
            <option value="ACTIVE" selected={program.status === "ACTIVE"}>Active — open for registration</option>
            <option value="CLOSED" selected={program.status === "CLOSED"}>Closed — registration ended</option>
          </select>
        </div>
      </div>

      <div class="px-4 py-4 flex items-center justify-between gap-3">
        <a
          href={`/t/${tenant.slug}/regs`}
          class="text-sm font-medium text-gray-600 hover:text-gray-800 transition-colors"
        >
          Cancel
        </a>
        <button
          id="submit-btn"
          type="submit"
          class="relative inline-flex items-center justify-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition-all disabled:opacity-70 disabled:cursor-not-allowed"
        >
          <span id="submit-text">Save Changes</span>
          <svg
            id="submit-spinner"
            class="hidden absolute right-3 size-4 animate-spin text-white"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>
      </div>
    </form>
  </div>
</TenantLayout>

<script define:vars={{ tenantSlug: tenant.slug, programId: program._id }}>
  const form = document.getElementById("program-form");
  const submitBtn = document.getElementById("submit-btn");
  const submitText = document.getElementById("submit-text");
  const submitSpinner = document.getElementById("submit-spinner");
  const errorBanner = document.getElementById("error-banner");
  const errorText = document.getElementById("error-text");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitText.textContent = "Saving…";
    submitSpinner.classList.remove("hidden");
    errorBanner.classList.add("hidden");

    const data = new FormData(form);
    const price = parseFloat(data.get("price"));
    const capacity = data.get("capacity") ? parseInt(data.get("capacity"), 10) : undefined;

    const body = {
      id: programId,
      name: data.get("name"),
      description: data.get("description") || undefined,
      priceInCents: Math.round(price * 100),
      capacity,
      status: data.get("status"),
    };

    try {
      const res = await fetch("/api/t/programs/update", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error ?? "Something went wrong.");
      window.location.href = `/t/${tenantSlug}/regs`;
    } catch (err) {
      errorText.textContent = err.message;
      errorBanner.classList.remove("hidden");
      submitBtn.disabled = false;
      submitText.textContent = "Save Changes";
      submitSpinner.classList.add("hidden");
    }
  });
</script>
