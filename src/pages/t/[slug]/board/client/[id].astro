---
import TenantLayout from "@layouts/TenantLayout.astro";

const tenant = Astro.locals.tenant;
const membership = Astro.locals.membership;
const isImpersonating = Astro.locals.isImpersonating ?? false;

if (!tenant) return Astro.redirect("/");

const { id: clientId } = Astro.params;
if (!clientId) return Astro.redirect(`/t/${tenant.slug}/board`);

const tenantRole = isImpersonating ? "admin" : (membership?.tenantRole ?? "member");
const convexUrl = import.meta.env.PUBLIC_CONVEX_URL;
---

<TenantLayout
  title="Client Detail"
  tenant={tenant}
  currentTab="board"
  tenantRole={tenantRole}
  isImpersonating={isImpersonating}
>
  <!-- Server → client data bridge -->
  <div
    id="detail-root"
    data-client-id={clientId}
    data-convex-url={convexUrl}
    data-tenant-id={tenant._id}
    data-tenant-slug={tenant.slug}
    class="hidden"
    aria-hidden="true"
  ></div>

  <!-- Tailwind JIT safelist -->
  <div
    aria-hidden="true"
    class="hidden
      bg-red-100 text-red-700 border-red-200
      bg-blue-100 text-blue-700 border-blue-200
      bg-green-100 text-green-700 border-green-200
      bg-indigo-100 text-indigo-700 border-indigo-200
      bg-orange-100 text-orange-700 border-orange-200
      bg-rose-100 text-rose-700 border-rose-200
      bg-cyan-100 text-cyan-700 border-cyan-200
      bg-violet-100 text-violet-700 border-violet-200
      bg-yellow-100 text-yellow-700 border-yellow-200
      bg-amber-100 text-amber-700 border-amber-200
      bg-purple-100 text-purple-700 border-purple-200
      bg-teal-100 text-teal-700 border-teal-200
      bg-slate-400 bg-amber-400 bg-emerald-500 line-through"
  ></div>

  <!-- Back button -->
  <div class="mb-5">
    <a
      href={`/t/${tenant.slug}/board`}
      class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-800 transition-colors"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Board
    </a>
  </div>

  <!-- Client header (populated by JS) -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5 mb-5">
    <div class="flex items-start justify-between flex-wrap gap-3">
      <div class="flex items-center gap-4">
        <div
          id="detail-avatar"
          class="w-12 h-12 rounded-lg flex items-center justify-center font-bold text-sm border flex-shrink-0"
        ></div>
        <div>
          <h1 id="detail-name" class="text-lg font-bold text-slate-800"></h1>
          <p id="detail-email" class="text-sm text-slate-500"></p>
        </div>
      </div>
      <div class="flex items-center gap-2 flex-wrap">
        <span id="detail-priority" class="text-xs font-medium px-2.5 py-1 rounded-full"></span>
        <span id="detail-status" class="text-xs font-medium px-2.5 py-1 rounded-full"></span>
      </div>
    </div>
  </div>

  <!-- Contacts section -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5 mb-5">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-sm font-semibold text-slate-700">Contacts</h2>
      <button
        id="add-contact-btn"
        class="text-xs font-medium text-indigo-600 hover:text-indigo-700 transition-colors"
      >+ Add Contact</button>
    </div>

    <!-- Inline add contact form -->
    <form id="add-contact-form" class="hidden mb-4 p-4 bg-slate-50 rounded-lg space-y-3">
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Name *</label>
          <input
            name="contactName"
            required
            type="text"
            class="w-full px-2.5 py-1.5 text-xs border border-slate-200 rounded-md
                   focus:outline-none focus:ring-2 focus:ring-indigo-300"
          />
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Role</label>
          <input
            name="contactRole"
            type="text"
            class="w-full px-2.5 py-1.5 text-xs border border-slate-200 rounded-md
                   focus:outline-none focus:ring-2 focus:ring-indigo-300"
          />
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Email</label>
          <input
            name="contactEmail"
            type="email"
            class="w-full px-2.5 py-1.5 text-xs border border-slate-200 rounded-md
                   focus:outline-none focus:ring-2 focus:ring-indigo-300"
          />
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Phone</label>
          <input
            name="contactPhone"
            type="tel"
            class="w-full px-2.5 py-1.5 text-xs border border-slate-200 rounded-md
                   focus:outline-none focus:ring-2 focus:ring-indigo-300"
          />
        </div>
      </div>
      <div class="flex gap-2">
        <button
          type="submit"
          class="px-3 py-1.5 text-xs font-medium text-white bg-indigo-600 rounded-md
                 hover:bg-indigo-700 transition-colors"
        >Save Contact</button>
        <button
          type="button"
          id="cancel-contact-btn"
          class="px-3 py-1.5 text-xs font-medium text-slate-600 bg-white border
                 border-slate-200 rounded-md hover:bg-slate-50 transition-colors"
        >Cancel</button>
      </div>
    </form>

    <div id="contacts-list" class="space-y-2">
      <p id="no-contacts" class="text-xs text-slate-400">No contacts added yet.</p>
    </div>
  </div>

  <!-- Tasks section -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
    <h2 class="text-sm font-semibold text-slate-700 mb-4">Tasks</h2>
    <div id="detail-task-list" class="flex flex-col gap-2 mb-3"></div>
    <input
      id="detail-new-task"
      type="text"
      placeholder="Add task… (press Enter)"
      class="w-full text-xs text-slate-500 placeholder-slate-400 bg-transparent border-0
             border-b border-dashed border-slate-200 py-1.5 focus:outline-none
             focus:border-indigo-300 transition-colors"
    />
  </div>

  <!-- ─── Templates ────────────────────────────────────────────────────── -->

  <template id="contact-item-template">
    <div data-contact-item class="flex items-start gap-3 p-3 bg-slate-50 rounded-lg">
      <div class="flex-1 min-w-0">
        <p data-contact-name class="text-xs font-semibold text-slate-700"></p>
        <p data-contact-role class="text-xs text-slate-500 mb-1"></p>
        <div class="flex items-center gap-3 flex-wrap">
          <a data-contact-email href="#" class="text-xs text-indigo-600 hover:text-indigo-700 truncate"></a>
          <span data-contact-phone class="text-xs text-slate-500"></span>
        </div>
      </div>
    </div>
  </template>

  <template id="detail-task-template">
    <div
      data-detail-task
      data-action="toggle-task"
      class="flex items-start gap-2 cursor-pointer group py-1"
    >
      <span data-status-dot class="mt-0.5 h-2 w-2 rounded-full flex-shrink-0 transition-colors"></span>
      <span data-task-title class="text-sm leading-relaxed text-slate-600 group-hover:text-slate-800 transition-colors"></span>
    </div>
  </template>

  <!-- ─── Client-side script ───────────────────────────────────────────── -->
  <script>
    import { ConvexClient } from "convex/browser";
    import { api } from "@convex/_generated/api";
    import type { Id } from "@convex/_generated/dataModel";

    // ── Types ──────────────────────────────────────────────────────────────
    type TaskStatus = "todo" | "pending" | "done";

    interface Contact {
      name: string;
      email: string;
      role: string;
      phone: string;
    }

    interface Task {
      _id: Id<"tasks">;
      title: string;
      status: TaskStatus;
    }

    interface ClientDetail {
      _id: Id<"clients">;
      name: string;
      email: string;
      status: "active" | "inactive";
      priority: "high" | "medium" | "low";
      contacts: Contact[];
      tasks: Task[];
    }

    // ── Server data ────────────────────────────────────────────────────────
    const detailRoot = document.getElementById("detail-root")!;
    const clientId = detailRoot.dataset.clientId as Id<"clients">;
    const convexUrl = detailRoot.dataset.convexUrl!;
    const tenantId = detailRoot.dataset.tenantId as Id<"tenants">;

    // ── Helpers ────────────────────────────────────────────────────────────
    const NEXT_STATUS: Record<TaskStatus, TaskStatus> = {
      todo: "pending",
      pending: "done",
      done: "todo",
    };

    const STATUS_DOT_CLASS: Record<TaskStatus, string> = {
      todo: "bg-slate-400",
      pending: "bg-amber-400",
      done: "bg-emerald-500",
    };

    const PRIORITY_CLASSES: Record<string, string> = {
      high: "text-xs font-medium px-2.5 py-1 rounded-full bg-red-100 text-red-700",
      medium: "text-xs font-medium px-2.5 py-1 rounded-full bg-amber-100 text-amber-700",
      low: "text-xs font-medium px-2.5 py-1 rounded-full bg-green-100 text-green-700",
    };

    const AVATAR_PALETTE = [
      "bg-red-100 text-red-700 border-red-200",
      "bg-blue-100 text-blue-700 border-blue-200",
      "bg-green-100 text-green-700 border-green-200",
      "bg-indigo-100 text-indigo-700 border-indigo-200",
      "bg-orange-100 text-orange-700 border-orange-200",
      "bg-rose-100 text-rose-700 border-rose-200",
      "bg-cyan-100 text-cyan-700 border-cyan-200",
      "bg-violet-100 text-violet-700 border-violet-200",
      "bg-yellow-100 text-yellow-700 border-yellow-200",
      "bg-amber-100 text-amber-700 border-amber-200",
    ];

    function avatarClasses(name: string): string {
      return AVATAR_PALETTE[name.charCodeAt(0) % AVATAR_PALETTE.length];
    }

    function initials(name: string): string {
      return name
        .split(/\s+/)
        .map((w) => w[0] ?? "")
        .join("")
        .toUpperCase()
        .slice(0, 3);
    }

    function applyTaskStatus(el: HTMLElement, status: TaskStatus): void {
      const dot = el.querySelector<HTMLElement>("[data-status-dot]")!;
      const title = el.querySelector<HTMLElement>("[data-task-title]")!;
      dot.className = `mt-0.5 h-2 w-2 rounded-full flex-shrink-0 transition-colors ${STATUS_DOT_CLASS[status]}`;
      title.className =
        status === "done"
          ? "text-sm leading-relaxed line-through text-slate-400 transition-colors"
          : "text-sm leading-relaxed text-slate-600 group-hover:text-slate-800 transition-colors";
      el.dataset.status = status;
    }

    // ── Render contacts ────────────────────────────────────────────────────
    function renderContacts(contacts: Contact[]): void {
      const list = document.getElementById("contacts-list")!;
      const noContacts = document.getElementById("no-contacts")!;
      const tpl = document.getElementById("contact-item-template") as HTMLTemplateElement;

      for (const item of list.querySelectorAll("[data-contact-item]")) item.remove();

      if (contacts.length === 0) {
        noContacts.classList.remove("hidden");
        return;
      }

      noContacts.classList.add("hidden");
      for (const c of contacts) {
        const frag = tpl.content.cloneNode(true) as DocumentFragment;
        // Safe: textContent only
        frag.querySelector<HTMLElement>("[data-contact-name]")!.textContent = c.name;
        frag.querySelector<HTMLElement>("[data-contact-role]")!.textContent = c.role || "—";
        const emailEl = frag.querySelector<HTMLAnchorElement>("[data-contact-email]")!;
        emailEl.textContent = c.email || "—";
        if (c.email) emailEl.href = `mailto:${c.email}`;
        frag.querySelector<HTMLElement>("[data-contact-phone]")!.textContent = c.phone || "—";
        list.appendChild(frag);
      }
    }

    // ── Render tasks ───────────────────────────────────────────────────────
    function renderTasks(tasks: Task[]): void {
      const list = document.getElementById("detail-task-list")!;
      const tpl = document.getElementById("detail-task-template") as HTMLTemplateElement;

      while (list.firstChild) list.removeChild(list.firstChild);

      for (const task of tasks) {
        const frag = tpl.content.cloneNode(true) as DocumentFragment;
        const taskEl = frag.querySelector<HTMLElement>("[data-detail-task]")!;
        taskEl.dataset.taskId = task._id;
        taskEl.dataset.status = task.status;
        // Safe: textContent
        frag.querySelector<HTMLElement>("[data-task-title]")!.textContent = task.title;
        applyTaskStatus(taskEl, task.status);
        list.appendChild(frag);
      }
    }

    // ── Render client ──────────────────────────────────────────────────────
    function renderClient(data: ClientDetail): void {
      const avatarEl = document.getElementById("detail-avatar")!;
      avatarEl.className = `w-12 h-12 rounded-lg flex items-center justify-center font-bold text-sm border flex-shrink-0 ${avatarClasses(data.name)}`;
      avatarEl.textContent = initials(data.name);

      document.getElementById("detail-name")!.textContent = data.name;
      document.getElementById("detail-email")!.textContent = data.email;

      const priorityEl = document.getElementById("detail-priority")!;
      priorityEl.textContent =
        data.priority.charAt(0).toUpperCase() + data.priority.slice(1);
      priorityEl.className =
        PRIORITY_CLASSES[data.priority] ??
        "text-xs font-medium px-2.5 py-1 rounded-full bg-slate-100 text-slate-600";

      const statusEl = document.getElementById("detail-status")!;
      statusEl.textContent = data.status.charAt(0).toUpperCase() + data.status.slice(1);
      statusEl.className =
        data.status === "active"
          ? "text-xs font-medium px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-700"
          : "text-xs font-medium px-2.5 py-1 rounded-full bg-slate-100 text-slate-500";

      renderContacts(data.contacts);
      renderTasks(data.tasks);
    }

    // ── Convex + Clerk auth ────────────────────────────────────────────────
    declare global {
      interface Window {
        Clerk: {
          session?: { getToken(opts: { template: string }): Promise<string | null> };
        };
      }
    }

    const convex = new ConvexClient(convexUrl);
    convex.setAuth(async () => {
      if (!window.Clerk?.session) return null;
      return await window.Clerk.session.getToken({ template: "convex" });
    });

    convex.onUpdate(api.board.getClientBoard, { clientId }, (data) => {
      if (data) renderClient(data as ClientDetail);
    });

    // ── Task toggle (event delegation) ────────────────────────────────────
    document.getElementById("detail-task-list")!.addEventListener("click", (e) => {
      const taskEl = (e.target as HTMLElement).closest<HTMLElement>("[data-action='toggle-task']");
      if (!taskEl) return;
      const taskId = taskEl.dataset.taskId as Id<"tasks">;
      const current = taskEl.dataset.status as TaskStatus;
      const next = NEXT_STATUS[current];
      applyTaskStatus(taskEl, next);
      convex.mutation(api.tasks.updateTaskStatus, { taskId, status: next }).catch(() => {
        applyTaskStatus(taskEl, current);
      });
    });

    // ── Inline task creation ───────────────────────────────────────────────
    document.getElementById("detail-new-task")!.addEventListener("keydown", (e) => {
      if (e.key !== "Enter") return;
      const input = e.target as HTMLInputElement;
      const title = input.value.trim();
      if (!title) return;
      input.value = "";
      convex.mutation(api.tasks.createTask, { clientId, tenantId, title });
    });

    // ── Contacts ───────────────────────────────────────────────────────────
    const addContactBtn = document.getElementById("add-contact-btn")!;
    const addContactForm = document.getElementById("add-contact-form") as HTMLFormElement;
    const cancelContactBtn = document.getElementById("cancel-contact-btn")!;

    addContactBtn.addEventListener("click", () => addContactForm.classList.remove("hidden"));
    cancelContactBtn.addEventListener("click", () => {
      addContactForm.classList.add("hidden");
      addContactForm.reset();
    });

    addContactForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(addContactForm);
      const contact: Contact = {
        name: (fd.get("contactName") as string).trim(),
        role: (fd.get("contactRole") as string).trim(),
        email: (fd.get("contactEmail") as string).trim(),
        phone: (fd.get("contactPhone") as string).trim(),
      };
      if (!contact.name) return;
      addContactForm.classList.add("hidden");
      addContactForm.reset();
      await convex.mutation(api.clients.addContact, { clientId, contact });
    });
  </script>
</TenantLayout>
