---
import AdminDashboardLayout from "@layouts/AdminDashboardLayout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../../../convex/_generated/api";
import type { Id } from "../../../../../convex/_generated/dataModel";

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/");

const { id } = Astro.params;
if (!id) return Astro.redirect("/admin/events");

const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);
const callerUser = await client.query(api.users.getUserByClerkId, { clerkId: userId });
if (!callerUser || callerUser.role !== "admin") return Astro.redirect("/");

const GAME_TYPES = ["game", "scrimmage", "festival"];

const [event, planData, allDrills] = await Promise.all([
  client.query(api.events.getEvent, { id: id as Id<"events"> }),
  client.query(api.plans.getPlanForEvent, { eventId: id as Id<"events"> }),
  client.query(api.drills.listDrills, {}),
]);

if (!event) return Astro.redirect("/admin/events");

// Redirect game types to checklist
if (GAME_TYPES.includes(event.type)) {
  return Astro.redirect(`/admin/events/${id}/checklist`);
}

// If POST with action=init_plan, create the plan
if (Astro.request.method === "POST") {
  const data = await Astro.request.formData();
  const action = data.get("action");
  if (action === "init_plan" && !planData) {
    const planName = (data.get("planName") as string | null)?.trim()
      || `Practice Plan — ${new Date(event.date).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}`;
    await client.mutation(api.plans.createPlan, {
      name: planName,
      isTemplate: false,
      eventId: id as Id<"events">,
      createdBy: userId,
    });
    return Astro.redirect(`/admin/events/${id}/plan`);
  }
}

const plan = planData?.plan ?? null;
const planDrills = planData?.drills ?? [];

// Organize drills by section+ageGroup for rendering
type SectionKey = string; // e.g. "offense:" or "team_specific:U8"
const drillsBySection = new Map<SectionKey, typeof planDrills>();
for (const pd of planDrills) {
  const key = `${pd.section}:${pd.ageGroup ?? ""}`;
  if (!drillsBySection.has(key)) drillsBySection.set(key, []);
  drillsBySection.get(key)!.push(pd);
}
for (const [, list] of drillsBySection) {
  list.sort((a, b) => a.order - b.order);
}

function getDrillsFor(section: string, ageGroup?: string): typeof planDrills {
  return drillsBySection.get(`${section}:${ageGroup ?? ""}`) ?? [];
}

// Event-type-aware plan sections
type SectionConfig = {
  key: string;
  label: string;
  ageGroup?: string;
  shared: boolean;
  color: "indigo" | "violet" | "gray";
};

function getSections(eventType: string, targetAgeGroup?: string): SectionConfig[] {
  if (["speed_series", "program_training", "practice"].includes(eventType)) {
    return [
      { key: "stretch",      label: "Stretch",               shared: true,  color: "gray"   },
      { key: "warmup",       label: "Warmup",                shared: true,  color: "gray"   },
      { key: "offense",      label: "Offense",               shared: true,  color: "indigo" },
      { key: "ground_balls", label: "Ground Balls",          shared: true,  color: "indigo" },
      { key: "defense",      label: "Defense",               shared: true,  color: "indigo" },
      { key: "3v3_combat",   label: "3v3 Combat",            shared: true,  color: "indigo" },
      { key: "u6_practice",  label: "U6 Practice (Scoopers)", shared: false, ageGroup: "U6", color: "violet" },
    ];
  }
  if (eventType === "shootaround") {
    return [
      { key: "stretch",      label: "Stretch",      shared: true, color: "gray"   },
      { key: "warmup",       label: "Warmup",       shared: true, color: "gray"   },
      { key: "offense",      label: "Offense",      shared: true, color: "indigo" },
      { key: "ground_balls", label: "Ground Balls", shared: true, color: "indigo" },
      { key: "defense",      label: "Defense",      shared: true, color: "indigo" },
    ];
  }
  if (eventType === "team_practice") {
    return [
      { key: "team_specific", label: "U6 (Scoopers)", shared: false, ageGroup: "U6",  color: "indigo" },
      { key: "team_specific", label: "U8",            shared: false, ageGroup: "U8",  color: "indigo" },
      { key: "team_specific", label: "U12",           shared: false, ageGroup: "U12", color: "indigo" },
      { key: "team_specific", label: "U14",           shared: false, ageGroup: "U14", color: "indigo" },
    ];
  }
  if (eventType === "individual_practice") {
    const ag = targetAgeGroup ?? "U12";
    return [
      { key: "stretch",      label: "Stretch",              shared: true,  color: "gray"   },
      { key: "warmup",       label: "Warmup",               shared: true,  color: "gray"   },
      { key: "offense",      label: `Offense (${ag})`,      shared: false, ageGroup: ag, color: "indigo" },
      { key: "ground_balls", label: `Ground Balls (${ag})`, shared: false, ageGroup: ag, color: "indigo" },
      { key: "defense",      label: `Defense (${ag})`,      shared: false, ageGroup: ag, color: "indigo" },
      { key: "3v3_combat",   label: `3v3 Combat (${ag})`,   shared: false, ageGroup: ag, color: "indigo" },
    ];
  }
  // fallback — other event types use shared section structure
  return getSections("speed_series");
}

const sections = getSections(event.type, event.targetAgeGroup ?? undefined);
const isShootaround = event.type === "shootaround";

// Check for legacy age-grouped drills (program_training with old per-age-group split)
const hasLegacyAgeGroupedDrills = planDrills.some(
  (pd) => pd.ageGroup && ["U8", "U12", "U14"].includes(pd.ageGroup)
    && ["offense", "ground_balls", "defense"].includes(pd.section)
);
---

<AdminDashboardLayout title={`Practice Plan — ${event.title}`} currentTab="events" breadcrumbs={[{ name: "Events", href: "/admin/events" }, { name: event.title, href: `/admin/events/${id}` }, { name: "Plan", href: Astro.url.pathname }]}>

  <div class="mb-6 flex items-center justify-between">
    <a href={`/admin/events/${id}`} class="flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700">
      <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M11.78 5.22a.75.75 0 010 1.06L8.06 10l3.72 3.72a.75.75 0 11-1.06 1.06l-4.25-4.25a.75.75 0 010-1.06l4.25-4.25a.75.75 0 011.06 0Z" clip-rule="evenodd" />
      </svg>
      Back to Event
    </a>
    {plan && (
      <div class="text-sm text-gray-500">
        Plan: <span class="font-medium text-gray-900">{plan.name}</span>
      </div>
    )}
  </div>

  {!plan ? (
    <!-- Initialize plan form -->
    <div class="bg-white rounded-xl shadow-sm ring-1 ring-gray-900/5 px-6 py-8 max-w-lg">
      <h2 class="text-base font-semibold text-gray-900">Create Practice Plan</h2>
      <p class="mt-1 text-sm text-gray-500">
        This will initialize a new practice plan for this event. You can then add drills to each section.
      </p>
      <form method="POST" class="mt-6 space-y-4">
        <input type="hidden" name="action" value="init_plan" />
        <div>
          <label for="planName" class="block text-sm font-medium text-gray-900">Plan Name</label>
          <input
            type="text"
            id="planName"
            name="planName"
            placeholder={`Practice Plan — ${new Date(event.date).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}`}
            class="mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
          />
        </div>
        <button
          type="submit"
          class="rounded-md bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500"
        >
          Initialize Plan
        </button>
      </form>
    </div>
  ) : (
    <div>
      <!-- Status bar -->
      <div id="planStatus" class="hidden mb-4 rounded-md p-3 text-sm font-medium"></div>

      {hasLegacyAgeGroupedDrills && (
        <div class="mb-4 rounded-md bg-amber-50 border border-amber-200 p-4">
          <p class="text-sm text-amber-800">
            <strong>Note:</strong> This plan has drills stored with age-group splits from the old per-age-group view.
            These drills are not visible in the current shared-section view. You may need to re-add them.
          </p>
        </div>
      )}

      <!-- Save All Changes button (top) -->
      <div class="mb-4 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          {isShootaround && (
            <div class="flex items-center gap-2">
              <label for="playlistUrlInput" class="text-sm font-medium text-gray-700 whitespace-nowrap">Playlist URL</label>
              <input
                type="url"
                id="playlistUrlInput"
                placeholder="https://open.spotify.com/playlist/…"
                value={plan.playlistUrl ?? ""}
                class="w-64 rounded-md border border-gray-300 px-3 py-1.5 text-sm text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
              />
            </div>
          )}
        </div>
        <button
          id="saveAllBtn"
          type="button"
          class="rounded-md bg-indigo-600 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500"
        >
          Save All Changes
        </button>
      </div>

      <!-- Save as Template -->
      <div class="mb-6 bg-white rounded-xl shadow-sm ring-1 ring-gray-900/5 px-5 py-4 flex items-center gap-4">
        <div class="flex-1">
          <label for="templateName" class="block text-sm font-medium text-gray-700">Save as Template</label>
          <input
            type="text"
            id="templateName"
            placeholder="Template name…"
            class="mt-1 block w-full max-w-xs rounded-md border border-gray-300 px-3 py-1.5 text-sm text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
          />
        </div>
        <button
          id="saveTemplateBtn"
          type="button"
          class="mt-5 rounded-md bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50"
        >
          Save Template
        </button>
      </div>

      <!-- Section blocks -->
      <div class="space-y-6">
        {sections.map((sec) => {
          const sectionDrills = getDrillsFor(sec.key, sec.ageGroup);
          const headerBg = sec.color === "violet"
            ? "bg-violet-50 border-violet-100"
            : sec.color === "indigo"
              ? "bg-indigo-50 border-indigo-100"
              : "bg-gray-50 border-gray-200";
          const headerText = sec.color === "violet"
            ? "text-violet-800"
            : sec.color === "indigo"
              ? "text-indigo-900"
              : "text-gray-900";
          const ringColor = sec.color === "violet" ? "ring-violet-200" : "ring-gray-900/5";
          const addBtnColor = sec.color === "violet"
            ? "bg-violet-600 hover:bg-violet-500"
            : "bg-indigo-600 hover:bg-indigo-500";
          const addFooterBg = sec.color === "violet" ? "bg-violet-50" : "bg-gray-50";
          const addLinkColor = sec.color === "violet"
            ? "text-violet-600 hover:text-violet-800"
            : "text-indigo-600 hover:text-indigo-800";

          return (
            <div class={`bg-white rounded-xl shadow-sm ring-1 ${ringColor} overflow-hidden`}>
              <div class={`px-5 py-3 ${headerBg} border-b flex items-center justify-between`}>
                <h3 class={`text-sm font-semibold ${headerText}`}>
                  {sec.label}
                  {sec.shared && <span class="text-xs font-normal text-gray-400 ml-1">(all age groups)</span>}
                  {sec.color === "violet" && <span class="text-xs font-normal text-violet-400 ml-1">(parallel track)</span>}
                </h3>
              </div>
              <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                  <thead>
                    <tr class="text-left text-xs text-gray-400 border-b border-gray-100">
                      <th class="px-4 py-2 font-medium">Drill</th>
                      <th class="px-4 py-2 font-medium">Min</th>
                      <th class="px-4 py-2 font-medium">Reps/min</th>
                      <th class="px-4 py-2 font-medium">Players</th>
                      <th class="px-4 py-2 font-medium">Total Reps</th>
                      <th class="px-4 py-2 font-medium">Per Player</th>
                      <th class="px-4 py-2 font-medium">Override</th>
                      <th class="px-4 py-2"></th>
                    </tr>
                  </thead>
                  <tbody class={`tbody-section divide-y divide-gray-50`} data-section={sec.key} data-age-group={sec.ageGroup ?? ""}>
                    {sectionDrills.map((pd) => (
                      <tr class="drill-row" data-plan-drill-id={pd._id}>
                        <td class="px-4 py-2 font-medium text-gray-900">{pd.drill?.name ?? "—"}</td>
                        <td class="px-4 py-2">
                          <input type="number" class="duration-input w-16 rounded border border-gray-200 px-1.5 py-1 text-sm" value={pd.durationMinutes} min="1" data-reps-per-min={pd.drill?.repsPerMinute ?? 0} />
                        </td>
                        <td class="px-4 py-2 text-gray-500">{pd.drill?.repsPerMinute ?? "—"}</td>
                        <td class="px-4 py-2">
                          <input type="number" class="player-count-input w-16 rounded border border-gray-200 px-1.5 py-1 text-sm" value={pd.playerCountAtStation ?? ""} placeholder="—" min="1" />
                        </td>
                        <td class="px-4 py-2 total-reps text-gray-700">{pd.repsOverride ?? (pd.durationMinutes * (pd.drill?.repsPerMinute ?? 0))}</td>
                        <td class="px-4 py-2 per-player-reps text-gray-700">
                          {pd.repsOverride != null
                            ? `${pd.repsOverride} (manual)`
                            : pd.playerCountAtStation
                              ? Math.round((pd.durationMinutes * (pd.drill?.repsPerMinute ?? 0)) / pd.playerCountAtStation)
                              : "—"}
                        </td>
                        <td class="px-4 py-2">
                          <input type="number" class="override-input w-20 rounded border border-gray-200 px-1.5 py-1 text-sm" value={pd.repsOverride ?? ""} placeholder="—" min="0" />
                        </td>
                        <td class="px-4 py-2">
                          <button type="button" class="remove-drill-btn text-xs text-red-600 hover:text-red-800" data-plan-drill-id={pd._id}>Remove</button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <!-- Add drill form -->
              <div class={`px-4 py-3 border-t border-gray-100 ${addFooterBg}`}>
                <details class="add-drill-details">
                  <summary class={`cursor-pointer text-sm ${addLinkColor} font-medium list-none`}>+ Add Drill</summary>
                  <div class="mt-3 flex flex-wrap items-end gap-3">
                    <div>
                      <label class="block text-xs text-gray-500 mb-1">Drill</label>
                      <select class="drill-picker rounded border border-gray-300 px-2 py-1.5 text-sm">
                        <option value="">Select drill…</option>
                        {allDrills.map((d) => (
                          <option value={d._id} data-default-duration={d.defaultDurationMinutes} data-reps-per-min={d.repsPerMinute}>
                            {d.name}
                          </option>
                        ))}
                      </select>
                    </div>
                    <div>
                      <label class="block text-xs text-gray-500 mb-1">Duration (min)</label>
                      <input type="number" class="add-duration rounded border border-gray-300 px-2 py-1.5 text-sm w-20" value="10" min="1" />
                    </div>
                    <div>
                      <label class="block text-xs text-gray-500 mb-1">Players</label>
                      <input type="number" class="add-players rounded border border-gray-300 px-2 py-1.5 text-sm w-20" placeholder="—" min="1" />
                    </div>
                    <button
                      type="button"
                      class={`add-drill-btn rounded-md ${addBtnColor} px-3 py-1.5 text-sm font-semibold text-white`}
                      data-plan-id={plan._id}
                      data-section={sec.key}
                      data-age-group={sec.ageGroup ?? ""}
                    >
                      Add
                    </button>
                  </div>
                </details>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Save All Changes button (bottom) -->
      <div class="mt-6 flex justify-end">
        <button
          type="button"
          class="rounded-md bg-indigo-600 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500"
          onclick="document.getElementById('saveAllBtn').click()"
        >
          Save All Changes
        </button>
      </div>

    </div>
  )}

</AdminDashboardLayout>

<script is:inline define:vars={{ planId: plan?._id ?? null, planPlaylistUrl: plan?.playlistUrl ?? null, isShootaround }}>
  const statusEl = document.getElementById("planStatus");

  function showStatus(msg, isError) {
    if (!statusEl) return;
    statusEl.textContent = msg;
    statusEl.className = `mb-4 rounded-md p-3 text-sm font-medium ${isError ? "bg-red-50 text-red-700" : "bg-green-50 text-green-700"}`;
    statusEl.classList.remove("hidden");
    setTimeout(() => statusEl.classList.add("hidden"), 4000);
  }

  // ── Reps calculation ──────────────────────────────────────────────────────
  function calcReps(row) {
    const durInput = row.querySelector(".duration-input");
    const playerInput = row.querySelector(".player-count-input");
    const overrideInput = row.querySelector(".override-input");
    const totalEl = row.querySelector(".total-reps");
    const perPlayerEl = row.querySelector(".per-player-reps");

    const dur = parseFloat(durInput?.value) || 0;
    const rpm = parseFloat(durInput?.dataset.repsPerMin) || 0;
    const players = parseFloat(playerInput?.value) || 0;
    const override = overrideInput?.value !== "" ? parseFloat(overrideInput.value) : null;

    const total = Math.round(dur * rpm);
    const perPlayer = players > 0 ? Math.round(total / players) : null;
    if (totalEl) totalEl.textContent = String(total);
    if (perPlayerEl) {
      perPlayerEl.textContent = override !== null
        ? `${override} (manual)`
        : perPlayer !== null
          ? String(perPlayer)
          : "—";
    }
  }

  document.querySelectorAll(".drill-row").forEach((row) => {
    row.querySelectorAll(".duration-input, .player-count-input, .override-input").forEach((input) => {
      input.addEventListener("input", () => calcReps(row));
    });
  });

  // ── Auto-fill duration when drill selected ────────────────────────────────
  document.querySelectorAll(".drill-picker").forEach((select) => {
    select.addEventListener("change", () => {
      const chosen = select.options[select.selectedIndex];
      const defaultDur = chosen?.dataset.defaultDuration;
      const parent = select.closest("details")?.querySelector(".add-duration");
      if (parent && defaultDur) parent.value = defaultDur;
    });
  });

  // ── Bulk Save All Changes ─────────────────────────────────────────────────
  const saveAllBtn = document.getElementById("saveAllBtn");
  if (saveAllBtn) {
    saveAllBtn.addEventListener("click", async () => {
      const updates = [];
      document.querySelectorAll(".drill-row[data-plan-drill-id]").forEach((row) => {
        const planDrillId = row.dataset.planDrillId;
        if (!planDrillId) return;
        const dur = parseFloat(row.querySelector(".duration-input")?.value) || 1;
        const players = row.querySelector(".player-count-input")?.value;
        const override = row.querySelector(".override-input")?.value;
        updates.push({
          planDrillId,
          durationMinutes: dur,
          playerCountAtStation: players ? parseInt(players, 10) : undefined,
          repsOverride: override !== "" && override != null ? parseInt(override, 10) : undefined,
        });
      });

      // Collect playlist URL for shootaround
      const playlistInput = document.getElementById("playlistUrlInput");
      const playlistUrl = playlistInput ? playlistInput.value.trim() : undefined;

      saveAllBtn.disabled = true;
      saveAllBtn.textContent = "Saving…";

      try {
        const res = await fetch("/api/admin/plans/save-plan-drills", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            updates,
            ...(isShootaround && planId ? { planId, playlistUrl } : {}),
          }),
        });
        const data = await res.json();
        if (data.success) {
          showStatus(`Saved ${updates.length} drill${updates.length !== 1 ? "s" : ""}.`, false);
        } else {
          showStatus(data.error ?? "Failed to save.", true);
        }
      } catch {
        showStatus("Network error.", true);
      } finally {
        saveAllBtn.disabled = false;
        saveAllBtn.textContent = "Save All Changes";
      }
    });
  }

  // ── Add drill ─────────────────────────────────────────────────────────────
  document.querySelectorAll(".add-drill-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const details = btn.closest("details");
      const drillId = details?.querySelector(".drill-picker")?.value;
      const duration = parseInt(details?.querySelector(".add-duration")?.value || "10", 10);
      const players = parseInt(details?.querySelector(".add-players")?.value || "0", 10);
      const section = btn.dataset.section;
      const ageGroup = btn.dataset.ageGroup || undefined;

      if (!drillId) { showStatus("Select a drill first.", true); return; }

      btn.disabled = true;
      btn.textContent = "Adding…";

      try {
        const res = await fetch("/api/admin/plans/add-drill", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            planId,
            drillId,
            section,
            ageGroup,
            durationMinutes: duration,
            playerCountAtStation: players > 0 ? players : undefined,
          }),
        });
        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else {
          showStatus(data.error ?? "Failed to add drill.", true);
        }
      } catch {
        showStatus("Network error.", true);
      } finally {
        btn.disabled = false;
        btn.textContent = "Add";
      }
    });
  });

  // ── Remove drill ──────────────────────────────────────────────────────────
  document.querySelectorAll(".remove-drill-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const planDrillId = btn.dataset.planDrillId;
      if (!planDrillId) return;

      btn.disabled = true;
      btn.textContent = "Removing…";

      try {
        const res = await fetch("/api/admin/plans/remove-drill", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ planDrillId }),
        });
        const data = await res.json();
        if (data.success) {
          btn.closest("tr")?.remove();
          showStatus("Drill removed.", false);
        } else {
          showStatus(data.error ?? "Failed to remove drill.", true);
          btn.disabled = false;
          btn.textContent = "Remove";
        }
      } catch {
        showStatus("Network error.", true);
        btn.disabled = false;
        btn.textContent = "Remove";
      }
    });
  });

  // ── Save as template ──────────────────────────────────────────────────────
  const saveTemplateBtn = document.getElementById("saveTemplateBtn");
  const templateNameInput = document.getElementById("templateName");

  if (saveTemplateBtn && templateNameInput) {
    saveTemplateBtn.addEventListener("click", async () => {
      const name = templateNameInput.value.trim();
      if (!name) { showStatus("Enter a template name.", true); return; }

      saveTemplateBtn.disabled = true;
      saveTemplateBtn.textContent = "Saving…";

      try {
        const res = await fetch("/api/admin/plans/save-as-template", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ planId, templateName: name }),
        });
        const data = await res.json();
        if (data.success) {
          showStatus(`Template "${name}" saved.`, false);
          templateNameInput.value = "";
        } else {
          showStatus(data.error ?? "Failed to save template.", true);
        }
      } catch {
        showStatus("Network error.", true);
      } finally {
        saveTemplateBtn.disabled = false;
        saveTemplateBtn.textContent = "Save Template";
      }
    });
  }
</script>
