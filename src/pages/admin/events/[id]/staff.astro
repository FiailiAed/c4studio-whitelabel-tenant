---
import AdminDashboardLayout from "@layouts/AdminDashboardLayout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../../../convex/_generated/api";
import type { Id } from "../../../../../convex/_generated/dataModel";

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/");

const { id } = Astro.params;
if (!id) return Astro.redirect("/admin/events");

const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);
const callerUser = await client.query(api.users.getUserByClerkId, { clerkId: userId });
if (!callerUser || callerUser.role !== "admin") return Astro.redirect("/");

const [event, allStaff, assignments, rsvps] = await Promise.all([
  client.query(api.events.getEvent, { id: id as Id<"events"> }),
  client.query(api.assignments.getAvailableStaffForEvent, { eventId: id as Id<"events"> }),
  client.query(api.assignments.getAssignmentsForEvent, { eventId: id as Id<"events"> }),
  client.query(api.eventRsvp.getRsvpsForEvent, { eventId: id as Id<"events"> }),
]);

if (!event) return Astro.redirect("/admin/events");

const rsvpMap = new Map<string, "confirmed" | "maybe" | "declined">();
for (const r of rsvps) rsvpMap.set(r.clerkId, r.status);

// Build assignment lookup: station+ageGroup -> assignment
type AssignmentKey = string;
const assignmentMap = new Map<AssignmentKey, typeof assignments[number]>();
for (const a of assignments) {
  const key = `${a.station}:${a.ageGroup ?? ""}`;
  assignmentMap.set(key, a);
}

function getAssignment(station: string, ageGroup?: string) {
  return assignmentMap.get(`${station}:${ageGroup ?? ""}`);
}

// Event-type-aware staff grid rows
type StaffRow = {
  station: string;
  ageGroup?: string;
  label: string;
  rowStyle: "shared" | "split" | "violet";
};

function getStaffRows(eventType: string, targetAgeGroup?: string): StaffRow[] {
  const shared: StaffRow[] = [
    { station: "stretch",  ageGroup: undefined, label: "Stretch — All",  rowStyle: "shared" },
    { station: "warmup",   ageGroup: undefined, label: "Warmup — All",   rowStyle: "shared" },
  ];

  if (["speed_series", "program_training", "practice"].includes(eventType)) {
    return [
      ...shared,
      { station: "offense",      ageGroup: undefined, label: "Offense — All",      rowStyle: "split" },
      { station: "ground_balls", ageGroup: undefined, label: "Ground Balls — All", rowStyle: "split" },
      { station: "defense",      ageGroup: undefined, label: "Defense — All",      rowStyle: "split" },
      { station: "3v3_combat",   ageGroup: undefined, label: "3v3 Combat — All",   rowStyle: "split" },
      { station: "u6_practice",  ageGroup: "U6",      label: "U6 Practice (Scoopers)", rowStyle: "violet" },
    ];
  }
  if (eventType === "individual_practice") {
    const ag = targetAgeGroup ?? "U12";
    return [
      ...shared,
      { station: "offense",      ageGroup: ag, label: `Offense — ${ag}`,      rowStyle: "split" },
      { station: "ground_balls", ageGroup: ag, label: `Ground Balls — ${ag}`, rowStyle: "split" },
      { station: "defense",      ageGroup: ag, label: `Defense — ${ag}`,      rowStyle: "split" },
      { station: "3v3_combat",   ageGroup: ag, label: `3v3 Combat — ${ag}`,   rowStyle: "split" },
    ];
  }
  if (eventType === "shootaround") {
    return [
      ...shared,
      { station: "offense",      ageGroup: undefined, label: "Offense — All",      rowStyle: "split" },
      { station: "ground_balls", ageGroup: undefined, label: "Ground Balls — All", rowStyle: "split" },
      { station: "defense",      ageGroup: undefined, label: "Defense — All",      rowStyle: "split" },
    ];
  }
  if (eventType === "team_practice") {
    return [
      ...shared,
      { station: "team_specific", ageGroup: "U6",  label: "Team — U6",  rowStyle: "split" },
      { station: "team_specific", ageGroup: "U8",  label: "Team — U8",  rowStyle: "split" },
      { station: "team_specific", ageGroup: "U12", label: "Team — U12", rowStyle: "split" },
      { station: "team_specific", ageGroup: "U14", label: "Team — U14", rowStyle: "split" },
    ];
  }
  if (["game", "scrimmage", "festival"].includes(eventType)) {
    return [
      { station: "offense", ageGroup: undefined, label: "Head Coach — All",       rowStyle: "shared" },
      { station: "defense", ageGroup: undefined, label: "Assistant Coach — All",  rowStyle: "shared" },
    ];
  }
  // fallback
  return getStaffRows("speed_series");
}

const staffRows = getStaffRows(event.type, event.targetAgeGroup ?? undefined);
---

<AdminDashboardLayout title={`Staff — ${event.title}`} currentTab="events" breadcrumbs={[{ name: "Events", href: "/admin/events" }, { name: event.title, href: `/admin/events/${id}` }, { name: "Staff", href: Astro.url.pathname }]}>

  <div class="mb-6 flex items-center justify-between">
    <a href={`/admin/events/${id}`} class="flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700">
      <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M11.78 5.22a.75.75 0 010 1.06L8.06 10l3.72 3.72a.75.75 0 11-1.06 1.06l-4.25-4.25a.75.75 0 010-1.06l4.25-4.25a.75.75 0 011.06 0Z" clip-rule="evenodd" />
      </svg>
      Back to Event
    </a>
    <div class="flex items-center gap-4">
      <label class="flex items-center gap-2 text-sm text-gray-600 cursor-pointer select-none">
        <input type="checkbox" id="showAllToggle" class="size-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" />
        Show all staff
      </label>
      <button
        id="saveAllAssignmentsBtn"
        type="button"
        class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500"
      >
        Save All Assignments
      </button>
    </div>
  </div>

  {allStaff.length === 0 && (
    <div class="mb-6 rounded-md bg-amber-50 border border-amber-200 p-4">
      <p class="text-sm text-amber-800">
        No approved staff found. Staff must complete onboarding (status: Done) before they can be assigned.
      </p>
    </div>
  )}

  <div id="saveStatus" class="hidden mb-4 rounded-md p-3 text-sm font-medium"></div>

  <div class="bg-white rounded-xl shadow-sm ring-1 ring-gray-900/5 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Station</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Age Group</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Assigned Staff</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">RSVP</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 bg-white">
        {staffRows.map((row) => {
          const existing = getAssignment(row.station, row.ageGroup);
          const rowBg = row.rowStyle === "violet" ? "bg-violet-50" : "";
          const labelClass = row.rowStyle === "violet" ? "text-violet-800" : "text-gray-900";
          const ageGroupDisplay = row.ageGroup ?? "All";
          const ageGroupClass = row.rowStyle === "violet" ? "text-violet-600" : "text-gray-500";

          return (
            <tr
              class={`assignment-row ${rowBg}`}
              data-station={row.station}
              data-age-group={row.ageGroup ?? ""}
            >
              <td class={`px-6 py-4 text-sm font-medium ${labelClass}`}>{row.label}</td>
              <td class={`px-6 py-4 text-sm ${ageGroupClass}`}>{ageGroupDisplay}</td>
              <td class="px-6 py-4">
                <select
                  class="staff-select block w-full rounded-md border border-gray-300 px-2 py-1.5 text-sm text-gray-900 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
                  data-station={row.station}
                  data-age-group={row.ageGroup ?? ""}
                >
                  <option value="">— Unassigned —</option>
                  {allStaff.map((s) => {
                    const matchesAge = row.ageGroup ? s.ageGroups.includes(row.ageGroup) : true;
                    const rsvpStatus = rsvpMap.get(s.clerkId);
                    const rsvpSuffix = rsvpStatus === "confirmed" ? " ✓"
                      : rsvpStatus === "maybe" ? " ?"
                      : rsvpStatus === "declined" ? " ✗"
                      : "";
                    return (
                      <option
                        value={s.clerkId}
                        selected={existing?.clerkId === s.clerkId}
                        data-age-groups={s.ageGroups.join(",")}
                        data-matches-age={matchesAge ? "true" : "false"}
                        data-rsvp-status={rsvpStatus ?? "none"}
                      >
                        {s.name || s.email}{(row.ageGroup && !matchesAge) ? " ◦" : ""}{rsvpSuffix}
                      </option>
                    );
                  })}
                </select>
              </td>
              <td class="px-6 py-4" data-rsvp-cell>
                {existing?.clerkId ? (() => {
                  const status = rsvpMap.get(existing.clerkId);
                  const badgeClass = status === "confirmed" ? "bg-green-100 text-green-700"
                    : status === "maybe" ? "bg-yellow-100 text-yellow-700"
                    : status === "declined" ? "bg-red-100 text-red-700"
                    : "bg-gray-100 text-gray-500";
                  const badgeLabel = status === "confirmed" ? "Going"
                    : status === "maybe" ? "Maybe"
                    : status === "declined" ? "Can't Go"
                    : "No Response";
                  return (
                    <span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ${badgeClass}`}>
                      {badgeLabel}
                    </span>
                  );
                })() : <span class="text-gray-400 text-sm">—</span>}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <div class="mt-4 flex items-center justify-between">
    <p class="text-xs text-gray-400">◦ = staff did not list this age group during onboarding</p>
    <button
      type="button"
      class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500"
      onclick="document.getElementById('saveAllAssignmentsBtn').click()"
    >
      Save All Assignments
    </button>
  </div>

</AdminDashboardLayout>

<script is:inline define:vars={{ eventId: id }}>
  const statusEl = document.getElementById("saveStatus");

  function showStatus(msg, isError) {
    if (!statusEl) return;
    statusEl.textContent = msg;
    statusEl.className = `mb-4 rounded-md p-3 text-sm font-medium ${isError ? "bg-red-50 text-red-700" : "bg-green-50 text-green-700"}`;
    statusEl.classList.remove("hidden");
    setTimeout(() => statusEl.classList.add("hidden"), 3000);
  }

  // "Show all staff" toggle
  const toggle = document.getElementById("showAllToggle");
  function applyFilter() {
    const showAll = toggle.checked;
    document.querySelectorAll("select.staff-select").forEach((sel) => {
      const ageGroup = sel.dataset.ageGroup;
      if (!ageGroup) return; // shared sections — always show all
      sel.querySelectorAll("option").forEach((opt) => {
        if (!opt.value) return; // keep "Unassigned"
        const matches = opt.dataset.matchesAge === "true";
        opt.hidden = !showAll && !matches;
      });
    });
  }
  toggle.addEventListener("change", applyFilter);
  applyFilter();

  // Live-update RSVP column when dropdown changes
  const RSVP_BADGE = {
    confirmed: { label: "Going",       cls: "bg-green-100 text-green-700" },
    maybe:     { label: "Maybe",       cls: "bg-yellow-100 text-yellow-700" },
    declined:  { label: "Can't Go",    cls: "bg-red-100 text-red-700" },
    none:      { label: "No Response", cls: "bg-gray-100 text-gray-500" },
  };

  document.querySelectorAll("select.staff-select").forEach((sel) => {
    sel.addEventListener("change", () => {
      const row = sel.closest("tr");
      if (!row) return;
      const cell = row.querySelector("[data-rsvp-cell]");
      if (!cell) return;
      const selectedOpt = sel.options[sel.selectedIndex];
      if (!selectedOpt || !selectedOpt.value) {
        cell.innerHTML = '<span class="text-gray-400 text-sm">—</span>';
        return;
      }
      const rsvpStatus = selectedOpt.dataset.rsvpStatus ?? "none";
      const badge = RSVP_BADGE[rsvpStatus] ?? RSVP_BADGE.none;
      cell.innerHTML = `<span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ${badge.cls}">${badge.label}</span>`;
    });
  });

  // Bulk Save All Assignments
  const saveAllBtn = document.getElementById("saveAllAssignmentsBtn");
  if (saveAllBtn) {
    saveAllBtn.addEventListener("click", async () => {
      const assignments = [];
      document.querySelectorAll(".assignment-row").forEach((row) => {
        const station = row.dataset.station;
        const ageGroup = row.dataset.ageGroup || undefined;
        const select = row.querySelector("select.staff-select");
        const clerkId = select?.value ?? "";
        if (station) {
          assignments.push({ station, ageGroup: ageGroup || undefined, clerkId });
        }
      });

      saveAllBtn.disabled = true;
      saveAllBtn.textContent = "Saving…";

      try {
        const res = await fetch("/api/admin/assignments/upsert-batch", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ eventId, assignments }),
        });
        const data = await res.json();
        if (data.success) {
          showStatus("All assignments saved.", false);
        } else {
          showStatus(data.error ?? "Save failed.", true);
        }
      } catch {
        showStatus("Network error.", true);
      } finally {
        saveAllBtn.disabled = false;
        saveAllBtn.textContent = "Save All Assignments";
      }
    });
  }
</script>
