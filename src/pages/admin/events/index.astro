---
import AdminDashboardLayout from "@layouts/AdminDashboardLayout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../../convex/_generated/api";

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/");

const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);
const callerUser = await client.query(api.users.getUserByClerkId, { clerkId: userId });
if (!callerUser || callerUser.role !== "admin") return Astro.redirect("/");

const allEvents = await client.query(api.events.listEvents, {});

// Determine which month to display (default: current month based on today's date)
const monthParam = Astro.url.searchParams.get("month"); // format: "YYYY-MM"
const today = new Date();
let viewYear = today.getFullYear();
let viewMonth = today.getMonth(); // 0-indexed

if (monthParam && /^\d{4}-\d{2}$/.test(monthParam)) {
  const [y, m] = monthParam.split("-").map(Number);
  if (y && m >= 1 && m <= 12) {
    viewYear = y;
    viewMonth = m - 1; // convert to 0-indexed
  }
}

// Prev/next month URLs
const prevDate = new Date(viewYear, viewMonth - 1, 1);
const nextDate = new Date(viewYear, viewMonth + 1, 1);
const prevParam = `${prevDate.getFullYear()}-${String(prevDate.getMonth() + 1).padStart(2, "0")}`;
const nextParam = `${nextDate.getFullYear()}-${String(nextDate.getMonth() + 1).padStart(2, "0")}`;
const monthLabel = new Date(viewYear, viewMonth, 1).toLocaleDateString("en-US", {
  month: "long",
  year: "numeric",
});

// Build calendar grid
const firstDay = new Date(viewYear, viewMonth, 1);
const lastDay = new Date(viewYear, viewMonth + 1, 0);
const daysInMonth = lastDay.getDate();
// Monday-first calendar: Sunday = 6, Monday = 0
const startDow = (firstDay.getDay() + 6) % 7; // days to pad before day 1

// Build set of event days (YYYY-MM-DD strings) for this month
const eventDaySet = new Set<string>();
for (const ev of allEvents) {
  const d = new Date(ev.date);
  if (d.getFullYear() === viewYear && d.getMonth() === viewMonth) {
    eventDaySet.add(String(d.getDate()));
  }
}

// Filter upcoming events (sorted, soonest first) — show all events, not just this month
function formatDate(ts: number): string {
  return new Date(ts).toLocaleDateString("en-US", {
    weekday: "short", month: "short", day: "numeric", year: "numeric",
  });
}
function formatTime(ts: number): string {
  return new Date(ts).toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
}

const TYPE_LABELS: Record<string, string> = {
  practice: "Program Training",
  program_training: "Program Training",
  individual_practice: "Individual Practice",
  game: "Game",
  other: "Other",
  speed_series: "Speed Series",
  shootaround: "Shootaround",
  team_practice: "Team Practice",
  scrimmage: "Scrimmage",
  festival: "Festival",
};
const TYPE_COLORS: Record<string, string> = {
  practice: "bg-indigo-100 text-indigo-700",
  program_training: "bg-indigo-100 text-indigo-700",
  individual_practice: "bg-purple-100 text-purple-700",
  game: "bg-emerald-100 text-emerald-700",
  other: "bg-gray-100 text-gray-600",
  speed_series: "bg-orange-100 text-orange-700",
  shootaround: "bg-sky-100 text-sky-700",
  team_practice: "bg-blue-100 text-blue-700",
  scrimmage: "bg-teal-100 text-teal-700",
  festival: "bg-green-100 text-green-700",
};

// Calendar grid cells: pad with previous/next month days
type CalCell = { day: number; isCurrentMonth: boolean; hasEvent: boolean };
const cells: CalCell[] = [];
const prevMonthLastDay = new Date(viewYear, viewMonth, 0).getDate();
for (let i = startDow - 1; i >= 0; i--) {
  cells.push({ day: prevMonthLastDay - i, isCurrentMonth: false, hasEvent: false });
}
for (let d = 1; d <= daysInMonth; d++) {
  cells.push({ day: d, isCurrentMonth: true, hasEvent: eventDaySet.has(String(d)) });
}
const remainder = cells.length % 7;
if (remainder !== 0) {
  for (let d = 1; d <= 7 - remainder; d++) {
    cells.push({ day: d, isCurrentMonth: false, hasEvent: false });
  }
}

const todayDay = today.getFullYear() === viewYear && today.getMonth() === viewMonth
  ? today.getDate()
  : -1;
---

<AdminDashboardLayout title="Events" currentTab="events" breadcrumbs={[{ name: "Events", href: "/admin/events" }]}>

  <div class="mb-6 flex items-center justify-between">
    <p class="text-sm text-gray-500">Manage practices, games, and scheduling.</p>
    <a
      href="/admin/events/new"
      class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
    >
      + Add Event
    </a>
  </div>

  <div class="lg:grid lg:grid-cols-[1fr_300px] lg:gap-10">

    <!-- LEFT: Event List -->
    <div>
      {allEvents.length === 0 ? (
        <div class="rounded-xl bg-white p-8 text-center shadow-sm ring-1 ring-gray-900/5">
          <p class="text-sm text-gray-500">No events yet. <a href="/admin/events/new" class="text-indigo-600 hover:underline">Create the first one.</a></p>
        </div>
      ) : (
        <div class="space-y-3">
          {allEvents.map((ev) => (
            <a
              href={`/admin/events/${ev._id}`}
              class="flex items-center justify-between rounded-xl bg-white px-5 py-4 shadow-sm ring-1 ring-gray-900/5 hover:ring-indigo-300 transition group"
            >
              <div class="flex items-center gap-x-4">
                <!-- Type icon badge -->
                <div class={`h-11 w-11 rounded-full flex items-center justify-center shrink-0 text-xs font-bold ${TYPE_COLORS[ev.type] ?? "bg-gray-100 text-gray-600"}`}>
                  {ev.type === "game" ? "G" : ev.type === "individual_practice" ? "IP" : "PT"}
                </div>

                <div class="min-w-0">
                  <p class="text-sm font-semibold text-gray-900 group-hover:text-indigo-600 truncate">{ev.title}</p>
                  <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500">
                    <!-- Date -->
                    <span class="flex items-center gap-1">
                      <svg class="size-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                      </svg>
                      {formatDate(ev.date)} at {formatTime(ev.date)}
                    </span>
                    {ev.location && (
                      <span class="flex items-center gap-1">
                        <svg class="size-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                        </svg>
                        {ev.location}
                      </span>
                    )}
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-2 ml-3 shrink-0">
                <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ${TYPE_COLORS[ev.type] ?? "bg-gray-100 text-gray-600"}`}>
                  {TYPE_LABELS[ev.type] ?? ev.type}
                </span>
                {ev.published ? (
                  <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">Published</span>
                ) : (
                  <span class="inline-flex items-center rounded-full bg-yellow-100 px-2 py-0.5 text-xs font-medium text-yellow-700">Draft</span>
                )}
              </div>
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- RIGHT: Mini Calendar -->
    <div class="mt-10 lg:mt-0">
      <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">

        <!-- Month nav -->
        <div class="flex items-center justify-between mb-4">
          <a
            href={`/admin/events?month=${prevParam}`}
            class="-m-1.5 flex items-center justify-center p-1.5 text-gray-400 hover:text-gray-600"
          >
            <span class="sr-only">Previous month</span>
            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
            </svg>
          </a>
          <h2 class="text-sm font-semibold text-gray-900">{monthLabel}</h2>
          <a
            href={`/admin/events?month=${nextParam}`}
            class="-m-1.5 flex items-center justify-center p-1.5 text-gray-400 hover:text-gray-600"
          >
            <span class="sr-only">Next month</span>
            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>

        <!-- Day-of-week headers (Monday first) -->
        <div class="grid grid-cols-7 text-center text-xs font-medium text-gray-400 mb-1">
          {"MTWTFSS".split("").map((d) => <div>{d}</div>)}
        </div>

        <!-- Calendar cells -->
        <div class="grid grid-cols-7 gap-px text-center text-sm">
          {cells.map((cell) => {
            const isToday = cell.isCurrentMonth && cell.day === todayDay;
            const base = "w-8 h-8 mx-auto flex items-center justify-center rounded-full text-xs";
            let cls = base;
            if (!cell.isCurrentMonth) {
              cls += " text-gray-300";
            } else if (isToday) {
              cls += " bg-indigo-600 text-white font-bold";
            } else if (cell.hasEvent) {
              cls += " bg-indigo-100 text-indigo-700 font-semibold";
            } else {
              cls += " text-gray-700 hover:bg-gray-100";
            }
            return (
              <div class="py-0.5">
                <div class={cls}>{cell.day}</div>
                {cell.hasEvent && cell.isCurrentMonth && (
                  <div class="mt-0.5 flex justify-center">
                    <div class="h-1 w-1 rounded-full bg-indigo-400"></div>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>

      <a
        href="/admin/events/new"
        class="mt-4 block w-full rounded-md bg-indigo-600 px-3 py-2.5 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition"
      >
        + Add Event
      </a>

      <div class="mt-4 space-y-1">
        <a href="/admin/drills" class="block text-center text-sm text-indigo-600 hover:underline">Drill Library</a>
        <a href="/admin/plans/templates" class="block text-center text-sm text-indigo-600 hover:underline">Plan Templates</a>
      </div>
    </div>
  </div>

</AdminDashboardLayout>
