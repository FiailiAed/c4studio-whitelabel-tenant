---
import AdminDashboardLayout from "@layouts/AdminDashboardLayout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../../convex/_generated/api";

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/");

const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);

const callerUser = await client.query(api.users.getUserByClerkId, { clerkId: userId });
if (!callerUser || callerUser.role !== "admin") {
  return Astro.redirect("/");
}

let formError: string | null = null;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  const title = (formData.get("title") as string | null)?.trim() ?? "";
  const content = (formData.get("content") as string | null)?.trim() ?? "";
  const isActive = formData.get("isActive") === "on";
  const fileUrl = (formData.get("fileUrl") as string | null)?.trim() || undefined;
  const fileName = (formData.get("fileName") as string | null)?.trim() || undefined;

  if (!title) {
    formError = "Title is required.";
  } else if (!content) {
    formError = "Content is required.";
  } else {
    const newId = await client.mutation(api.documents.createDocument, {
      title,
      content,
      isActive,
      fileUrl,
      fileName,
    });
    return Astro.redirect(`/admin/documents/${newId}`);
  }
}
---

<AdminDashboardLayout title="New Document" currentTab="documents" breadcrumbs={[{ name: "Documents", href: "/admin/documents" }, { name: "New Document", href: "/admin/documents/new" }]}>

  <div class="mb-6">
    <a href="/admin/documents" class="text-sm text-gray-500 hover:text-gray-700">&larr; Back to Documents</a>
  </div>

  {formError && (
    <div class="mb-6 rounded-md bg-red-50 p-4">
      <p class="text-sm text-red-700">{formError}</p>
    </div>
  )}

  <div class="bg-white shadow-sm rounded-xl ring-1 ring-gray-900/5 px-6 py-8 sm:px-8">
    <form id="newDocForm" method="POST" class="space-y-6">

      <!-- Title -->
      <div>
        <label for="title" class="block text-sm font-medium text-gray-900">Title <span class="text-red-500">*</span></label>
        <input
          type="text"
          id="title"
          name="title"
          required
          class="mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
          placeholder="e.g. Code of Conduct"
        />
      </div>

      <!-- Content -->
      <div>
        <label for="content" class="block text-sm font-medium text-gray-900">Content <span class="text-red-500">*</span></label>
        <p class="mt-1 text-xs text-gray-500">This text is what staff will read and acknowledge during onboarding.</p>
        <textarea
          id="content"
          name="content"
          rows="12"
          required
          class="mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 font-mono"
          placeholder="Enter document content (markdown supported)..."
        ></textarea>
      </div>

      <!-- Active toggle -->
      <div class="flex items-center gap-3">
        <input
          type="checkbox"
          id="isActive"
          name="isActive"
          checked
          class="size-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
        />
        <label for="isActive" class="text-sm font-medium text-gray-900">Active — visible to staff during onboarding</label>
      </div>

      <!-- File attachment (optional) -->
      <div>
        <p class="text-sm font-medium text-gray-900">PDF Attachment <span class="text-gray-400 font-normal">(optional)</span></p>
        <p class="mt-1 text-xs text-gray-500">A downloadable reference file for staff. PDF or image, max 8 MB.</p>

        <input type="hidden" id="fileUrl" name="fileUrl" />
        <input type="hidden" id="fileName" name="fileName" />

        <div id="docFileList" class="mt-3 space-y-2 text-sm text-gray-700"></div>

        <div
          id="docUploadArea"
          class="mt-4 flex flex-col items-center justify-center rounded-lg border-2 border-dashed border-gray-300 px-6 py-8 text-center cursor-pointer hover:border-indigo-400 hover:bg-indigo-50 transition-colors"
        >
          <svg class="mx-auto size-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
          </svg>
          <p class="mt-2 text-sm text-gray-600">
            <span id="docUploadLabel" class="font-semibold text-indigo-600">Click to upload</span> or drag and drop
          </p>
          <p class="text-xs text-gray-500 mt-1">PDF, PNG, JPG up to 8 MB</p>
          <input id="docFileInput" type="file" accept=".pdf,image/*" class="hidden" />
          <button
            id="docUploadBtn"
            type="button"
            class="mt-3 hidden rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 disabled:opacity-60"
          >
            Upload file
          </button>
        </div>
        <p id="docUploadStatus" class="mt-2 text-sm text-gray-500 hidden"></p>
      </div>

      <!-- Actions -->
      <div class="flex items-center justify-between pt-2 border-t border-gray-100">
        <a href="/admin/documents" class="text-sm text-gray-500 hover:text-gray-700">Cancel</a>
        <button
          type="submit"
          id="submitBtn"
          class="rounded-md bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
        >
          Create Document
        </button>
      </div>

    </form>
  </div>

</AdminDashboardLayout>

<script>
  import { genUploader } from "uploadthing/client";

  type UploadedFile = { ufsUrl: string; name: string };

  const { uploadFiles } = genUploader({ url: "/api/uploadthing", package: "custom" });

  const uploadArea = document.getElementById("docUploadArea") as HTMLElement;
  const fileInput = document.getElementById("docFileInput") as HTMLInputElement;
  const uploadBtn = document.getElementById("docUploadBtn") as HTMLButtonElement;
  const uploadLabel = document.getElementById("docUploadLabel") as HTMLElement;
  const uploadStatus = document.getElementById("docUploadStatus") as HTMLElement;
  const fileUrlInput = document.getElementById("fileUrl") as HTMLInputElement;
  const fileNameInput = document.getElementById("fileName") as HTMLInputElement;
  const fileList = document.getElementById("docFileList") as HTMLElement;

  uploadArea.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).id !== "docUploadBtn") {
      fileInput.click();
    }
  });

  uploadArea.addEventListener("dragover", (e) => {
    e.preventDefault();
    uploadArea.classList.add("border-indigo-500", "bg-indigo-50");
  });
  uploadArea.addEventListener("dragleave", () => {
    uploadArea.classList.remove("border-indigo-500", "bg-indigo-50");
  });
  uploadArea.addEventListener("drop", (e) => {
    e.preventDefault();
    uploadArea.classList.remove("border-indigo-500", "bg-indigo-50");
    if (e.dataTransfer?.files.length) {
      fileInput.files = e.dataTransfer.files;
      handleFileSelection();
    }
  });

  fileInput.addEventListener("change", handleFileSelection);

  function handleFileSelection() {
    const files = fileInput.files;
    if (!files || files.length === 0) return;
    uploadBtn.classList.remove("hidden");
    uploadLabel.textContent = `${files[0]!.name} selected`;
  }

  uploadBtn.addEventListener("click", async () => {
    const files = fileInput.files;
    if (!files || files.length === 0) return;

    uploadBtn.disabled = true;
    uploadBtn.textContent = "Uploading…";
    uploadStatus.textContent = "Uploading file, please wait…";
    uploadStatus.classList.remove("hidden");
    uploadStatus.className = "mt-2 text-sm text-gray-500";

    try {
      const result = await uploadFiles("documentUploader", {
        files: [files[0]!],
      }) as UploadedFile[];

      const uploaded = result[0];
      if (uploaded) {
        fileUrlInput.value = uploaded.ufsUrl;
        fileNameInput.value = uploaded.name;

        fileList.innerHTML = `<div class="flex items-center gap-2 text-green-700 text-sm">
          <svg class="size-4 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/></svg>
          <span>${uploaded.name}</span>
        </div>`;

        uploadStatus.textContent = "File uploaded successfully.";
        uploadStatus.className = "mt-2 text-sm text-green-600";
        uploadArea.classList.add("hidden");
      }
    } catch (err) {
      uploadStatus.textContent = err instanceof Error ? err.message : "Upload failed. Please try again.";
      uploadStatus.className = "mt-2 text-sm text-red-600";
      uploadBtn.disabled = false;
      uploadBtn.textContent = "Retry upload";
    }
  });
</script>
