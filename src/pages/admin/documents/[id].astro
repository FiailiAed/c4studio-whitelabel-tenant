---
import AdminDashboardLayout from "@layouts/AdminDashboardLayout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../../convex/_generated/api";
import type { Id } from "../../../../convex/_generated/dataModel";

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/");

const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);

const callerUser = await client.query(api.users.getUserByClerkId, { clerkId: userId });
if (!callerUser || callerUser.role !== "admin") {
  return Astro.redirect("/");
}

const { id } = Astro.params;
if (!id) return Astro.redirect("/admin/documents");

let formError: string | null = null;
let showEdit = Astro.url.searchParams.get("edit") === "1";

// Handle POST actions
if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = formData.get("_action") as string | null;

  if (action === "edit") {
    const title = (formData.get("title") as string | null)?.trim() ?? "";
    const content = (formData.get("content") as string | null)?.trim() ?? "";
    const isActive = formData.get("isActive") === "on";
    const fileUrl = (formData.get("fileUrl") as string | null)?.trim() || undefined;
    const fileName = (formData.get("fileName") as string | null)?.trim() || undefined;

    if (!title) {
      formError = "Title is required.";
      showEdit = true;
    } else if (!content) {
      formError = "Content is required.";
      showEdit = true;
    } else {
      await client.mutation(api.documents.updateDocument, {
        id: id as Id<"documents">,
        title,
        content,
        isActive,
        fileUrl,
        fileName,
      });
      return Astro.redirect(`/admin/documents/${id}`);
    }
  }
}

const [doc, ackCounts, allUsers] = await Promise.all([
  client.query(api.documents.getDocument, { id: id as Id<"documents"> }),
  client.query(api.documents.getAcknowledgmentCounts, {}),
  client.query(api.users.listUsers, {}),
]);

if (!doc) return Astro.redirect("/admin/documents");

const totalStaff = allUsers.filter((u) => u.role !== "admin").length;
const ackCount = ackCounts[doc._id] ?? 0;

const lastUpdated = new Date(doc.updatedAt).toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});
const createdOn = new Date(doc.createdAt).toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});
---

<AdminDashboardLayout title={doc.title} currentTab="documents" breadcrumbs={[{ name: "Documents", href: "/admin/documents" }, { name: doc.title || "Document", href: Astro.url.pathname }]}>

  <div class="mb-6 flex items-center justify-between">
    <a href="/admin/documents" class="text-sm text-gray-500 hover:text-gray-700">&larr; Back to Documents</a>
    {!showEdit && (
      <a
        href={`/admin/documents/${id}?edit=1`}
        class="inline-flex items-center gap-2 rounded-md bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50"
      >
        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
        </svg>
        Edit
      </a>
    )}
  </div>

  {formError && (
    <div class="mb-6 rounded-md bg-red-50 p-4">
      <p class="text-sm text-red-700">{formError}</p>
    </div>
  )}

  {showEdit ? (
    <!-- Edit Form -->
    <div class="bg-white shadow-sm rounded-xl ring-1 ring-gray-900/5 px-6 py-8 sm:px-8">
      <h2 class="text-base font-semibold text-gray-900 mb-6">Edit Document</h2>
      <form id="editDocForm" method="POST" class="space-y-6">
        <input type="hidden" name="_action" value="edit" />

        <!-- Title -->
        <div>
          <label for="title" class="block text-sm font-medium text-gray-900">Title <span class="text-red-500">*</span></label>
          <input
            type="text"
            id="title"
            name="title"
            required
            value={doc.title}
            class="mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
          />
        </div>

        <!-- Content -->
        <div>
          <label for="content" class="block text-sm font-medium text-gray-900">Content <span class="text-red-500">*</span></label>
          <p class="mt-1 text-xs text-gray-500">Saving will increment the version number.</p>
          <textarea
            id="content"
            name="content"
            rows="14"
            required
            class="mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 font-mono"
          >{doc.content}</textarea>
        </div>

        <!-- Active toggle -->
        <div class="flex items-center gap-3">
          <input
            type="checkbox"
            id="isActive"
            name="isActive"
            checked={doc.isActive}
            class="size-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
          />
          <label for="isActive" class="text-sm font-medium text-gray-900">Active — visible to staff during onboarding</label>
        </div>

        <!-- File attachment -->
        <div>
          <p class="text-sm font-medium text-gray-900">PDF Attachment <span class="text-gray-400 font-normal">(optional)</span></p>
          <p class="mt-1 text-xs text-gray-500">Upload a new file to replace the existing attachment. PDF or image, max 8 MB.</p>

          <input type="hidden" id="fileUrl" name="fileUrl" value={doc.fileUrl ?? ""} />
          <input type="hidden" id="fileName" name="fileName" value={doc.fileName ?? ""} />

          {doc.fileUrl && (
            <div id="docFileList" class="mt-3">
              <div class="flex items-center gap-2 text-sm text-gray-700">
                <svg class="size-4 shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M15.621 4.379a3 3 0 0 0-4.242 0l-7 7a3 3 0 0 0 4.241 4.243h.001l.497-.5a.75.75 0 0 1 1.064 1.057l-.498.501-.002.002a4.5 4.5 0 0 1-6.364-6.364l7-7a4.5 4.5 0 0 1 6.368 6.36l-3.455 3.553A2.625 2.625 0 1 1 9.52 9.52l3.45-3.451a.75.75 0 1 1 1.061 1.06l-3.45 3.451a1.125 1.125 0 0 0 1.587 1.595l3.454-3.553a3 3 0 0 0 0-4.242Z" clip-rule="evenodd" fill-rule="evenodd" />
                </svg>
                <span class="text-gray-600">Current: {doc.fileName}</span>
              </div>
            </div>
          )}
          {!doc.fileUrl && (
            <div id="docFileList" class="mt-3"></div>
          )}

          <div
            id="docUploadArea"
            class="mt-4 flex flex-col items-center justify-center rounded-lg border-2 border-dashed border-gray-300 px-6 py-8 text-center cursor-pointer hover:border-indigo-400 hover:bg-indigo-50 transition-colors"
          >
            <svg class="mx-auto size-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
            </svg>
            <p class="mt-2 text-sm text-gray-600">
              <span id="docUploadLabel" class="font-semibold text-indigo-600">{doc.fileUrl ? "Replace file" : "Click to upload"}</span>
            </p>
            <p class="text-xs text-gray-500 mt-1">PDF, PNG, JPG up to 8 MB</p>
            <input id="docFileInput" type="file" accept=".pdf,image/*" class="hidden" />
            <button
              id="docUploadBtn"
              type="button"
              class="mt-3 hidden rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 disabled:opacity-60"
            >
              Upload file
            </button>
          </div>
          <p id="docUploadStatus" class="mt-2 text-sm text-gray-500 hidden"></p>
        </div>

        <!-- Actions -->
        <div class="flex items-center justify-between pt-2 border-t border-gray-100">
          <a href={`/admin/documents/${id}`} class="text-sm text-gray-500 hover:text-gray-700">Cancel</a>
          <button
            type="submit"
            class="rounded-md bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
          >
            Save Changes
          </button>
        </div>
      </form>
    </div>
  ) : (
    <!-- Detail View (description-list pattern) -->
    <div class="bg-white shadow-sm rounded-xl ring-1 ring-gray-900/5">
      <div class="px-6 py-6 sm:px-8">
        <div class="flex items-start justify-between">
          <div>
            <h3 class="text-base/7 font-semibold text-gray-900">{doc.title}</h3>
            <p class="mt-1 max-w-2xl text-sm/6 text-gray-500">Policy document details and acknowledgment coverage.</p>
          </div>
          <span class={`inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset ${doc.isActive ? "bg-green-400/10 text-green-600 ring-green-500/20" : "bg-gray-400/10 text-gray-500 ring-gray-400/20"}`}>
            {doc.isActive ? "Active" : "Inactive"}
          </span>
        </div>
      </div>

      <div class="border-t border-gray-100">
        <dl class="divide-y divide-gray-100">

          <div class="px-6 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-8">
            <dt class="text-sm/6 font-medium text-gray-900">Version</dt>
            <dd class="mt-1 text-sm/6 text-gray-700 sm:col-span-2 sm:mt-0">v{doc.version}</dd>
          </div>

          <div class="px-6 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-8">
            <dt class="text-sm/6 font-medium text-gray-900">Created</dt>
            <dd class="mt-1 text-sm/6 text-gray-700 sm:col-span-2 sm:mt-0">{createdOn}</dd>
          </div>

          <div class="px-6 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-8">
            <dt class="text-sm/6 font-medium text-gray-900">Last updated</dt>
            <dd class="mt-1 text-sm/6 text-gray-700 sm:col-span-2 sm:mt-0">{lastUpdated}</dd>
          </div>

          <div class="px-6 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-8">
            <dt class="text-sm/6 font-medium text-gray-900">Acknowledged by</dt>
            <dd class="mt-1 text-sm/6 sm:col-span-2 sm:mt-0">
              <span class={`font-semibold ${ackCount === totalStaff && totalStaff > 0 ? "text-green-600" : "text-gray-700"}`}>
                {ackCount} / {totalStaff} staff
              </span>
              {totalStaff > 0 && (
                <span class="ml-2 text-xs text-gray-400">
                  ({Math.round((ackCount / totalStaff) * 100)}%)
                </span>
              )}
            </dd>
          </div>

          <div class="px-6 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-8">
            <dt class="text-sm/6 font-medium text-gray-900">Content</dt>
            <dd class="mt-1 sm:col-span-2 sm:mt-0">
              <pre class="whitespace-pre-wrap text-sm/6 text-gray-700 font-sans">{doc.content}</pre>
            </dd>
          </div>

          {doc.fileUrl && (
            <div class="px-6 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-8">
              <dt class="text-sm/6 font-medium text-gray-900">Attachment</dt>
              <dd class="mt-2 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
                <ul role="list" class="divide-y divide-gray-100 rounded-md border border-gray-200">
                  <li class="flex items-center justify-between py-4 pr-5 pl-4 text-sm/6">
                    <div class="flex w-0 flex-1 items-center">
                      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5 shrink-0 text-gray-400">
                        <path d="M15.621 4.379a3 3 0 0 0-4.242 0l-7 7a3 3 0 0 0 4.241 4.243h.001l.497-.5a.75.75 0 0 1 1.064 1.057l-.498.501-.002.002a4.5 4.5 0 0 1-6.364-6.364l7-7a4.5 4.5 0 0 1 6.368 6.36l-3.455 3.553A2.625 2.625 0 1 1 9.52 9.52l3.45-3.451a.75.75 0 1 1 1.061 1.06l-3.45 3.451a1.125 1.125 0 0 0 1.587 1.595l3.454-3.553a3 3 0 0 0 0-4.242Z" clip-rule="evenodd" fill-rule="evenodd" />
                      </svg>
                      <div class="ml-4 flex min-w-0 flex-1 gap-2">
                        <span class="truncate font-medium text-gray-900">{doc.fileName ?? "Attachment"}</span>
                      </div>
                    </div>
                    <div class="ml-4 shrink-0">
                      <a href={doc.fileUrl} target="_blank" rel="noopener noreferrer" class="font-medium text-indigo-600 hover:text-indigo-500">
                        Download
                      </a>
                    </div>
                  </li>
                </ul>
              </dd>
            </div>
          )}

        </dl>
      </div>

      <!-- Actions footer -->
      <div class="border-t border-gray-100 px-6 py-4 sm:px-8 flex items-center justify-between gap-4 flex-wrap">

        <!-- Toggle active -->
        <form method="POST" action="/api/admin/documents/toggle-active">
          <input type="hidden" name="documentId" value={doc._id} />
          <input type="hidden" name="isActive" value={String(doc.isActive)} />
          <button
            type="submit"
            class={`rounded-md px-4 py-2 text-sm font-semibold shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 ${
              doc.isActive
                ? "bg-yellow-50 text-yellow-700 ring-1 ring-inset ring-yellow-300 hover:bg-yellow-100"
                : "bg-green-50 text-green-700 ring-1 ring-inset ring-green-300 hover:bg-green-100"
            }`}
          >
            {doc.isActive ? "Deactivate" : "Activate"}
          </button>
        </form>

        <!-- Hard delete — only shown when inactive -->
        {!doc.isActive && (
          <form
            method="POST"
            action="/api/admin/documents/delete"
            onsubmit="return confirm('Permanently delete this document? This cannot be undone.')"
          >
            <input type="hidden" name="documentId" value={doc._id} />
            <button
              type="submit"
              class="rounded-md bg-red-50 px-4 py-2 text-sm font-semibold text-red-700 ring-1 ring-inset ring-red-300 hover:bg-red-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600"
            >
              Permanently Delete
            </button>
          </form>
        )}

      </div>
    </div>
  )}

</AdminDashboardLayout>

<script>
  import { genUploader } from "uploadthing/client";

  type UploadedFile = { ufsUrl: string; name: string };

  const uploadArea = document.getElementById("docUploadArea");
  if (uploadArea) {
    const { uploadFiles } = genUploader({ url: "/api/uploadthing", package: "custom" });

    const fileInput = document.getElementById("docFileInput") as HTMLInputElement;
    const uploadBtn = document.getElementById("docUploadBtn") as HTMLButtonElement;
    const uploadLabel = document.getElementById("docUploadLabel") as HTMLElement;
    const uploadStatus = document.getElementById("docUploadStatus") as HTMLElement;
    const fileUrlInput = document.getElementById("fileUrl") as HTMLInputElement;
    const fileNameInput = document.getElementById("fileName") as HTMLInputElement;
    const fileList = document.getElementById("docFileList") as HTMLElement;

    uploadArea.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).id !== "docUploadBtn") {
        fileInput.click();
      }
    });

    uploadArea.addEventListener("dragover", (e) => {
      e.preventDefault();
      uploadArea.classList.add("border-indigo-500", "bg-indigo-50");
    });
    uploadArea.addEventListener("dragleave", () => {
      uploadArea.classList.remove("border-indigo-500", "bg-indigo-50");
    });
    uploadArea.addEventListener("drop", (e) => {
      e.preventDefault();
      uploadArea.classList.remove("border-indigo-500", "bg-indigo-50");
      if ((e as DragEvent).dataTransfer?.files.length) {
        fileInput.files = (e as DragEvent).dataTransfer!.files;
        handleFileSelection();
      }
    });

    fileInput.addEventListener("change", handleFileSelection);

    function handleFileSelection() {
      const files = fileInput.files;
      if (!files || files.length === 0) return;
      uploadBtn.classList.remove("hidden");
      uploadLabel.textContent = `${files[0]!.name} selected`;
    }

    uploadBtn.addEventListener("click", async () => {
      const files = fileInput.files;
      if (!files || files.length === 0) return;

      uploadBtn.disabled = true;
      uploadBtn.textContent = "Uploading…";
      uploadStatus.textContent = "Uploading file, please wait…";
      uploadStatus.classList.remove("hidden");
      uploadStatus.className = "mt-2 text-sm text-gray-500";

      try {
        const result = await uploadFiles("documentUploader", {
          files: [files[0]!],
        }) as UploadedFile[];

        const uploaded = result[0];
        if (uploaded) {
          fileUrlInput.value = uploaded.ufsUrl;
          fileNameInput.value = uploaded.name;

          if (fileList) {
            fileList.innerHTML = `<div class="flex items-center gap-2 text-green-700 text-sm">
              <svg class="size-4 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/></svg>
              <span>${uploaded.name}</span>
            </div>`;
          }

          uploadStatus.textContent = "File uploaded successfully.";
          uploadStatus.className = "mt-2 text-sm text-green-600";
          uploadArea.classList.add("hidden");
        }
      } catch (err) {
        uploadStatus.textContent = err instanceof Error ? err.message : "Upload failed. Please try again.";
        uploadStatus.className = "mt-2 text-sm text-red-600";
        uploadBtn.disabled = false;
        uploadBtn.textContent = "Retry upload";
      }
    });
  }
</script>
