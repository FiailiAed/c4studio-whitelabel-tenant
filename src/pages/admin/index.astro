---
import AdminDashboardLayout from "@layouts/AdminDashboardLayout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../convex/_generated/api";

const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);
const allUsers = await client.query(api.users.listUsers, {});

const statusCounts = {
  pending:     allUsers.filter((u) => u.onboardStatus === "pending" || !u.onboardStatus).length,
  in_progress: allUsers.filter((u) => u.onboardStatus === "in_progress").length,
  submitted:   allUsers.filter((u) => u.onboardStatus === "submitted").length,
  done:        allUsers.filter((u) => u.onboardStatus === "done").length,
};

const stats = [
  { label: "Total Staff",      value: allUsers.length,             href: "/admin/staff",                 color: "text-gray-900" },
  { label: "Pending",          value: statusCounts.pending,        href: "/admin/staff?status=pending",  color: "text-red-600" },
  { label: "In Progress",      value: statusCounts.in_progress,    href: "/admin/staff?status=in_progress", color: "text-yellow-600" },
  { label: "Needs Review",     value: statusCounts.submitted,      href: "/admin/staff?status=submitted", color: "text-blue-600" },
  { label: "Approved",         value: statusCounts.done,           href: "/admin/staff?status=done",     color: "text-green-600" },
];
---

<AdminDashboardLayout title="Dashboard" currentTab="dashboard" breadcrumbs={[{ name: "Dashboard", href: "/admin/" }]}>
  <!-- Stats overview -->
  <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
    {stats.map((stat) => (
      <a
        href={stat.href}
        class="relative overflow-hidden rounded-lg bg-white px-4 py-5 shadow-sm ring-1 ring-gray-900/5 hover:ring-indigo-500 hover:shadow-md transition-shadow"
      >
        <dt class="truncate text-sm font-medium text-gray-500">{stat.label}</dt>
        <dd class={`mt-1 text-3xl font-semibold tracking-tight ${stat.color}`}>{stat.value}</dd>
      </a>
    ))}
  </div>

  <!-- Needs review callout -->
  {statusCounts.submitted > 0 && (
    <div class="mt-8 rounded-lg bg-blue-50 p-6 ring-1 ring-blue-200">
      <div class="flex items-center gap-4">
        <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-blue-100">
          <svg class="size-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
          </svg>
        </div>
        <div class="flex-1">
          <h3 class="text-sm font-semibold text-blue-900">
            {statusCounts.submitted} submission{statusCounts.submitted !== 1 ? "s" : ""} awaiting your review
          </h3>
          <p class="mt-1 text-sm text-blue-700">Staff members have completed onboarding and are waiting for approval.</p>
        </div>
        <a
          href="/admin/staff?status=submitted"
          class="shrink-0 rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-500"
        >
          Review now &rarr;
        </a>
      </div>
    </div>
  )}

  <!-- Quick links -->
  <div class="mt-8 flex flex-wrap gap-3">
    <a href="/admin/config" class="inline-flex items-center gap-2 rounded-md bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm ring-1 ring-gray-900/5 hover:bg-gray-50">
      <svg class="size-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
      </svg>
      Season Configuration
    </a>
  </div>

  <!-- Recent activity -->
  <div class="mt-8">
    <h2 class="text-base font-semibold text-gray-900">Recent Staff</h2>
    <div class="mt-4 space-y-2">
      {allUsers.length === 0 ? (
        <div class="rounded-lg bg-white px-4 py-8 text-center text-sm text-gray-500 shadow-sm ring-1 ring-gray-900/5">
          No staff members yet.
        </div>
      ) : (
        allUsers.slice(0, 10).map((user) => (
          <div class="rounded-lg bg-white px-4 py-3 shadow-sm ring-1 ring-gray-900/5">
            <div class="flex items-center justify-between gap-2">
              <div class="min-w-0">
                <p class="text-sm font-medium text-gray-900 truncate">
                  {[user.firstName, user.lastName].filter(Boolean).join(" ") || "—"}
                </p>
                <p class="text-xs text-gray-500 truncate">{user.email}</p>
              </div>
              <div class="flex items-center gap-3 shrink-0">
                {(!user.onboardStatus || user.onboardStatus === "pending") && (
                  <span class="inline-flex items-center rounded-md bg-red-400/10 px-2 py-1 text-xs font-medium text-red-400 ring-1 ring-inset ring-red-400/20">Pending</span>
                )}
                {user.onboardStatus === "in_progress" && (
                  <span class="inline-flex items-center rounded-md bg-yellow-400/10 px-2 py-1 text-xs font-medium text-yellow-600 ring-1 ring-inset ring-yellow-400/20">In Progress</span>
                )}
                {user.onboardStatus === "submitted" && (
                  <span class="inline-flex items-center rounded-md bg-blue-400/10 px-2 py-1 text-xs font-medium text-blue-600 ring-1 ring-inset ring-blue-400/20">Submitted</span>
                )}
                {user.onboardStatus === "done" && (
                  <span class="inline-flex items-center rounded-md bg-green-400/10 px-2 py-1 text-xs font-medium text-green-600 ring-1 ring-inset ring-green-500/20">Approved</span>
                )}
                {user.onboardStatus === "submitted" ? (
                  <a href={`/admin/staff/${user.clerkId}`} class="text-sm font-medium text-indigo-600 hover:text-indigo-900">Review</a>
                ) : (
                  <a href={`/admin/staff/${user.clerkId}`} class="text-sm text-gray-400 hover:text-gray-600">View</a>
                )}
              </div>
            </div>
          </div>
        ))
      )}
    </div>
    {allUsers.length > 10 && (
      <div class="mt-3 text-center">
        <a href="/admin/staff" class="text-sm text-indigo-600 hover:text-indigo-900">View all {allUsers.length} staff members &rarr;</a>
      </div>
    )}
  </div>
</AdminDashboardLayout>
