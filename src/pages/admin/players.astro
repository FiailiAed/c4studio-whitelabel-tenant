---
import AdminDashboardLayout from "@layouts/AdminDashboardLayout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../convex/_generated/api";
import type { Id } from "../../../convex/_generated/dataModel";

type AgeGroup = "U6" | "U8" | "U12" | "U14";

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/");

const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);

// Handle POST actions
let actionError: string | null = null;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = form.get("_action") as string | null;

  try {
    if (action === "add") {
      const name = (form.get("name") as string | null)?.trim();
      const jerseyRaw = form.get("jerseyNumber") as string | null;
      const ageGroup = form.get("ageGroup") as AgeGroup | null;

      if (!name || !ageGroup) {
        actionError = "Name and age group are required.";
      } else {
        const jerseyNumber = jerseyRaw ? parseInt(jerseyRaw, 10) : undefined;
        await client.mutation(api.players.createPlayer, {
          name,
          jerseyNumber: !isNaN(jerseyNumber as number) ? jerseyNumber : undefined,
          ageGroup,
        });
        return Astro.redirect("/admin/players");
      }
    } else if (action === "deactivate" || action === "reactivate") {
      const playerId = form.get("playerId") as Id<"players"> | null;
      if (playerId) {
        await client.mutation(api.players.setPlayerActive, {
          playerId,
          isActive: action === "reactivate",
        });
        return Astro.redirect("/admin/players");
      }
    }
  } catch (e) {
    actionError = e instanceof Error ? e.message : "An error occurred.";
  }
}

const allPlayers = await client.query(api.players.listAllPlayers, {});

const AGE_GROUPS: AgeGroup[] = ["U6", "U8", "U12", "U14"];

// Group by ageGroup
const byAgeGroup = new Map<AgeGroup, typeof allPlayers>();
for (const ag of AGE_GROUPS) {
  byAgeGroup.set(ag, allPlayers.filter((p) => p.ageGroup === ag));
}
---

<AdminDashboardLayout title="Players" currentTab="players" breadcrumbs={[{ name: "Players", href: "/admin/players" }]}>

  {actionError && (
    <div class="mb-4 rounded-md bg-red-50 p-4">
      <p class="text-sm text-red-700">{actionError}</p>
    </div>
  )}

  <!-- Add Player form -->
  <div class="mb-8">
    <details class="bg-white rounded-lg shadow-sm border border-gray-200">
      <summary class="px-6 py-4 cursor-pointer font-semibold text-gray-900 hover:bg-gray-50 rounded-lg">
        + Add Player
      </summary>
      <div class="px-6 pb-6 pt-2 border-t border-gray-100">
        <form method="POST" class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <input type="hidden" name="_action" value="add" />

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Name *</label>
            <input
              type="text"
              name="name"
              required
              class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
              placeholder="Player name"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Jersey #</label>
            <input
              type="number"
              name="jerseyNumber"
              min="0"
              max="99"
              class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
              placeholder="Optional"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Age Group *</label>
            <select
              name="ageGroup"
              required
              class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
            >
              <option value="">Select…</option>
              {AGE_GROUPS.map((ag) => (
                <option value={ag}>{ag}</option>
              ))}
            </select>
          </div>

          <div class="sm:col-span-3 flex justify-end">
            <button
              type="submit"
              class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
            >
              Add Player
            </button>
          </div>
        </form>
      </div>
    </details>
  </div>

  <!-- Players by age group -->
  <div class="space-y-8">
    {AGE_GROUPS.map((ag) => {
      const players = byAgeGroup.get(ag) ?? [];
      return (
        <div>
          <h2 class="text-lg font-semibold text-gray-900 mb-3">{ag} <span class="text-sm font-normal text-gray-400">({players.length})</span></h2>

          {players.length === 0 ? (
            <p class="text-sm text-gray-400">No players in this group yet.</p>
          ) : (
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 divide-y divide-gray-100">
              {players.map((player) => (
                <div class={`flex items-center justify-between px-4 py-3 ${!player.isActive ? "opacity-50" : ""}`}>
                  <div>
                    <span class={`text-sm font-medium text-gray-900 ${!player.isActive ? "line-through" : ""}`}>
                      {player.name}
                    </span>
                    {player.jerseyNumber != null && (
                      <span class="ml-2 text-xs text-gray-400">#{player.jerseyNumber}</span>
                    )}
                    {!player.isActive && (
                      <span class="ml-2 text-xs text-gray-400">(inactive)</span>
                    )}
                  </div>

                  <form method="POST">
                    <input type="hidden" name="playerId" value={player._id} />
                    <input
                      type="hidden"
                      name="_action"
                      value={player.isActive ? "deactivate" : "reactivate"}
                    />
                    <button
                      type="submit"
                      class={`text-xs font-medium px-3 py-1 rounded-full border ${
                        player.isActive
                          ? "border-red-200 text-red-600 hover:bg-red-50"
                          : "border-green-200 text-green-600 hover:bg-green-50"
                      }`}
                    >
                      {player.isActive ? "Deactivate" : "Reactivate"}
                    </button>
                  </form>
                </div>
              ))}
            </div>
          )}
        </div>
      );
    })}
  </div>

</AdminDashboardLayout>
