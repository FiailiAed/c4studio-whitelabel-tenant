---
import AdminDashboardLayout from "@layouts/AdminDashboardLayout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../convex/_generated/api";

const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);

type GameAgeGroup = "08U" | "10U" | "12U" | "14U";
const ALL_GAME_AGE_GROUPS: GameAgeGroup[] = ["08U", "10U", "12U", "14U"];
const VALID_GAME_AGE_GROUPS = new Set<string>(ALL_GAME_AGE_GROUPS);

let savedSuccess = false;
let formError: string | null = null;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const activeGameAgeGroups = (formData.getAll("activeGameAgeGroups") as string[])
    .filter((ag): ag is GameAgeGroup => VALID_GAME_AGE_GROUPS.has(ag));

  try {
    await client.mutation(api.onboarding.updateSeasonConfig, { activeGameAgeGroups });
    return Astro.redirect("/admin/config?saved=1");
  } catch (err) {
    formError = err instanceof Error ? err.message : "Failed to save configuration.";
  }
}

const savedParam = new URL(Astro.request.url).searchParams.get("saved");
if (savedParam === "1") savedSuccess = true;

const seasonConfig = await client.query(api.onboarding.getSeasonConfig, {});
const activeGroups = seasonConfig?.activeGameAgeGroups ?? ["10U", "12U"];
---

<AdminDashboardLayout title="Season Configuration" currentTab="config" breadcrumbs={[{ name: "Config", href: "/admin/config" }]}>

  {savedSuccess && (
    <div class="mb-6 rounded-md bg-green-50 border border-green-200 p-4 flex items-center gap-3">
      <svg class="size-5 text-green-500 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
      </svg>
      <p class="text-sm font-medium text-green-800">Season configuration saved successfully.</p>
    </div>
  )}

  {formError && (
    <div class="mb-6 rounded-md bg-red-50 p-4">
      <p class="text-sm text-red-700">{formError}</p>
    </div>
  )}

  <div class="max-w-xl">
    <div class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
      <h2 class="text-base font-semibold text-gray-900">Active Game Age Groups</h2>
      <p class="mt-1 text-sm text-gray-500">
        Select the age groups that are playing games this season. Only these groups will appear in volunteer sign-up (Step 3) and game day checklists.
        <br /><span class="text-amber-600 font-medium">Note: 06U (Scoopers) never play games and are always excluded.</span>
      </p>

      <form method="POST" class="mt-6">
        <fieldset>
          <legend class="sr-only">Active game age groups</legend>
          <div class="space-y-3">
            {ALL_GAME_AGE_GROUPS.map((ag) => (
              <label class="flex items-center gap-3 rounded-lg border border-gray-200 px-4 py-3 cursor-pointer hover:bg-gray-50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
                <input
                  type="checkbox"
                  name="activeGameAgeGroups"
                  value={ag}
                  checked={activeGroups.includes(ag)}
                  class="size-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
                />
                <span class="text-sm font-medium text-gray-900">{ag}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="mt-6 flex justify-end">
          <button
            type="submit"
            class="rounded-md bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
          >
            Save Configuration
          </button>
        </div>
      </form>
    </div>
  </div>

</AdminDashboardLayout>
