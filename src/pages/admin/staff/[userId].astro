---
import AdminDashboardLayout from "@layouts/AdminDashboardLayout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../../convex/_generated/api";

const { userId: clerkId } = Astro.params;
if (!clerkId) return Astro.redirect("/admin/staff");

const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);

const [user, onboarding] = await Promise.all([
  client.query(api.users.getUserByClerkId, { clerkId }),
  client.query(api.onboarding.getOnboardingByClerkId, { clerkId }),
]);

if (!user) return Astro.redirect("/admin/staff");

const fullName = [user.firstName, user.lastName].filter(Boolean).join(" ") || "—";

// ── Label maps ────────────────────────────────────────────────────────────────
const VOLUNTEER_TYPE_LABELS: Record<string, string> = {
  parent_volunteer:   "Parent Volunteer",
  high_school_player: "High School Player",
  adult_volunteer:    "Adult Volunteer",
};

const EXPERIENCE_LEVEL_LABELS: Record<string, string> = {
  none:        "None",
  youth:       "Youth",
  high_school: "High School",
  college:     "College",
  pro:         "Professional",
};

const PRACTICE_POSITION_LABELS: Record<string, string> = {
  coach:              "Coach",
  defensive_trainer:  "Defensive Trainer",
  offensive_trainer:  "Offensive Trainer",
  goalie_trainer:     "Goalie Trainer",
  helper:             "Helper / Assistant",
  media:              "Media / Photography",
};

const GAME_POSITION_LABELS: Record<string, string> = {
  head_coach:      "Head Coach",
  assistant_coach: "Assistant Coach",
  goalie_coach:    "Goalie Coach",
  parent_coach:    "Parent Coach",
  scorekeeper:     "Scorekeeper",
  media_team:      "Media Team",
  game_day_helper: "Game Day Helper",
};

// Legacy position labels (old 2-step flow)
const LEGACY_POSITION_LABELS: Record<string, string> = {
  head_coach:      "Head Coach",
  assistant_coach: "Assistant Coach",
  trainer:         "Trainer",
  practice_helper: "Practice Helper",
  game_day_helper: "Game Day Helper",
  scorekeeper:     "Scorekeeper",
  media_team:      "Media Team",
};

const TIME_SLOT_LABELS: Record<string, string> = {
  "9am":  "9:00 AM",
  "10am": "10:00 AM",
  "11am": "11:00 AM",
  "12pm": "12:00 PM",
  "1pm":  "1:00 PM",
  "2pm":  "2:00 PM",
};

// Determine if this is a new-flow or legacy record
const isNewFlow = !!(onboarding?.volunteerType);
const isHeadCoach = onboarding?.gamePositions?.includes("head_coach") ?? false;
---

<AdminDashboardLayout title={`Review: ${fullName}`} currentTab="staff" breadcrumbs={[{ name: "Staff", href: "/admin/staff" }, { name: fullName || user.email, href: Astro.url.pathname }]}>

  <!-- Back link -->
  <div class="mb-6">
    <a href="/admin/staff?status=submitted" class="flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700">
      <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" />
      </svg>
      Back to Staff
    </a>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

    <!-- Left: User summary + action -->
    <div class="lg:col-span-1">
      <div class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
        <div class="flex items-center gap-4">
          <div class="flex size-14 shrink-0 items-center justify-center rounded-full bg-indigo-100">
            <span class="text-xl font-bold text-indigo-700">{fullName.charAt(0).toUpperCase()}</span>
          </div>
          <div>
            <h2 class="text-lg font-semibold text-gray-900">{fullName}</h2>
            <p class="text-sm text-gray-500">{user.email}</p>
          </div>
        </div>

        <dl class="mt-6 divide-y divide-gray-100">
          {onboarding?.volunteerType && (
            <div class="py-3 flex justify-between items-center">
              <dt class="text-sm font-medium text-gray-500">Type</dt>
              <dd>
                <span class="inline-flex items-center rounded-md bg-indigo-400/10 px-2.5 py-1 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-400/20">
                  {VOLUNTEER_TYPE_LABELS[onboarding.volunteerType] ?? onboarding.volunteerType}
                </span>
              </dd>
            </div>
          )}
          <div class="py-3 flex justify-between">
            <dt class="text-sm font-medium text-gray-500">Role</dt>
            <dd class="text-sm text-gray-900">{user.role}</dd>
          </div>
          <div class="py-3 flex justify-between">
            <dt class="text-sm font-medium text-gray-500">Status</dt>
            <dd>
              {user.onboardStatus === "submitted" && (
                <span class="inline-flex items-center rounded-md bg-blue-400/10 px-2 py-1 text-xs font-medium text-blue-600 ring-1 ring-inset ring-blue-400/20">Submitted</span>
              )}
              {user.onboardStatus === "done" && (
                <span class="inline-flex items-center rounded-md bg-green-400/10 px-2 py-1 text-xs font-medium text-green-600 ring-1 ring-inset ring-green-500/20">Approved</span>
              )}
              {user.onboardStatus !== "submitted" && user.onboardStatus !== "done" && (
                <span class="inline-flex items-center rounded-md bg-gray-400/10 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-400/20">{user.onboardStatus ?? "pending"}</span>
              )}
            </dd>
          </div>
          {onboarding?.submittedAt && (
            <div class="py-3 flex justify-between">
              <dt class="text-sm font-medium text-gray-500">Submitted</dt>
              <dd class="text-sm text-gray-900">{new Date(onboarding.submittedAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</dd>
            </div>
          )}
          {onboarding?.approvedAt && (
            <div class="py-3 flex justify-between">
              <dt class="text-sm font-medium text-gray-500">Approved</dt>
              <dd class="text-sm text-gray-900">{new Date(onboarding.approvedAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</dd>
            </div>
          )}
          <div class="py-3">
            <dt class="text-sm font-medium text-gray-500 mb-1">Clerk ID</dt>
            <dd class="text-xs font-mono text-gray-500 break-all">{clerkId}</dd>
          </div>
        </dl>

        {user.onboardStatus === "submitted" && (
          <form action="/api/admin/approve" method="POST" class="mt-6">
            <input type="hidden" name="clerkId" value={clerkId} />
            <button
              type="submit"
              class="w-full rounded-md bg-green-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-green-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600"
            >
              Approve Staff Member
            </button>
          </form>
        )}

        {user.onboardStatus === "done" && (
          <div class="mt-6 rounded-md bg-green-50 px-4 py-3 text-center">
            <p class="text-sm font-medium text-green-700">This staff member has been approved.</p>
          </div>
        )}
      </div>
    </div>

    <!-- Right: Submission details -->
    <div class="lg:col-span-2 space-y-6">

      {!onboarding ? (
        <div class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
          <p class="text-sm text-gray-500">No onboarding submission found for this user.</p>
        </div>
      ) : isNewFlow ? (
        <>
          <!-- Step 1: Background -->
          <div class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
            <h3 class="text-base font-semibold text-gray-900 mb-4">Background</h3>
            <dl class="divide-y divide-gray-100">
              <div class="py-3">
                <dt class="text-sm font-medium text-gray-500 mb-1">Playing Experience</dt>
                <dd class="text-sm text-gray-900">
                  {onboarding.playingExperience
                    ? `${onboarding.playingExperience.yearsPlayed} year${onboarding.playingExperience.yearsPlayed !== 1 ? "s" : ""} — ${EXPERIENCE_LEVEL_LABELS[onboarding.playingExperience.highestLevel] ?? onboarding.playingExperience.highestLevel}`
                    : <span class="text-gray-400">Not provided</span>
                  }
                </dd>
              </div>
              <div class="py-3">
                <dt class="text-sm font-medium text-gray-500 mb-2">Coaching Experience</dt>
                <dd>
                  {(!onboarding.coachingExperience || onboarding.coachingExperience.length === 0) ? (
                    <span class="text-sm text-gray-400">None listed.</span>
                  ) : (
                    <ul class="space-y-1">
                      {onboarding.coachingExperience.map((entry) => (
                        <li class="text-sm text-gray-900">
                          {entry.sport} — {entry.years} year{entry.years !== 1 ? "s" : ""}
                        </li>
                      ))}
                    </ul>
                  )}
                </dd>
              </div>
            </dl>
          </div>

          <!-- Step 2: Practice Availability -->
          <div class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
            <h3 class="text-base font-semibold text-gray-900 mb-4">Practice Availability</h3>
            <dl class="divide-y divide-gray-100">
              <div class="py-3">
                <dt class="text-sm font-medium text-gray-500 mb-2">Practice Roles</dt>
                <dd class="flex flex-wrap gap-2">
                  {(!onboarding.practicePositions || onboarding.practicePositions.length === 0) ? (
                    <span class="text-sm text-gray-400">None selected.</span>
                  ) : (
                    onboarding.practicePositions.map((pos) => (
                      <span class="inline-flex items-center rounded-md bg-indigo-400/10 px-2.5 py-1 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-400/20">
                        {PRACTICE_POSITION_LABELS[pos] ?? pos}
                      </span>
                    ))
                  )}
                </dd>
              </div>
              <div class="py-3">
                <dt class="text-sm font-medium text-gray-500 mb-2">Practice Age Groups</dt>
                <dd class="flex flex-wrap gap-2">
                  {(!onboarding.practiceAgeGroups || onboarding.practiceAgeGroups.length === 0) ? (
                    <span class="text-sm text-gray-400">None selected.</span>
                  ) : (
                    onboarding.practiceAgeGroups.map((ag) => (
                      <span class="inline-flex items-center rounded-md bg-gray-400/10 px-2.5 py-1 text-xs font-medium text-gray-700 ring-1 ring-inset ring-gray-400/20">{ag}</span>
                    ))
                  )}
                </dd>
              </div>
              <div class="py-3">
                <dt class="text-sm font-medium text-gray-500 mb-2">Practice Days</dt>
                <dd class="flex flex-wrap gap-2">
                  {(!onboarding.practiceDays || onboarding.practiceDays.length === 0) ? (
                    <span class="text-sm text-gray-400">None selected.</span>
                  ) : (
                    onboarding.practiceDays.map((day) => (
                      <span class="inline-flex items-center rounded-md bg-green-400/10 px-2.5 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-400/20">
                        {day.charAt(0).toUpperCase() + day.slice(1)}
                      </span>
                    ))
                  )}
                </dd>
              </div>
            </dl>
          </div>

          <!-- Step 3: Game Availability -->
          <div class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
            <h3 class="text-base font-semibold text-gray-900 mb-4">
              Game Availability
              {isHeadCoach && (
                <span class="ml-2 inline-flex items-center rounded-md bg-amber-400/10 px-2 py-1 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-400/20">Head Coach</span>
              )}
            </h3>
            <dl class="divide-y divide-gray-100">
              <div class="py-3">
                <dt class="text-sm font-medium text-gray-500 mb-2">Game-Day Roles</dt>
                <dd class="flex flex-wrap gap-2">
                  {(!onboarding.gamePositions || onboarding.gamePositions.length === 0) ? (
                    <span class="text-sm text-gray-400">None selected.</span>
                  ) : (
                    onboarding.gamePositions.map((pos) => (
                      <span class={`inline-flex items-center rounded-md px-2.5 py-1 text-xs font-medium ring-1 ring-inset ${pos === "head_coach" ? "bg-amber-400/10 text-amber-700 ring-amber-400/20" : "bg-indigo-400/10 text-indigo-700 ring-indigo-400/20"}`}>
                        {GAME_POSITION_LABELS[pos] ?? pos}
                      </span>
                    ))
                  )}
                </dd>
              </div>
              <div class="py-3">
                <dt class="text-sm font-medium text-gray-500 mb-2">Game Age Groups</dt>
                <dd class="flex flex-wrap gap-2">
                  {(!onboarding.gameAgeGroups || onboarding.gameAgeGroups.length === 0) ? (
                    <span class="text-sm text-gray-400">None selected.</span>
                  ) : (
                    onboarding.gameAgeGroups.map((ag) => (
                      <span class="inline-flex items-center rounded-md bg-gray-400/10 px-2.5 py-1 text-xs font-medium text-gray-700 ring-1 ring-inset ring-gray-400/20">{ag}</span>
                    ))
                  )}
                </dd>
              </div>
              <div class="py-3">
                <dt class="text-sm font-medium text-gray-500 mb-2">Saturday Time Slots</dt>
                <dd class="flex flex-wrap gap-2">
                  {(!onboarding.gameAvailability || onboarding.gameAvailability.length === 0) ? (
                    <span class="text-sm text-gray-400">None selected.</span>
                  ) : (
                    onboarding.gameAvailability.map((slot) => (
                      <span class="inline-flex items-center rounded-md bg-blue-400/10 px-2.5 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-400/20">
                        {TIME_SLOT_LABELS[slot] ?? slot}
                      </span>
                    ))
                  )}
                </dd>
              </div>
            </dl>
          </div>

          <!-- Step 4: Compliance -->
          <div class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
            <h3 class="text-base font-semibold text-gray-900 mb-4">Compliance</h3>
            <dl class="divide-y divide-gray-100">
              <div class="py-3 flex justify-between items-start">
                <dt class="text-sm font-medium text-gray-500">
                  USA Lacrosse ID
                  {isHeadCoach && <span class="ml-1 text-xs text-amber-600 font-normal">(required for HC)</span>}
                </dt>
                <dd class="text-sm text-gray-900 font-mono">{onboarding.usaLacrosseId ?? <span class="text-gray-400 font-sans">Not provided</span>}</dd>
              </div>
              <div class="py-3">
                <dt class="text-sm font-medium text-gray-500 mb-2">
                  Certifications
                  <span class="ml-1 font-normal text-gray-400">({onboarding.certifications.length})</span>
                </dt>
                <dd>
                  {onboarding.certifications.length === 0 ? (
                    <span class="text-sm text-gray-400">None uploaded.</span>
                  ) : (
                    <ul class="space-y-1">
                      {onboarding.certifications.map((cert) => (
                        <li>
                          <a href={cert.url} target="_blank" rel="noopener noreferrer" class="text-sm text-indigo-600 hover:text-indigo-800 underline">
                            {cert.name}
                          </a>
                          <span class="ml-2 text-xs text-gray-400">
                            {new Date(cert.uploadedAt).toLocaleDateString("en-US", { month: "short", day: "numeric" })}
                          </span>
                        </li>
                      ))}
                    </ul>
                  )}
                </dd>
              </div>
              <div class="py-3">
                <dt class="text-sm font-medium text-gray-500 mb-2">
                  Document Acknowledgments
                  <span class="ml-1 font-normal text-gray-400">({onboarding.documentAcknowledgments.length})</span>
                </dt>
                <dd>
                  {onboarding.documentAcknowledgments.length === 0 ? (
                    <span class="text-sm text-gray-400">None acknowledged.</span>
                  ) : (
                    <ul class="space-y-1">
                      {onboarding.documentAcknowledgments.map((ack) => (
                        <li class="flex items-center gap-2 text-sm text-gray-700">
                          <svg class="size-3.5 text-green-500 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                          </svg>
                          Acknowledged on {new Date(ack.acknowledgedAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
                        </li>
                      ))}
                    </ul>
                  )}
                </dd>
              </div>
            </dl>
          </div>
        </>
      ) : (
        <>
          <!-- Legacy 2-step onboarding display -->
          <div class="rounded-lg bg-amber-50 border border-amber-200 p-4">
            <p class="text-sm text-amber-800">This record was submitted via the previous onboarding flow. Fields shown below reflect the old format.</p>
          </div>

          <!-- Legacy: Roles & Age Groups -->
          <div class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
            <h3 class="text-base font-semibold text-gray-900 mb-4">Roles & Age Groups (Legacy)</h3>
            <dl class="divide-y divide-gray-100">
              <div class="py-3">
                <dt class="text-sm font-medium text-gray-500 mb-2">Positions</dt>
                <dd class="flex flex-wrap gap-2">
                  {(!onboarding.positions || onboarding.positions.length === 0) ? (
                    <span class="text-sm text-gray-400">None.</span>
                  ) : (
                    onboarding.positions.map((pos) => (
                      <span class="inline-flex items-center rounded-md bg-indigo-400/10 px-2.5 py-1 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-400/20">
                        {LEGACY_POSITION_LABELS[pos] ?? pos}
                      </span>
                    ))
                  )}
                </dd>
              </div>
              <div class="py-3">
                <dt class="text-sm font-medium text-gray-500 mb-2">Age Groups</dt>
                <dd class="flex flex-wrap gap-2">
                  {(!onboarding.ageGroups || onboarding.ageGroups.length === 0) ? (
                    <span class="text-sm text-gray-400">None.</span>
                  ) : (
                    onboarding.ageGroups.map((ag) => (
                      <span class="inline-flex items-center rounded-md bg-gray-400/10 px-2.5 py-1 text-xs font-medium text-gray-700 ring-1 ring-inset ring-gray-400/20">{ag}</span>
                    ))
                  )}
                </dd>
              </div>
              <div class="py-3">
                <dt class="text-sm font-medium text-gray-500 mb-2">Practice Availability</dt>
                <dd class="flex flex-wrap gap-2">
                  {(!onboarding.practiceAvailability || onboarding.practiceAvailability.length === 0) ? (
                    <span class="text-sm text-gray-400">None.</span>
                  ) : (
                    onboarding.practiceAvailability.map((day) => (
                      <span class="inline-flex items-center rounded-md bg-green-400/10 px-2.5 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-400/20">
                        {day.charAt(0).toUpperCase() + day.slice(1)}
                      </span>
                    ))
                  )}
                </dd>
              </div>
            </dl>
          </div>

          <!-- Legacy: Compliance -->
          <div class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
            <h3 class="text-base font-semibold text-gray-900 mb-4">Compliance</h3>
            <dl class="divide-y divide-gray-100">
              <div class="py-3 flex justify-between items-start">
                <dt class="text-sm font-medium text-gray-500">USA Lacrosse ID</dt>
                <dd class="text-sm text-gray-900 font-mono">{onboarding.usaLacrosseId ?? <span class="text-gray-400 font-sans">Not provided</span>}</dd>
              </div>
              <div class="py-3">
                <dt class="text-sm font-medium text-gray-500 mb-2">
                  Certifications
                  <span class="ml-1 font-normal text-gray-400">({onboarding.certifications.length})</span>
                </dt>
                <dd>
                  {onboarding.certifications.length === 0 ? (
                    <span class="text-sm text-gray-400">None uploaded.</span>
                  ) : (
                    <ul class="space-y-1">
                      {onboarding.certifications.map((cert) => (
                        <li>
                          <a href={cert.url} target="_blank" rel="noopener noreferrer" class="text-sm text-indigo-600 hover:text-indigo-800 underline">
                            {cert.name}
                          </a>
                          <span class="ml-2 text-xs text-gray-400">
                            {new Date(cert.uploadedAt).toLocaleDateString("en-US", { month: "short", day: "numeric" })}
                          </span>
                        </li>
                      ))}
                    </ul>
                  )}
                </dd>
              </div>
              <div class="py-3">
                <dt class="text-sm font-medium text-gray-500 mb-2">
                  Document Acknowledgments
                  <span class="ml-1 font-normal text-gray-400">({onboarding.documentAcknowledgments.length})</span>
                </dt>
                <dd>
                  {onboarding.documentAcknowledgments.length === 0 ? (
                    <span class="text-sm text-gray-400">None acknowledged.</span>
                  ) : (
                    <ul class="space-y-1">
                      {onboarding.documentAcknowledgments.map((ack) => (
                        <li class="flex items-center gap-2 text-sm text-gray-700">
                          <svg class="size-3.5 text-green-500 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                          </svg>
                          Acknowledged on {new Date(ack.acknowledgedAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
                        </li>
                      ))}
                    </ul>
                  )}
                </dd>
              </div>
            </dl>
          </div>
        </>
      )}

    </div>
  </div>

</AdminDashboardLayout>
