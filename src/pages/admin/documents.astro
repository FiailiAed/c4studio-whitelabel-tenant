---
import AdminDashboardLayout from "@layouts/AdminDashboardLayout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../convex/_generated/api";

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/");

const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);

const callerUser = await client.query(api.users.getUserByClerkId, { clerkId: userId });
if (!callerUser || callerUser.role !== "admin") {
  return Astro.redirect("/");
}

const [documents, ackCounts, allUsers] = await Promise.all([
  client.query(api.documents.listAllDocuments, {}),
  client.query(api.documents.getAcknowledgmentCounts, {}),
  client.query(api.users.listUsers, {}),
]);

const totalStaff = allUsers.filter((u) => u.role !== "admin").length;
---

<AdminDashboardLayout title="Documents" currentTab="documents" breadcrumbs={[{ name: "Documents", href: "/admin/documents" }]}>

  <div class="mb-6 flex items-center justify-between">
    <p class="text-sm text-gray-500">{documents.length} document{documents.length !== 1 ? "s" : ""} total</p>
    <a
      href="/admin/documents/new"
      class="inline-flex items-center gap-2 rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
    >
      <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      New Document
    </a>
  </div>

  <!-- Document cards -->
  <div class="space-y-3">
    {documents.length === 0 ? (
      <div class="rounded-lg bg-white px-4 py-12 text-center text-sm text-gray-500 shadow-sm ring-1 ring-gray-900/5">
        No documents yet. <a href="/admin/documents/new" class="text-indigo-600 hover:text-indigo-500">Create your first document.</a>
      </div>
    ) : (
      documents.map((doc) => {
        const ackCount = ackCounts[doc._id] ?? 0;
        const isInactive = !doc.isActive;
        return (
          <div class={`rounded-lg bg-white px-4 py-3 shadow-sm ring-1 ring-gray-900/5 ${isInactive ? "opacity-60" : ""}`}>
            <div class="flex items-start justify-between gap-2">
              <p class={`text-sm font-semibold ${isInactive ? "text-gray-400 line-through" : "text-gray-900"}`}>
                {doc.title}
              </p>
              <span class={`shrink-0 inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset ${doc.isActive ? "bg-green-400/10 text-green-600 ring-green-500/20" : "bg-gray-400/10 text-gray-500 ring-gray-400/20"}`}>
                {doc.isActive ? "Active" : "Inactive"}
              </span>
            </div>
            <p class="mt-1 text-xs text-gray-500">v{doc.version} · {ackCount}/{totalStaff} acknowledged</p>
            <div class="mt-2 flex items-center justify-between">
              <a href={`/admin/documents/${doc._id}`} class="text-sm font-medium text-indigo-600 hover:text-indigo-900">
                View
              </a>
              <form method="POST" action="/api/admin/documents/toggle-active">
                <input type="hidden" name="documentId" value={doc._id} />
                <input type="hidden" name="isActive" value={String(doc.isActive)} />
                <button
                  type="submit"
                  class={`text-xs font-medium ${doc.isActive ? "text-yellow-600 hover:text-yellow-800" : "text-green-600 hover:text-green-800"}`}
                >
                  {doc.isActive ? "Deactivate" : "Activate"}
                </button>
              </form>
            </div>
          </div>
        );
      })
    )}
  </div>

</AdminDashboardLayout>
