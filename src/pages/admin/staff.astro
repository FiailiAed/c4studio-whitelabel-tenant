---
import AdminDashboardLayout from "@layouts/AdminDashboardLayout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../convex/_generated/api";

const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);
const allUsers = await client.query(api.users.listUsers, {});

const statusFilter = Astro.url.searchParams.get("status") ?? "";

const filteredUsers = statusFilter
  ? allUsers.filter((u) => {
      if (statusFilter === "pending") return !u.onboardStatus || u.onboardStatus === "pending";
      return u.onboardStatus === statusFilter;
    })
  : allUsers;

const statusTabs = [
  { label: "All",         value: "",            count: allUsers.length },
  { label: "Pending",     value: "pending",     count: allUsers.filter((u) => !u.onboardStatus || u.onboardStatus === "pending").length },
  { label: "In Progress", value: "in_progress", count: allUsers.filter((u) => u.onboardStatus === "in_progress").length },
  { label: "Submitted",   value: "submitted",   count: allUsers.filter((u) => u.onboardStatus === "submitted").length },
  { label: "Approved",    value: "done",        count: allUsers.filter((u) => u.onboardStatus === "done").length },
];

function statusBadge(status: string | undefined): { label: string; classes: string } {
  switch (status) {
    case "in_progress": return { label: "In Progress", classes: "bg-yellow-400/10 text-yellow-600 ring-yellow-400/20" };
    case "submitted":   return { label: "Submitted",   classes: "bg-blue-400/10 text-blue-600 ring-blue-400/20" };
    case "done":        return { label: "Approved",    classes: "bg-green-400/10 text-green-600 ring-green-500/20" };
    default:            return { label: "Pending",     classes: "bg-red-400/10 text-red-400 ring-red-400/20" };
  }
}
---

<AdminDashboardLayout title="Staff" currentTab="staff" breadcrumbs={[{ name: "Staff", href: "/admin/staff" }]}>

  <!-- Status filter tabs -->
  <div class="border-b border-gray-200">
    <nav class="-mb-px flex space-x-6" aria-label="Tabs">
      {statusTabs.map((tab) => {
        const isActive = tab.value === statusFilter;
        return (
          <a
            href={tab.value ? `/admin/staff?status=${tab.value}` : "/admin/staff"}
            class={
              isActive
                ? "border-indigo-500 text-indigo-600 whitespace-nowrap border-b-2 px-1 py-4 text-sm font-medium"
                : "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 whitespace-nowrap border-b-2 px-1 py-4 text-sm font-medium"
            }
            aria-current={isActive ? "page" : undefined}
          >
            {tab.label}
            {tab.count > 0 && (
              <span class={`ml-2 rounded-full px-2 py-0.5 text-xs font-medium ${isActive ? "bg-indigo-100 text-indigo-600" : "bg-gray-100 text-gray-600"}`}>
                {tab.count}
              </span>
            )}
          </a>
        );
      })}
    </nav>
  </div>

  <!-- Staff cards -->
  <div class="mt-6 space-y-3">
    {filteredUsers.length === 0 ? (
      <div class="rounded-lg bg-white px-4 py-12 text-center text-sm text-gray-500 shadow-sm ring-1 ring-gray-900/5">
        No staff members match this filter.
      </div>
    ) : (
      filteredUsers.map((user) => {
        const badge = statusBadge(user.onboardStatus);
        return (
          <div class="rounded-lg bg-white px-4 py-3 shadow-sm ring-1 ring-gray-900/5">
            <div class="flex items-start justify-between gap-2">
              <p class="text-sm font-semibold text-gray-900">
                {[user.firstName, user.lastName].filter(Boolean).join(" ") || "—"}
              </p>
              <span class={`shrink-0 inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset ${badge.classes}`}>
                {badge.label}
              </span>
            </div>
            <div class="mt-1 flex items-center justify-between gap-2">
              <p class="text-xs text-gray-500 truncate">{user.email}</p>
              <span class={`shrink-0 inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset ${user.role === "admin" ? "bg-purple-400/10 text-purple-600 ring-purple-400/20" : "bg-gray-400/10 text-gray-600 ring-gray-400/20"}`}>
                {user.role}
              </span>
            </div>
            <div class="mt-2 flex items-center justify-between">
              <p class="text-xs text-gray-400">
                {new Date(user.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
              </p>
              <a
                href={`/admin/staff/${user.clerkId}`}
                class={user.onboardStatus === "submitted" ? "text-sm font-semibold text-indigo-600 hover:text-indigo-900" : "text-sm text-gray-400 hover:text-gray-600"}
              >
                {user.onboardStatus === "submitted" ? "Review" : "View"}
              </a>
            </div>
          </div>
        );
      })
    )}
  </div>

</AdminDashboardLayout>
