---
import AdminDashboardLayout from "@layouts/AdminDashboardLayout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../../convex/_generated/api";

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/");

const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);
const callerUser = await client.query(api.users.getUserByClerkId, { clerkId: userId });
if (!callerUser || callerUser.role !== "admin") return Astro.redirect("/");

const [templates, allEvents] = await Promise.all([
  client.query(api.plans.listTemplates, {}),
  client.query(api.events.listEvents, {}),
]);

// Only show events that don't yet have a plan (so template application makes sense)
// We load event list for the apply-template dropdown
function formatDate(ts: number): string {
  return new Date(ts).toLocaleDateString("en-US", {
    weekday: "short", month: "short", day: "numeric", year: "numeric",
  });
}
---

<AdminDashboardLayout title="Plan Templates" currentTab="events" breadcrumbs={[{ name: "Plans", href: "/admin/plans/templates" }, { name: "Templates", href: "/admin/plans/templates" }]}>

  <div class="mb-6 flex items-center justify-between">
    <div>
      <a href="/admin/events" class="text-sm text-gray-500 hover:text-gray-700">&larr; Back to Events</a>
      <p class="mt-1 text-sm text-gray-500">
        {templates.length} saved template{templates.length !== 1 ? "s" : ""}
      </p>
    </div>
  </div>

  <div id="templateStatus" class="hidden mb-4 rounded-md p-3 text-sm font-medium"></div>

  {templates.length === 0 ? (
    <div class="rounded-xl bg-white p-8 text-center shadow-sm ring-1 ring-gray-900/5">
      <p class="text-sm text-gray-500">
        No templates yet. Open a practice plan and click "Save Template" to create one.
      </p>
      <a href="/admin/events" class="mt-3 inline-block text-sm text-indigo-600 hover:underline">Go to Events</a>
    </div>
  ) : (
    <div class="space-y-4">
      {templates.map((tpl) => (
        <div class="bg-white rounded-xl shadow-sm ring-1 ring-gray-900/5 px-6 py-5 flex items-center justify-between gap-6">
          <div>
            <p class="text-sm font-semibold text-gray-900">{tpl.name}</p>
            <p class="text-xs text-gray-400 mt-0.5">
              Created {formatDate(tpl.createdAt)}
            </p>
            {tpl.notes && (
              <p class="text-xs text-gray-500 mt-1 max-w-md truncate">{tpl.notes}</p>
            )}
          </div>

          <!-- Apply to Event -->
          <div class="flex items-center gap-3 shrink-0">
            <select
              class="event-select rounded-md border border-gray-300 px-2 py-1.5 text-sm text-gray-900 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
              data-template-id={tpl._id}
            >
              <option value="">Select event…</option>
              {allEvents.map((ev) => (
                <option value={ev._id}>
                  {ev.title} — {formatDate(ev.date)}
                </option>
              ))}
            </select>
            <button
              type="button"
              class="apply-template-btn rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-indigo-500 whitespace-nowrap"
              data-template-id={tpl._id}
            >
              Apply
            </button>
          </div>
        </div>
      ))}
    </div>
  )}

</AdminDashboardLayout>

<script>
  const statusEl = document.getElementById("templateStatus");

  function showStatus(msg: string, isError: boolean) {
    if (!statusEl) return;
    statusEl.textContent = msg;
    statusEl.className = `mb-4 rounded-md p-3 text-sm font-medium ${isError ? "bg-red-50 text-red-700" : "bg-green-50 text-green-700"}`;
    statusEl.classList.remove("hidden");
    setTimeout(() => statusEl.classList.add("hidden"), 5000);
  }

  document.querySelectorAll<HTMLButtonElement>(".apply-template-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const templateId = btn.dataset.templateId;
      const card = btn.closest("div.bg-white");
      const select = card?.querySelector<HTMLSelectElement>(".event-select");
      const targetEventId = select?.value;

      if (!targetEventId) {
        showStatus("Select an event first.", true);
        return;
      }
      if (!templateId) return;

      btn.disabled = true;
      btn.textContent = "Applying…";

      try {
        const res = await fetch("/api/admin/plans/apply-template", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ templateId, targetEventId }),
        });
        const data = await res.json() as { success: boolean; error?: string; planId?: string };
        if (data.success) {
          showStatus("Template applied! Redirecting to plan…", false);
          // Find the event's plan page
          const selectedOption = select?.options[select.selectedIndex];
          const eventId = selectedOption?.value;
          if (eventId) {
            setTimeout(() => {
              window.location.href = `/admin/events/${eventId}/plan`;
            }, 1000);
          }
        } else {
          showStatus(data.error ?? "Failed to apply template.", true);
        }
      } catch {
        showStatus("Network error.", true);
      } finally {
        btn.disabled = false;
        btn.textContent = "Apply";
      }
    });
  });
</script>
