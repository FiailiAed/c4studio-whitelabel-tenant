---
import AdminDashboardLayout from "@layouts/AdminDashboardLayout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../../convex/_generated/api";

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/");

const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);
const callerUser = await client.query(api.users.getUserByClerkId, { clerkId: userId });
if (!callerUser || callerUser.role !== "admin") return Astro.redirect("/");

let formError: string | null = null;

if (Astro.request.method === "POST") {
  const data = await Astro.request.formData();

  const name = (data.get("name") as string | null)?.trim() ?? "";
  const description = (data.get("description") as string | null)?.trim() || undefined;
  const defaultSection = (data.get("defaultSection") as string | null)?.trim() || undefined;
  const defaultDurationStr = (data.get("defaultDurationMinutes") as string | null)?.trim() ?? "";
  const repsPerMinStr = (data.get("repsPerMinute") as string | null)?.trim() ?? "";
  const ageGroupsRaw = data.getAll("suitableAgeGroups") as string[];

  if (!name) {
    formError = "Drill name is required.";
  } else if (!defaultDurationStr || isNaN(parseInt(defaultDurationStr, 10))) {
    formError = "Default duration is required.";
  } else if (!repsPerMinStr || isNaN(parseInt(repsPerMinStr, 10))) {
    formError = "Reps per minute is required.";
  } else {
    const validSections = ["stretch", "warmup", "offense", "ground_balls", "defense", "3v3_combat", "team_specific", "u6_practice"] as const;
    type ValidSection = typeof validSections[number];
    const resolvedSection =
      defaultSection && validSections.includes(defaultSection as ValidSection)
        ? (defaultSection as ValidSection)
        : undefined;

    const validAgeGroups = ["U6", "U8", "U12", "U14"] as const;
    type ValidAgeGroup = typeof validAgeGroups[number];
    const suitableAgeGroups = ageGroupsRaw.filter((ag): ag is ValidAgeGroup =>
      validAgeGroups.includes(ag as ValidAgeGroup)
    );

    await client.mutation(api.drills.createDrill, {
      name,
      description,
      defaultSection: resolvedSection,
      suitableAgeGroups: suitableAgeGroups.length > 0 ? suitableAgeGroups : undefined,
      defaultDurationMinutes: parseInt(defaultDurationStr, 10),
      repsPerMinute: parseInt(repsPerMinStr, 10),
    });
    return Astro.redirect("/admin/drills");
  }
}
---

<AdminDashboardLayout title="New Drill" currentTab="events" breadcrumbs={[{ name: "Drills", href: "/admin/drills" }, { name: "New Drill", href: "/admin/drills/new" }]}>

  <div class="mb-6">
    <a href="/admin/drills" class="flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700">
      <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M11.78 5.22a.75.75 0 010 1.06L8.06 10l3.72 3.72a.75.75 0 11-1.06 1.06l-4.25-4.25a.75.75 0 010-1.06l4.25-4.25a.75.75 0 011.06 0Z" clip-rule="evenodd" />
      </svg>
      Back to Drill Library
    </a>
  </div>

  {formError && (
    <div class="mb-6 rounded-md bg-red-50 p-4">
      <p class="text-sm text-red-700">{formError}</p>
    </div>
  )}

  <div class="bg-white shadow-sm rounded-xl ring-1 ring-gray-900/5 px-6 py-8 sm:px-8 max-w-2xl">
    <form method="POST" class="space-y-6">

      <!-- Name -->
      <div>
        <label for="name" class="block text-sm font-medium text-gray-900">
          Drill Name <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder="e.g. 2-man fast break"
          class="mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
        />
      </div>

      <!-- Description -->
      <div>
        <label for="description" class="block text-sm font-medium text-gray-900">Description</label>
        <textarea
          id="description"
          name="description"
          rows="3"
          placeholder="Brief description of the drill setup and objectives…"
          class="mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
        ></textarea>
      </div>

      <!-- Default Section -->
      <div>
        <label for="defaultSection" class="block text-sm font-medium text-gray-900">Default Section</label>
        <select
          id="defaultSection"
          name="defaultSection"
          class="mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
        >
          <option value="">None specified</option>
          <option value="stretch">Stretch</option>
          <option value="warmup">Warmup</option>
          <option value="offense">Offense</option>
          <option value="ground_balls">Ground Balls</option>
          <option value="defense">Defense</option>
          <option value="3v3_combat">3v3 Combat</option>
          <option value="team_specific">Team Specific</option>
          <option value="u6_practice">U6 Practice</option>
        </select>
      </div>

      <!-- Suitable Age Groups -->
      <div>
        <fieldset>
          <legend class="text-sm font-medium text-gray-900">Suitable Age Groups</legend>
          <p class="mt-0.5 text-xs text-gray-500">Leave unchecked for all age groups.</p>
          <div class="mt-3 flex flex-wrap gap-4">
            {["U6", "U8", "U12", "U14"].map((ag) => (
              <label class="flex items-center gap-2 cursor-pointer">
                <input
                  type="checkbox"
                  name="suitableAgeGroups"
                  value={ag}
                  class="size-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
                />
                <span class="text-sm text-gray-700">{ag}</span>
              </label>
            ))}
          </div>
        </fieldset>
      </div>

      <!-- Duration + Reps -->
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="defaultDurationMinutes" class="block text-sm font-medium text-gray-900">
            Default Duration (min) <span class="text-red-500">*</span>
          </label>
          <input
            type="number"
            id="defaultDurationMinutes"
            name="defaultDurationMinutes"
            required
            value="10"
            min="1"
            max="60"
            class="mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
          />
        </div>
        <div>
          <label for="repsPerMinute" class="block text-sm font-medium text-gray-900">
            Reps per Minute <span class="text-red-500">*</span>
          </label>
          <input
            type="number"
            id="repsPerMinute"
            name="repsPerMinute"
            required
            value="10"
            min="1"
            class="mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
          />
        </div>
      </div>

      <!-- Actions -->
      <div class="flex items-center justify-between pt-2 border-t border-gray-100">
        <a href="/admin/drills" class="text-sm text-gray-500 hover:text-gray-700">Cancel</a>
        <button
          type="submit"
          class="rounded-md bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500"
        >
          Create Drill
        </button>
      </div>

    </form>
  </div>

</AdminDashboardLayout>
