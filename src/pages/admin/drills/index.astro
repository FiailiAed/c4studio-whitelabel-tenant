---
import AdminDashboardLayout from "@layouts/AdminDashboardLayout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../../../convex/_generated/api";

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect("/");

const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);
const callerUser = await client.query(api.users.getUserByClerkId, { clerkId: userId });
if (!callerUser || callerUser.role !== "admin") return Astro.redirect("/");

const drills = await client.query(api.drills.listDrills, {});

const SECTION_LABELS: Record<string, string> = {
  stretch: "Stretch",
  warmup: "Warmup",
  offense: "Offense",
  ground_balls: "Ground Balls",
  defense: "Defense",
  "3v3_combat": "3v3 Combat",
  team_specific: "Team Specific",
  u6_practice: "U6 Practice",
};
---

<AdminDashboardLayout title="Drill Library" currentTab="drills" breadcrumbs={[{ name: "Drills", href: "/admin/drills" }]}>

  <div class="mb-6 flex items-center justify-between">
    <div>
      <a href="/admin/events" class="text-sm text-gray-500 hover:text-gray-700">&larr; Back to Events</a>
      <p class="mt-1 text-sm text-gray-500">{drills.length} drill{drills.length !== 1 ? "s" : ""} in the library</p>
    </div>
    <a
      href="/admin/drills/new"
      class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500"
    >
      + New Drill
    </a>
  </div>

  {drills.length === 0 ? (
    <div class="rounded-xl bg-white p-8 text-center shadow-sm ring-1 ring-gray-900/5">
      <p class="text-sm text-gray-500">No drills yet. <a href="/admin/drills/new" class="text-indigo-600 hover:underline">Create the first one.</a></p>
    </div>
  ) : (
    <div class="space-y-3">
      {drills.map((drill) => (
        <div class="drill-card rounded-lg bg-white px-4 py-3 shadow-sm ring-1 ring-gray-900/5">
          <div class="flex items-start justify-between gap-2">
            <p class="text-sm font-semibold text-gray-900">{drill.name}</p>
            {drill.defaultSection && (
              <span class="shrink-0 inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600">
                {SECTION_LABELS[drill.defaultSection] ?? drill.defaultSection}
              </span>
            )}
          </div>
          {drill.description && (
            <p class="mt-0.5 text-xs text-gray-500 line-clamp-2">{drill.description}</p>
          )}
          <div class="mt-2 flex items-center justify-between gap-2">
            <div class="flex flex-wrap gap-1">
              {(drill.suitableAgeGroups ?? []).length > 0 ? (
                (drill.suitableAgeGroups ?? []).map((ag) => (
                  <span class="inline-flex items-center rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-700">{ag}</span>
                ))
              ) : (
                <span class="text-xs text-gray-400">All ages</span>
              )}
            </div>
            <p class="shrink-0 text-xs text-gray-500">{drill.defaultDurationMinutes} min · {drill.repsPerMinute} reps/min</p>
          </div>
          <div class="mt-2 flex items-center justify-end gap-3">
            <a href={`/admin/drills/${drill._id}`} class="text-sm text-gray-600 hover:text-gray-800 font-medium">View</a>
            <a href={`/admin/drills/${drill._id}/edit`} class="text-sm text-indigo-600 hover:text-indigo-800 font-medium">Edit</a>
            <button
              type="button"
              class="delete-drill-btn text-sm text-red-600 hover:text-red-800 font-medium"
              data-drill-id={drill._id}
              data-drill-name={drill.name}
            >
              Delete
            </button>
          </div>
        </div>
      ))}
    </div>
  )}

  <div id="drillStatus" class="hidden mt-4 rounded-md p-3 text-sm font-medium"></div>

</AdminDashboardLayout>

<script>
  const statusEl = document.getElementById("drillStatus");

  function showStatus(msg: string, isError: boolean) {
    if (!statusEl) return;
    statusEl.textContent = msg;
    statusEl.className = `mt-4 rounded-md p-3 text-sm font-medium ${isError ? "bg-red-50 text-red-700" : "bg-green-50 text-green-700"}`;
    statusEl.classList.remove("hidden");
    setTimeout(() => statusEl.classList.add("hidden"), 4000);
  }

  document.querySelectorAll<HTMLButtonElement>(".delete-drill-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const drillId = btn.dataset.drillId;
      const name = btn.dataset.drillName ?? "this drill";
      if (!drillId) return;
      if (!confirm(`Delete "${name}"? This cannot be undone.`)) return;

      btn.disabled = true;
      btn.textContent = "Deleting…";

      try {
        const res = await fetch("/api/admin/drills/delete", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ drillId }),
        });
        const data = await res.json() as { success: boolean; error?: string };
        if (data.success) {
          btn.closest(".drill-card")?.remove();
          showStatus(`"${name}" deleted.`, false);
        } else {
          showStatus(data.error ?? "Delete failed.", true);
          btn.disabled = false;
          btn.textContent = "Delete";
        }
      } catch {
        showStatus("Network error.", true);
        btn.disabled = false;
        btn.textContent = "Delete";
      }
    });
  });
</script>
