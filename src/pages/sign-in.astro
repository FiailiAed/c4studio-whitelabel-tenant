---
import Layout from "@layouts/Layout.astro";
import { SignIn as ClerkSignIn } from "@clerk/astro/components";
---

<Layout title="Sign In" breadcrumbs={[{ name: "Sign In", href: "/sign-in" }]}>
  <main class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-indigo-50 flex flex-col items-center justify-center px-4 py-12">
    <ClerkSignIn />
    <p class="mt-6 text-sm text-slate-500">
      Don't have an account?{" "}
      <a href="/sign-up" class="text-indigo-600 hover:text-indigo-500 font-medium">Sign up &rarr;</a>
    </p>
  </main>
</Layout>
