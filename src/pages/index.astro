---
import Layout from "@layouts/Layout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "../../convex/_generated/api";

const { userId } = Astro.locals.auth();

type OnboardStatus = "pending" | "in_progress" | "submitted" | "done";

interface ConvexUser {
  clerkId: string;
  role: string;
  onboardStatus: OnboardStatus;
}

interface OnboardingRecord {
  clerkId: string;
  currentStep?: number;
}

let convexUser: ConvexUser | null = null;
let onboarding: OnboardingRecord | null = null;
let firstName: string = "";

if (userId) {
  const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);
  convexUser = await client.query(api.users.getUserByClerkId, { clerkId: userId }) as ConvexUser | null;

  if (convexUser?.onboardStatus === "in_progress") {
    onboarding = await client.query(api.onboarding.getOnboardingByClerkId, { clerkId: userId }) as OnboardingRecord | null;
  }

  const clerkUser = await Astro.locals.currentUser();
  firstName = clerkUser?.firstName ?? "";
}

const isAdmin = convexUser?.role === "admin";
const status = convexUser?.onboardStatus ?? null;
const currentStep = onboarding?.currentStep ?? 1;

const STEP_LABELS: Record<number, string> = {
  1: "Background Info",
  2: "Practice Availability",
  3: "Game Availability",
  4: "Compliance",
};

const STEP_URLS: Record<number, string> = {
  1: "/get-started",
  2: "/get-started/practice",
  3: "/get-started/games",
  4: "/get-started/compliance",
};

const nextStepUrl = STEP_URLS[currentStep] ?? "/get-started";
---

<Layout title="Home — Lacrosse Coach Portal" breadcrumbs={[]}>
  <main class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-indigo-50 flex items-center justify-center px-4 py-12">

    {/* ── State A: Signed Out ──────────────────────────────── */}
    {!userId && (
      <>
        <div class="w-full max-w-md mx-auto text-center space-y-8">
          <div class="space-y-3">
            <h1 class="text-4xl font-bold text-slate-900">GT Lacrosse Coach Portal</h1>
            <p class="text-slate-500 text-lg">Manage your availability, see events, and practice plans all in one place.</p>
          </div>
          <div class="flex flex-col gap-3 max-w-xs mx-auto">
            <a
              href="/sign-in"
              class="bg-indigo-600 text-white font-semibold rounded-xl px-6 py-3 text-sm hover:bg-indigo-500 transition-colors"
            >
              Sign In
            </a>
            <a
              href="/sign-up"
              class="border border-indigo-600 text-indigo-600 font-semibold rounded-xl px-6 py-3 text-sm hover:bg-indigo-50 transition-colors"
            >
              Sign Up
            </a>
          </div>
        </div>

        <script is:inline>
          (function () {
            function checkClerkSession() {
              if (typeof window.Clerk !== 'undefined') {
                window.Clerk.load().then(function () {
                  if (window.Clerk.session) {
                    window.location.reload();
                  }
                });
              } else {
                setTimeout(checkClerkSession, 100);
              }
            }
            checkClerkSession();
          })();
        </script>
      </>
    )}

    {/* ── State B: Onboarding Not Started ─────────────────── */}
    {userId && status === "pending" && (
      <div class="w-full max-w-md mx-auto bg-white rounded-2xl shadow-sm border border-slate-100 p-8 space-y-6 text-center">
        <div class="space-y-2">
          <h1 class="text-2xl font-bold text-slate-900">
            Welcome{firstName ? `, ${firstName}` : ""}!
          </h1>
          <p class="text-slate-500 text-sm">You're registered — let's get you set up.</p>
        </div>
        <a
          href="/get-started"
          class="inline-block w-full bg-indigo-600 text-white font-semibold rounded-xl px-6 py-3 text-sm hover:bg-indigo-500 transition-colors"
        >
          Get Started &rarr;
        </a>
        <a href="/profile" class="inline-flex items-center justify-center gap-1.5 text-sm text-slate-500 hover:text-slate-700">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
          </svg>
          View Profile
        </a>
      </div>
    )}

    {/* ── State C: Onboarding In Progress ─────────────────── */}
    {userId && status === "in_progress" && (
      <div class="w-full max-w-md mx-auto bg-white rounded-2xl shadow-sm border border-slate-100 p-8 space-y-6">
        <div class="space-y-1 text-center">
          <h1 class="text-2xl font-bold text-slate-900">
            Welcome back{firstName ? `, ${firstName}` : ""}
          </h1>
          <p class="text-slate-500 text-sm">Pick up where you left off.</p>
        </div>

        {/* Progress steps */}
        <div class="space-y-2">
          <div class="flex justify-between text-xs text-slate-400 mb-1">
            <span>Step {currentStep} of 4</span>
            <span>{STEP_LABELS[currentStep]}</span>
          </div>
          <div class="flex gap-1">
            {[1, 2, 3, 4].map((step) => (
              <div
                class={`h-1.5 flex-1 rounded-full ${step <= currentStep ? "bg-indigo-600" : "bg-slate-200"}`}
              />
            ))}
          </div>
          <ol class="mt-3 space-y-1">
            {[1, 2, 3, 4].map((step) => (
              <li class={`flex items-center gap-2 text-sm ${step === currentStep ? "text-indigo-700 font-medium" : step < currentStep ? "text-slate-400 line-through" : "text-slate-400"}`}>
                <span class={`inline-flex items-center justify-center w-5 h-5 rounded-full text-xs font-bold shrink-0 ${step < currentStep ? "bg-indigo-100 text-indigo-600" : step === currentStep ? "bg-indigo-600 text-white" : "bg-slate-100 text-slate-400"}`}>
                  {step < currentStep ? "✓" : step}
                </span>
                {STEP_LABELS[step]}
              </li>
            ))}
          </ol>
        </div>

        <a
          href={nextStepUrl}
          class="inline-block w-full bg-indigo-600 text-white font-semibold rounded-xl px-6 py-3 text-sm text-center hover:bg-indigo-500 transition-colors"
        >
          Continue Step {currentStep} &rarr;
        </a>
        <div class="text-center">
          <a href="/profile" class="inline-flex items-center justify-center gap-1.5 text-sm text-slate-500 hover:text-slate-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
            </svg>
            View Profile
          </a>
        </div>
      </div>
    )}

    {/* ── State D: Onboarding Complete (done / submitted) ─── */}
    {userId && (status === "done" || status === "submitted") && (
      <div class="w-full max-w-2xl mx-auto space-y-8">
        <div class="text-center space-y-1">
          <h1 class="text-2xl font-bold text-slate-900">
            Welcome back{firstName ? `, ${firstName}` : ""}
          </h1>
          <p class="text-slate-500 text-sm">Choose where you'd like to go.</p>
        </div>

        {/* Portal cards */}
        <div class={`grid gap-4 ${isAdmin ? "grid-cols-1 sm:grid-cols-2" : "grid-cols-1 max-w-sm mx-auto"}`}>
          {/* Coach Portal card */}
          <a
            href="/coach"
            class="group relative bg-white rounded-2xl border border-slate-200 p-6 hover:border-indigo-300 hover:shadow-md transition-all space-y-3"
          >
            <div class="flex items-start justify-between">
              <div class="bg-indigo-50 rounded-xl p-2.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              {status === "submitted" ? (
                <span class="inline-flex items-center gap-1 text-xs font-medium bg-amber-100 text-amber-700 rounded-full px-2.5 py-0.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-500 inline-block"></span>
                  Under Review
                </span>
              ) : (
                <span class="inline-flex items-center gap-1 text-xs font-medium bg-green-100 text-green-700 rounded-full px-2.5 py-0.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-green-500 inline-block"></span>
                  Active
                </span>
              )}
            </div>
            <div>
              <h2 class="text-base font-semibold text-slate-900 group-hover:text-indigo-700 transition-colors">Coach Portal</h2>
              <p class="text-xs text-slate-500 mt-0.5">
                {status === "submitted" ? "Browse events and practice plans while your approval is pending." : "View events, practice plans, and your schedule."}
              </p>
            </div>
            <span class="text-xs text-indigo-600 font-medium group-hover:underline">Open &rarr;</span>
          </a>

          {/* Admin Dashboard card — only for admins */}
          {isAdmin && (
            <a
              href="/admin"
              class="group relative bg-white rounded-2xl border border-slate-200 p-6 hover:border-slate-400 hover:shadow-md transition-all space-y-3"
            >
              <div class="flex items-start justify-between">
                <div class="bg-slate-100 rounded-xl p-2.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                  </svg>
                </div>
                <span class="inline-flex items-center gap-1 text-xs font-medium bg-slate-100 text-slate-600 rounded-full px-2.5 py-0.5">
                  Admin
                </span>
              </div>
              <div>
                <h2 class="text-base font-semibold text-slate-900 group-hover:text-slate-700 transition-colors">Admin Dashboard</h2>
                <p class="text-xs text-slate-500 mt-0.5">Manage staff, events, season config, and approvals.</p>
              </div>
              <span class="text-xs text-slate-600 font-medium group-hover:underline">Open &rarr;</span>
            </a>
          )}
        </div>

        {/* Resources section */}
        <div class="bg-white rounded-2xl border border-slate-100 p-6 space-y-3">
          <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Resources</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
            <a
              href="https://www.baslacrosse.org"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
              BAS Website
            </a>
            <a
              href="https://drive.google.com"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
              </svg>
              JFE Drive
            </a>
            <a
              href="https://www.usalacrosse.com"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
              USA Lacrosse Resources
            </a>
          </div>
        </div>
      </div>
    )}

    {/* ── Loading state: signed in but no convexUser yet ── */}
    {userId && !convexUser && (
      <div class="space-y-3 text-center">
        <div class="w-8 h-8 border-2 border-slate-200 border-t-indigo-600 rounded-full animate-spin mx-auto"></div>
        <p class="text-slate-500 text-sm">Setting up your account…</p>
        <script is:inline>
          setTimeout(function () { window.location.reload(); }, 2500);
        </script>
      </div>
    )}

  </main>
</Layout>
