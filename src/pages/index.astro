---
import Layout from "@layouts/Layout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "@convex/_generated/api";

const { userId } = Astro.locals.auth();

let firstName = "";
let isSuperAdmin = false;
let userTenants: Array<{ tenant: { name: string; slug: string }; membership: { status: string } }> = [];

if (userId) {
  const client = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);
  const [platformUser, clerkUser] = await Promise.all([
    client.query(api.users.getUserByClerkId, { clerkId: userId }),
    Astro.locals.currentUser(),
  ]);

  firstName = clerkUser?.firstName ?? "";
  isSuperAdmin = platformUser?.platformRole === "super_admin";

  if (isSuperAdmin) {
    return Astro.redirect("/super-admin");
  }

  if (platformUser) {
    const tenantData = await client.query(api.tenantMembers.listUserTenants, { clerkId: userId });
    userTenants = tenantData.filter((t) => t.membership.status === "active") as typeof userTenants;

    if (userTenants.length === 1) {
      return Astro.redirect(`/t/${userTenants[0].tenant.slug}`);
    }
  }
}
---

<Layout title="Platform">
  <main class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-indigo-50 flex items-center justify-center px-4 py-12">

    {!userId && (
      <div class="w-full max-w-md mx-auto text-center space-y-8">
        <div class="space-y-3">
          <h1 class="text-4xl font-bold text-slate-900">Platform</h1>
          <p class="text-slate-500 text-lg">Your whitelabel multi-tenant portal.</p>
        </div>
        <div class="flex flex-col gap-3 max-w-xs mx-auto">
          <a href="/sign-in" class="bg-indigo-600 text-white font-semibold rounded-xl px-6 py-3 text-sm hover:bg-indigo-500 transition-colors">
            Sign In
          </a>
          <a href="/sign-up" class="border border-indigo-600 text-indigo-600 font-semibold rounded-xl px-6 py-3 text-sm hover:bg-indigo-50 transition-colors">
            Sign Up
          </a>
        </div>
        <script is:inline>
          (function () {
            function checkClerkSession() {
              if (typeof window.Clerk !== 'undefined') {
                window.Clerk.load().then(function () {
                  if (window.Clerk.session) { window.location.reload(); }
                });
              } else {
                setTimeout(checkClerkSession, 100);
              }
            }
            checkClerkSession();
          })();
        </script>
      </div>
    )}

    {userId && userTenants.length > 1 && (
      <div class="w-full max-w-lg mx-auto space-y-6">
        <div class="text-center space-y-1">
          <h1 class="text-2xl font-bold text-slate-900">
            Welcome{firstName ? `, ${firstName}` : ""}
          </h1>
          <p class="text-slate-500 text-sm">Choose a portal to continue.</p>
        </div>
        <div class="grid gap-3">
          {userTenants.map(({ tenant }) => (
            <a
              href={`/t/${tenant.slug}`}
              class="group bg-white rounded-2xl border border-slate-200 p-5 hover:border-indigo-300 hover:shadow-sm transition-all flex items-center justify-between"
            >
              <span class="font-semibold text-slate-900 group-hover:text-indigo-700 transition-colors">{tenant.name}</span>
              <span class="text-indigo-600 text-sm font-medium group-hover:underline">Open &rarr;</span>
            </a>
          ))}
        </div>
        <div class="text-center">
          <a href="/profile" class="text-sm text-slate-500 hover:text-slate-700">View Profile</a>
        </div>
      </div>
    )}

    {userId && userTenants.length === 0 && (
      <div class="w-full max-w-md mx-auto bg-white rounded-2xl shadow-sm border border-slate-100 p-8 text-center space-y-4">
        <h1 class="text-xl font-bold text-slate-900">No Access</h1>
        <p class="text-slate-500 text-sm">
          Your account isn't associated with any portal yet. Contact your administrator.
        </p>
        <a href="/profile" class="inline-block text-sm text-indigo-600 hover:text-indigo-500">View Profile</a>
      </div>
    )}

    {userId && !userTenants && (
      <div class="space-y-3 text-center">
        <div class="w-8 h-8 border-2 border-slate-200 border-t-indigo-600 rounded-full animate-spin mx-auto"></div>
        <p class="text-slate-500 text-sm">Loading…</p>
        <script is:inline>
          setTimeout(function () { window.location.reload(); }, 2500);
        </script>
      </div>
    )}

  </main>
</Layout>
