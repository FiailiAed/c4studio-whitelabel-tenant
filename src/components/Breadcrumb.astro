---
interface Props {
  items: { name: string; href: string }[];
}
const { items } = Astro.props;
---

<nav class="flex bg-white px-8 py-4 border-b border-gray-100" aria-label="Breadcrumb">
  <ol role="list" class="flex items-center space-x-4">

    <!-- Home always first -->
    <li>
      <div>
        <a href="/" class="text-gray-400 hover:text-gray-500 transition-colors">
          <svg class="size-5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M9.293 2.293a1 1 0 0 1 1.414 0l7 7A1 1 0 0 1 17 11h-1v6a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-6H3a1 1 0 0 1-.707-1.707l7-7Z" clip-rule="evenodd" />
          </svg>
          <span class="sr-only">Home</span>
        </a>
      </div>
    </li>

    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li>
          <div class="flex items-center">
            <svg class="size-3 shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
            </svg>
            {isLast ? (
              <a href={item.href} aria-current="page" class="group relative ml-4 flex items-center justify-center text-xs font-bold rounded-full">
                <div class="absolute -inset-[1.5px] rounded-full bg-gradient-to-r from-sky-400 via-black-700 to-sky-500 animate-pulse opacity-80 group-hover:opacity-100 transition-opacity duration-300"></div>
                <div class="relative px-4 py-1 bg-white rounded-full transition-all group-hover:bg-gray-50 w-full h-full flex items-center justify-center">
                  <span class="bg-gradient-to-tr from-black from-40% to-sky-500 to-90% bg-clip-text text-transparent">{item.name}</span>
                </div>
              </a>
            ) : (
              <a href={item.href} class="ml-4 text-xs font-medium text-gray-500 hover:text-gray-700 transition-colors">
                {item.name}
              </a>
            )}
          </div>
        </li>
      );
    })}

  </ol>
</nav>
